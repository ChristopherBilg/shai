{
  "scripts": {
    "shai-read": {
      "description": "Wrap raw stdin text into a message event",
      "flags": {
        "--system": {
          "description": "Tag the stdin text as a system message"
        },
        "--external": {
          "arg": "SOURCE",
          "description": "Fence stdin as external_data attributed to SOURCE"
        }
      }
    },
    "shai-context": {
      "description": "Build the Deepseek messages request from the event log",
      "flags": {
        "--max-bytes": {
          "arg": "N",
          "description": "Cap the request size at N bytes"
        }
      }
    },
    "shai-eval": {
      "description": "Call the Deepseek API for one eval turn",
      "flags": {
        "--tools-file": {
          "arg": "PATH",
          "arg_type": "file",
          "description": "Send the tool array from this JSON file"
        },
        "--model": {
          "arg": "MODEL",
          "description": "Override the model name"
        },
        "--max-tokens": {
          "arg": "N",
          "description": "Output token budget"
        },
        "--dry-run": {
          "description": "Print the request payload without calling the API"
        },
        "--health-check": {
          "description": "Verify DEEPSEEK_API_KEY is set and exit"
        }
      }
    },
    "shai-events": {
      "description": "Query individual events across session logs",
      "flags": {
        "--type": {
          "arg": "VALUE",
          "arg_type": "event_type",
          "description": "Only events of this type (message, tool_result, or error)"
        },
        "--source": {
          "arg": "VALUE",
          "arg_type": "event_source",
          "description": "Only events from this source (user, assistant, system, or tool)"
        },
        "--tool": {
          "arg": "NAME",
          "arg_type": "tool_name",
          "description": "Only assistant events calling this tool"
        },
        "--session": {
          "arg": "ID",
          "arg_type": "session_id",
          "description": "Only events from this session (id or prefix)"
        },
        "--run": {
          "arg": "ID",
          "arg_type": "run_id",
          "description": "Only events from this run (id or prefix)"
        },
        "--after": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only events at or after DATE"
        },
        "--before": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only events at or before DATE"
        },
        "--recent": {
          "arg": "N",
          "description": "Show only the last N events"
        },
        "--json": {
          "description": "Emit JSON"
        }
      }
    },
    "shai-dispatch": {
      "description": "Run tool_calls from the latest assistant event; emit tool_result events",
      "flags": {}
    },
    "shai-loop": {
      "description": "Eval/dispatch loop filter: prompt in, final assistant event out",
      "flags": {
        "--tools": {
          "description": "Aggregate tools via shai-tools and send them"
        },
        "--tools-file": {
          "arg": "PATH",
          "arg_type": "file",
          "description": "Send the tool array from this JSON file"
        },
        "--model": {
          "arg": "MODEL",
          "description": "Override the model name"
        },
        "--max-tokens": {
          "arg": "N",
          "description": "Output token budget"
        },
        "--quiet": {
          "short": "-q",
          "description": "Suppress dispatch markers"
        }
      }
    },
    "shai-print": {
      "description": "Render an event to human-readable text",
      "flags": {
        "--debug": {
          "description": "Include tool_use and tool_result detail"
        },
        "--dispatches": {
          "description": "Add tool-call marker lines"
        }
      }
    },
    "shai-stamp": {
      "description": "Add the execution envelope (version + meta) to each event",
      "flags": {}
    },
    "shai-ask": {
      "description": "Non-interactive one-shot mode: run the full pipeline and print the answer",
      "flags": {
        "--quiet": {
          "short": "-q",
          "description": "Suppress tool dispatch markers on stderr"
        },
        "--no-tools": {
          "description": "Disable tool dispatch (pure Q&A mode)"
        },
        "--model": {
          "arg": "MODEL",
          "description": "Override the model for this ask"
        },
        "--max-tokens": {
          "arg": "N",
          "description": "Output token budget"
        },
        "--external": {
          "arg": "SOURCE",
          "description": "Treat stdin as external data from SOURCE"
        }
      }
    },
    "shai-repl": {
      "description": "Interactive REPL",
      "flags": {
        "--quiet": {
          "short": "-q",
          "description": "Suppress dispatch markers"
        }
      }
    },
    "shai-retry": {
      "description": "Resume an interrupted run or replay a failed one",
      "flags": {
        "--quiet": {
          "short": "-q",
          "description": "Suppress dispatch markers"
        },
        "--run": {
          "arg": "RUN_ID",
          "arg_type": "run_id",
          "description": "Replay the named failed run"
        }
      }
    },
    "shai-sessions": {
      "description": "List sessions with summary metadata (events, runs, tokens)",
      "flags": {
        "--recent": {
          "arg": "N",
          "description": "Show only the last N sessions"
        },
        "--after": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only sessions at or after DATE"
        },
        "--before": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only sessions at or before DATE"
        },
        "--json": {
          "description": "Emit JSON"
        }
      }
    },
    "shai-runs": {
      "description": "List runs with span count, tool count, status, and token totals",
      "flags": {
        "--session": {
          "arg": "ID",
          "arg_type": "session_id",
          "description": "Only runs from this session (id or prefix)"
        },
        "--recent": {
          "arg": "N",
          "description": "Show only the last N runs"
        },
        "--failed": {
          "description": "Only runs whose status is error"
        },
        "--after": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only runs at or after DATE"
        },
        "--before": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only runs at or before DATE"
        },
        "--json": {
          "description": "Emit JSON"
        }
      }
    },
    "shai-trace": {
      "description": "Render a run's full span chain with inputs, outputs, and metrics",
      "positional": [
        {
          "name": "run_id",
          "type": "run_id",
          "description": "Run to trace (id or prefix)"
        }
      ],
      "flags": {
        "--request": {
          "arg": "SPAN",
          "description": "Dump the span's request JSON"
        },
        "--response": {
          "arg": "SPAN",
          "description": "Dump the span's response JSON"
        },
        "--verbose": {
          "description": "Show full event content without preview truncation"
        },
        "--json": {
          "description": "Emit the raw event stream as JSON"
        }
      }
    },
    "shai-stats": {
      "description": "Aggregate metrics across sessions, runs, and failures",
      "flags": {
        "--session": {
          "arg": "ID",
          "arg_type": "session_id",
          "description": "Aggregate only this session (id or prefix)"
        },
        "--after": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only events at or after DATE"
        },
        "--before": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only events at or before DATE"
        },
        "--json": {
          "description": "Emit JSON"
        }
      }
    },
    "shai-failures": {
      "description": "Inspect failure records written by lib/failure.sh",
      "flags": {},
      "subcommands": {
        "list": {
          "description": "List failure records, or one row per workflow",
          "flags": {
            "--workflow": {
              "arg": "NAME",
              "arg_type": "workflow_name",
              "description": "Only this workflow's records (name or prefix)"
            },
            "--category": {
              "arg": "CAT",
              "description": "Only records of this category"
            },
            "--after": {
              "arg": "DATE",
              "arg_type": "date",
              "description": "Only records at or after DATE"
            },
            "--before": {
              "arg": "DATE",
              "arg_type": "date",
              "description": "Only records at or before DATE"
            },
            "--recent": {
              "arg": "N",
              "description": "Show only the last N rows"
            },
            "--json": {
              "description": "Emit JSON"
            }
          }
        },
        "show": {
          "description": "Show full detail of one failure record",
          "flags": {
            "--json": {
              "description": "Emit JSON"
            }
          }
        },
        "summary": {
          "description": "Aggregate totals across all workflows",
          "flags": {
            "--after": {
              "arg": "DATE",
              "arg_type": "date",
              "description": "Only records at or after DATE"
            },
            "--before": {
              "arg": "DATE",
              "arg_type": "date",
              "description": "Only records at or before DATE"
            },
            "--json": {
              "description": "Emit JSON"
            }
          }
        }
      }
    },
    "shai-ledgers": {
      "description": "List workflow ledger entries and summaries",
      "flags": {
        "--workflow": {
          "arg": "NAME",
          "arg_type": "workflow_name",
          "description": "Only this workflow's ledger (name or prefix)"
        },
        "--recent": {
          "arg": "N",
          "description": "Show only the last N entries"
        },
        "--after": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only entries at or after DATE"
        },
        "--before": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only entries at or before DATE"
        },
        "--json": {
          "description": "Emit JSON"
        }
      }
    },
    "shai-doctor": {
      "description": "Validate environment prerequisites for shai",
      "flags": {}
    },
    "shai-update": {
      "description": "Check for, install, roll back, and prune shai releases in place",
      "flags": {
        "--check": {
          "description": "Report whether an update exists without changing anything"
        },
        "--list": {
          "description": "List versions on disk, marking the current one"
        },
        "--rollback": {
          "arg": "VERSION",
          "arg_type": "install_version",
          "description": "Re-point current to the previous or a named installed version"
        },
        "--version": {
          "arg": "VERSION",
          "description": "Install a specific release version"
        },
        "--prune": {
          "description": "Remove old version directories"
        },
        "--keep": {
          "arg": "N",
          "description": "Keep the newest N versions (with --prune)"
        },
        "--dry-run": {
          "description": "Print what --prune would remove without removing it"
        },
        "--yes": {
          "short": "-y",
          "description": "Skip the confirmation prompt"
        }
      }
    },
    "shai-version": {
      "description": "Print the installed shai version",
      "flags": {}
    },
    "shai-tools": {
      "description": "Scan, validate, and aggregate tool plugin directories",
      "positional": [
        {
          "name": "tools_dir",
          "type": "file",
          "description": "Plugin directory to scan (default: the install's tools/)"
        }
      ],
      "flags": {}
    },
    "shai-prompt": {
      "description": "Load a named prompt from the prompts/ directory",
      "positional": [
        {
          "name": "name",
          "type": "prompt_name",
          "description": "Prompt to print (prompts/NAME.txt)"
        }
      ],
      "flags": {}
    },
    "shai-workflow": {
      "description": "Discover and run shai workflow scripts",
      "flags": {},
      "subcommands": {
        "list": {
          "description": "List installed workflows",
          "flags": {}
        },
        "run": {
          "description": "Run a workflow script",
          "positional": [
            {
              "name": "name",
              "type": "workflow_name",
              "description": "Workflow to run"
            }
          ],
          "flags": {}
        },
        "describe": {
          "description": "Show a workflow's header documentation",
          "positional": [
            {
              "name": "name",
              "type": "workflow_name",
              "description": "Workflow to describe"
            }
          ],
          "flags": {}
        }
      }
    },
    "shai-supervise": {
      "description": "Manage shai workflows under systemd --user",
      "flags": {},
      "subcommands": {
        "install": {
          "description": "Install a workflow's systemd service and timer",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to supervise"
            }
          ],
          "flags": {
            "--interval": {
              "arg": "TIMESPAN",
              "description": "Timer interval (e.g. 15min)"
            }
          }
        },
        "uninstall": {
          "description": "Remove a workflow's systemd units",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to unsupervise"
            }
          ],
          "flags": {}
        },
        "start": {
          "description": "Start a workflow's systemd timer",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to start"
            }
          ],
          "flags": {}
        },
        "stop": {
          "description": "Stop a workflow's systemd timer",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to stop"
            }
          ],
          "flags": {}
        },
        "status": {
          "description": "Show timer state for supervised workflows",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to inspect (default: all)"
            }
          ],
          "flags": {
            "--json": {
              "description": "Emit JSON"
            }
          }
        },
        "repoint": {
          "description": "Re-point installed units from a versioned path to the current install",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to repoint (or --all for every installed unit)"
            }
          ],
          "flags": {
            "--all": {
              "description": "Repoint every installed shai-*.service unit",
              "excludes_positional": true
            },
            "--dry-run": {
              "description": "Print the diff without writing"
            }
          }
        },
        "logs": {
          "description": "Follow a workflow's journald output",
          "positional": [
            {
              "name": "script",
              "type": "workflow_name",
              "description": "Script or workflow to tail"
            }
          ],
          "flags": {}
        }
      }
    },
    "shai-prune": {
      "description": "Remove old session logs, run directories, ledgers, and failure records",
      "flags": {
        "--sessions": {
          "description": "Prune session logs"
        },
        "--runs": {
          "description": "Prune run directories"
        },
        "--ledgers": {
          "description": "Prune workflow ledgers"
        },
        "--failures": {
          "description": "Prune failure records"
        },
        "--dry-run": {
          "description": "List what would be removed without removing it"
        },
        "--before": {
          "arg": "DATE",
          "arg_type": "date",
          "description": "Only remove items older than DATE"
        }
      }
    },
    "shai-completions": {
      "description": "Generate and install self-contained shell tab completions from the manifest",
      "flags": {},
      "subcommands": {
        "check": {
          "description": "Validate manifest coverage, flag declarations, and generated-file freshness",
          "flags": {}
        },
        "generate": {
          "description": "Emit a self-contained completion script to stdout",
          "positional": [
            {
              "name": "shell",
              "type": "shell",
              "description": "Target shell: zsh or bash"
            }
          ],
          "flags": {}
        },
        "install": {
          "description": "Write the completion file to the standard user-local location",
          "positional": [
            {
              "name": "shell",
              "type": "shell",
              "description": "Target shell: zsh or bash"
            }
          ],
          "flags": {}
        }
      }
    },
    "shai-config": {
      "description": "Manage policy and CI configuration",
      "flags": {},
      "subcommands": {
        "policy": {
          "description": "Manage permission rules in $SHAI_HOME/policy.json",
          "positional": [
            {
              "name": "verb",
              "type": "policy_verb",
              "description": "Operation to perform"
            }
          ],
          "flags": {
            "--tool": {
              "arg": "NAME",
              "arg_type": "tool_name",
              "description": "Tool the rule matches (add), or the tool to test (test)"
            },
            "--action": {
              "arg": "ACTION",
              "arg_type": "policy_action",
              "description": "Verdict for the new rule: allow, prompt, or deny"
            },
            "--args": {
              "arg": "K=V",
              "description": "Argument pattern the rule matches (repeatable)"
            },
            "--before": {
              "arg": "N",
              "description": "Insert at 0-based index N instead of appending"
            },
            "--force": {
              "description": "Add the rule even when an earlier rule shadows it"
            },
            "--input": {
              "arg": "JSON",
              "description": "Tool input JSON to evaluate against the policy"
            },
            "--overlay": {
              "arg": "PATH",
              "arg_type": "file",
              "description": "Overlay policy file to consult before the base policy"
            },
            "--json": {
              "description": "Emit JSON"
            }
          }
        },
        "ci": {
          "description": "Manage CI check definitions in $SHAI_HOME/ci.json",
          "positional": [
            {
              "name": "verb",
              "type": "ci_verb",
              "description": "Operation to perform"
            }
          ],
          "flags": {
            "--json": {
              "description": "Emit JSON"
            },
            "--repo": {
              "arg": "KEY",
              "description": "Repository key to operate on (default: the cwd's origin remote, normalized)"
            },
            "--name": {
              "arg": "NAME",
              "description": "Check name to add"
            },
            "--command": {
              "arg": "CMD",
              "description": "Check command to run"
            },
            "--timeout": {
              "arg": "SECONDS",
              "description": "Check timeout in seconds"
            },
            "--env": {
              "arg": "K=V",
              "description": "Environment variable for the check (repeatable)"
            }
          }
        }
      }
    }
  },
  "types": {
    "session_id": {
      "description": "Session ID from SHAI_HOME/sessions/",
      "command": "ls \"${SHAI_HOME:-$HOME/.shai}/sessions/\" 2>/dev/null | sed -n 's/\\.jsonl$//p'"
    },
    "run_id": {
      "description": "Run ID from SHAI_HOME/runs/",
      "command": "ls \"${SHAI_HOME:-$HOME/.shai}/runs/\" 2>/dev/null"
    },
    "workflow_name": {
      "description": "Workflow name from install directory",
      "command": "for d in \"${_shai_dir}/workflows/\"*/run.sh; do [ -f \"$d\" ] || continue; d=\"${d%/run.sh}\"; n=\"${d##*/}\"; p=\"$(sed -n '2s/^# //p' \"$d/run.sh\" 2>/dev/null)\"; p=\"${p##*— }\"; printf '%s\\t%s\\n' \"$n\" \"$p\"; done 2>/dev/null"
    },
    "prompt_name": {
      "description": "Prompt name from install directory",
      "command": "ls \"${_shai_dir}/prompts/\" 2>/dev/null | sed 's/\\.txt$//'"
    },
    "file": {
      "description": "Filesystem path",
      "builtin": true
    },
    "date": {
      "description": "Date in YYYY-MM-DD format",
      "hint": "YYYY-MM-DD"
    },
    "shell": {
      "description": "Completion target shell",
      "command": "printf '%s\\n' zsh bash"
    },
    "event_type": {
      "description": "Event type",
      "command": "printf '%s\\n' message tool_result error"
    },
    "event_source": {
      "description": "Event source",
      "command": "printf '%s\\n' user assistant system tool"
    },
    "tool_name": {
      "description": "Tool name from install directory",
      "command": "for d in \"${_shai_dir}/tools/\"*/run.sh; do [ -x \"$d\" ] || continue; d=\"${d%/run.sh}\"; n=\"${d##*/}\"; p=\"$(jq -r '.description // empty' \"$d/tool.json\" 2>/dev/null)\"; printf '%s\\t%s\\n' \"$n\" \"$p\"; done 2>/dev/null"
    },
    "install_version": {
      "description": "Installed shai version from the install directory",
      "command": "if [ -L \"${_shai_dir%/*}/current\" ]; then for d in \"${_shai_dir%/*}/\"*/; do d=\"${d%/}\"; n=\"${d##*/}\"; [ \"$n\" = current ] || printf '%s\\n' \"$n\"; done 2>/dev/null; fi"
    },
    "policy_verb": {
      "description": "shai-config policy operation",
      "command": "printf '%s\\n' list add remove test"
    },
    "ci_verb": {
      "description": "shai-config ci operation",
      "command": "printf '%s\\n' list add remove"
    },
    "policy_action": {
      "description": "Policy rule verdict",
      "command": "printf '%s\\n' allow prompt deny"
    }
  }
}
