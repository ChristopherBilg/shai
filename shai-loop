#!/bin/bash
# shai-loop — eval/dispatch loop filter: prompt in, final assistant event out
# Usage: printf 'prompt' | shai-loop [--tools|--tools-file PATH] [--model MODEL] [--max-tokens N] [-q|--quiet]
# Reads: SHAI_SESSION_ID (required), SHAI_HOME, SHAI_RUN_ID, SHAI_SCHEMA_VERSION,
#        SHAI_RETRY_ACTIVE from environment; session log from $SHAI_HOME/sessions/
# Writes: events to $SHAI_HOME/sessions/$SHAI_SESSION_ID.jsonl and
#         $SHAI_HOME/runs/$SHAI_RUN_ID/events.jsonl; human-readable output to stderr
# Exit: 0 on completion (including eval errors — they are events, not crashes);
#       1 if SHAI_SESSION_ID is not set; 2 on usage error
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
RUNS_DIR="$STATE_DIR/runs"

mint_id() {
  printf '%s_%s_%s' "$1" "$(date -u +%Y%m%dT%H%M%S)" "$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
}

advance_span() {
  SPAN=$((SPAN + 1))
  export SHAI_PARENT_SPAN_ID="${SHAI_SPAN_ID:-}"
  export SHAI_SPAN_ID="span_$SPAN"
}

EVAL_OPTS=()
PRINT_OPTS=(--dispatches)
OWN_TOOLS_FILE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tools)
      OWN_TOOLS_FILE=$(mktemp)
      "$DIR/shai-tools" >"$OWN_TOOLS_FILE"
      EVAL_OPTS+=(--tools-file "$OWN_TOOLS_FILE")
      shift
      ;;
    --tools-file)
      [ "$#" -lt 2 ] && {
        printf 'error: --tools-file requires a path\n' >&2
        exit 2
      }
      EVAL_OPTS+=(--tools-file "$2")
      shift 2
      ;;
    --model)
      [ "$#" -lt 2 ] && {
        printf 'error: --model requires a value\n' >&2
        exit 2
      }
      EVAL_OPTS+=(--model "$2")
      shift 2
      ;;
    --max-tokens)
      [ "$#" -lt 2 ] && {
        printf 'error: --max-tokens requires a value\n' >&2
        exit 2
      }
      EVAL_OPTS+=(--max-tokens "$2")
      shift 2
      ;;
    -q | --quiet)
      PRINT_OPTS=()
      shift
      ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if [ -n "$OWN_TOOLS_FILE" ]; then
  trap 'rm -f "$OWN_TOOLS_FILE"' EXIT
fi

if [ -z "${SHAI_SESSION_ID:-}" ]; then
  printf 'error: SHAI_SESSION_ID must be set\n' >&2
  exit 1
fi

if [[ "$SHAI_SESSION_ID" =~ [/] ]] || [[ "$SHAI_SESSION_ID" == *..* ]]; then
  printf 'error: SHAI_SESSION_ID must not contain / or .. (got "%s")\n' "$SHAI_SESSION_ID" >&2
  exit 1
fi

export SHAI_SCHEMA_VERSION="${SHAI_SCHEMA_VERSION:-1.0}"

SESSIONS_DIR="$STATE_DIR/sessions"
SESSION_LOG="$SESSIONS_DIR/$SHAI_SESSION_ID.jsonl"
LATEST="$SESSIONS_DIR/$SHAI_SESSION_ID.latest.json"
mkdir -p "$SESSIONS_DIR"
# a never-before-used session has no jsonl file yet; `cat "$SESSION_LOG" ...` below would
# fail (and abort under pipefail+set -e) if the file doesn't exist, so guarantee it does —
# same touch-if-missing idiom used for RUN_LOG, with no content (system-prompt seeding, if
# any, is the caller's responsibility, not shai-loop's)
: >>"$SESSION_LOG"

if [ -z "${SHAI_RUN_ID:-}" ]; then
  SHAI_RUN_ID="$(mint_id run)"
  export SHAI_RUN_ID
fi
SPAN=0
export SHAI_SPAN_ID=""
export SHAI_PARENT_SPAN_ID=""

if mkdir -p "$RUNS_DIR/$SHAI_RUN_ID" 2>/dev/null &&
  { : >>"$RUNS_DIR/$SHAI_RUN_ID/events.jsonl"; } 2>/dev/null; then
  RUN_LOG="$RUNS_DIR/$SHAI_RUN_ID/events.jsonl"
else
  RUN_LOG=/dev/null
fi

commit_run() {
  [ -s "$RUN_LOG" ] || return 0
  local last_type last_source
  last_type=$(tail -n 1 "$RUN_LOG" | jq -r '.type // empty' 2>/dev/null) || return 0
  last_source=$(tail -n 1 "$RUN_LOG" | jq -r '.source // empty' 2>/dev/null) || return 0
  if [ "$last_type" = "message" ] && [ "$last_source" = "assistant" ]; then
    jq -c 'select(.type != "error")' "$RUN_LOG" >>"$SESSION_LOG" 2>/dev/null || true
  fi
}

print_event() {
  "$DIR/shai-print" ${PRINT_OPTS[@]+"${PRINT_OPTS[@]}"} >&2
}

advance_span

if [ "$RUN_LOG" != "/dev/null" ]; then
  "$DIR/shai-read" | "$DIR/shai-stamp" >>"$RUN_LOG"

  cat "$SESSION_LOG" "$RUN_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" "${EVAL_OPTS[@]}" | "$DIR/shai-stamp" |
    tee -a "$RUN_LOG" | tee "$LATEST" | print_event

  until cat "$LATEST" | "$DIR/shai-dispatch" | "$DIR/shai-stamp" >>"$RUN_LOG"; do
    advance_span
    cat "$SESSION_LOG" "$RUN_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" "${EVAL_OPTS[@]}" | "$DIR/shai-stamp" |
      tee -a "$RUN_LOG" | tee "$LATEST" | print_event
  done

  commit_run
else
  "$DIR/shai-read" | "$DIR/shai-stamp" >>"$SESSION_LOG"

  cat "$SESSION_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" "${EVAL_OPTS[@]}" | "$DIR/shai-stamp" |
    tee -a "$SESSION_LOG" | tee "$LATEST" | print_event

  until cat "$LATEST" | "$DIR/shai-dispatch" | "$DIR/shai-stamp" >>"$SESSION_LOG"; do
    advance_span
    cat "$SESSION_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" "${EVAL_OPTS[@]}" | "$DIR/shai-stamp" |
      tee -a "$SESSION_LOG" | tee "$LATEST" | print_event
  done
fi

cat "$LATEST"
