#!/bin/bash
# shai-loop — eval/dispatch loop filter: prompt in, final assistant event out
# Usage: printf 'prompt' | shai-loop [--tools|--tools-file PATH] [--model MODEL] [--max-tokens N] [-q|--quiet]
# Reads: SHAI_SESSION_ID (required), SHAI_HOME, SHAI_RUN_ID, SHAI_SCHEMA_VERSION,
#        SHAI_RETRY_ACTIVE from environment; session log from $SHAI_HOME/sessions/
# Writes: events to $SHAI_HOME/sessions/$SHAI_SESSION_ID.jsonl and
#         $SHAI_HOME/runs/$SHAI_RUN_ID/events.jsonl; human-readable output to stderr
# Exit: 0 on completion (including eval errors and dispatch failures — they are events, not
#       crashes); 1 if SHAI_SESSION_ID is not set; 2 on usage error
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
RUNS_DIR="$STATE_DIR/runs"

# Dispatch-loop backstop (see #257): shai-dispatch's exit code is a one-bit signal to this
# loop — 1 means "a tool ran, re-evaluate", 0 means "done". Any other non-zero exit is a
# dispatch failure and stops the loop (terminal). This bound additionally caps the loop so
# even a future failure that, against the contract, exits 1 degrades to a stopped run with an
# error event instead of an unbounded re-eval spin. Env-overridable (like
# SHAI_MAX_CONTEXT_BYTES) but never disable-able: a valid value is a positive integer.
MAX_DISPATCH_ROUNDS="${SHAI_MAX_DISPATCH_ROUNDS:-100}"
case "$MAX_DISPATCH_ROUNDS" in
  '' | 0* | *[!0-9]*)
    printf 'error: SHAI_MAX_DISPATCH_ROUNDS must be a positive integer (got "%s")\n' "$MAX_DISPATCH_ROUNDS" >&2
    exit 2
    ;;
esac

mint_id() {
  printf '%s_%s_%s' "$1" "$(date -u +%Y%m%dT%H%M%S)" "$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
}

advance_span() {
  SPAN=$((SPAN + 1))
  export SHAI_PARENT_SPAN_ID="${SHAI_SPAN_ID:-}"
  export SHAI_SPAN_ID="span_$SPAN"
}

EVAL_OPTS=()
PRINT_OPTS=(--dispatches)
OWN_TOOLS_FILE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tools)
      OWN_TOOLS_FILE=$(mktemp)
      "$DIR/shai-tools" >"$OWN_TOOLS_FILE"
      EVAL_OPTS+=(--tools-file "$OWN_TOOLS_FILE")
      shift
      ;;
    --tools-file)
      [ "$#" -lt 2 ] && {
        printf 'error: --tools-file requires a path\n' >&2
        exit 2
      }
      EVAL_OPTS+=(--tools-file "$2")
      shift 2
      ;;
    --model)
      [ "$#" -lt 2 ] && {
        printf 'error: --model requires a value\n' >&2
        exit 2
      }
      EVAL_OPTS+=(--model "$2")
      shift 2
      ;;
    --max-tokens)
      [ "$#" -lt 2 ] && {
        printf 'error: --max-tokens requires a value\n' >&2
        exit 2
      }
      EVAL_OPTS+=(--max-tokens "$2")
      shift 2
      ;;
    -q | --quiet)
      PRINT_OPTS=()
      shift
      ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if [ -n "$OWN_TOOLS_FILE" ]; then
  trap 'rm -f "$OWN_TOOLS_FILE"' EXIT
fi

if [ -z "${SHAI_SESSION_ID:-}" ]; then
  printf 'error: SHAI_SESSION_ID must be set\n' >&2
  exit 1
fi

if [[ "$SHAI_SESSION_ID" =~ [/] ]] || [[ "$SHAI_SESSION_ID" == *..* ]]; then
  printf 'error: SHAI_SESSION_ID must not contain / or .. (got "%s")\n' "$SHAI_SESSION_ID" >&2
  exit 1
fi

export SHAI_SCHEMA_VERSION="${SHAI_SCHEMA_VERSION:-1.0}"

SESSIONS_DIR="$STATE_DIR/sessions"
SESSION_LOG="$SESSIONS_DIR/$SHAI_SESSION_ID.jsonl"
LATEST="$SESSIONS_DIR/$SHAI_SESSION_ID.latest.json"
mkdir -p "$SESSIONS_DIR"
# a never-before-used session has no jsonl file yet; `cat "$SESSION_LOG" ...` below would
# fail (and abort under pipefail+set -e) if the file doesn't exist, so guarantee it does —
# same touch-if-missing idiom used for RUN_LOG, with no content (system-prompt seeding, if
# any, is the caller's responsibility, not shai-loop's)
: >>"$SESSION_LOG"

if [ -z "${SHAI_RUN_ID:-}" ]; then
  SHAI_RUN_ID="$(mint_id run)"
  export SHAI_RUN_ID
fi
SPAN=0
export SHAI_SPAN_ID=""
export SHAI_PARENT_SPAN_ID=""

if mkdir -p "$RUNS_DIR/$SHAI_RUN_ID" 2>/dev/null &&
  { : >>"$RUNS_DIR/$SHAI_RUN_ID/events.jsonl"; } 2>/dev/null; then
  RUN_LOG="$RUNS_DIR/$SHAI_RUN_ID/events.jsonl"
else
  RUN_LOG=/dev/null
fi

commit_run() {
  [ -s "$RUN_LOG" ] || return 0
  local last_type last_source
  last_type=$(tail -n 1 "$RUN_LOG" | jq -r '.type // empty' 2>/dev/null) || return 0
  last_source=$(tail -n 1 "$RUN_LOG" | jq -r '.source // empty' 2>/dev/null) || return 0
  if [ "$last_type" = "message" ] && [ "$last_source" = "assistant" ]; then
    jq -c 'select(.type != "error")' "$RUN_LOG" >>"$SESSION_LOG" 2>/dev/null || true
  fi
}

print_event() {
  "$DIR/shai-print" ${PRINT_OPTS[@]+"${PRINT_OPTS[@]}"} >&2
}

# re_eval: one re-evaluation pass after shai-dispatch reported a tool ran (exit 1): advance
# the span, re-run context|eval over the session + run logs, and record/print the new event.
re_eval() {
  advance_span
  cat "$SESSION_LOG" "$RUN_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" "${EVAL_OPTS[@]}" | "$DIR/shai-stamp" |
    tee -a "$LOOP_LOG" | tee "$LATEST" | print_event
}

# emit_dispatch_error <message>: terminal path for a broken dispatch (an exit code other than
# 0/1, or the loop bound exceeded). Writes an error event to the loop log and LATEST and
# renders it to stderr, so the failure is visible instead of a silent spin (see #257).
# shai-loop still exits 0 — errors are events, not crashes, matching the eval-error path.
emit_dispatch_error() {
  local message="$1" err_event
  err_event=$(jq -nc --arg text "$message" '{type:"error", source:"system", payload:{text:$text}}')
  printf '%s\n' "$err_event" >>"$LOOP_LOG"
  printf '%s\n' "$err_event" >"$LATEST"
  printf '%s\n' "$err_event" | print_event
}

advance_span

if [ "$RUN_LOG" != "/dev/null" ]; then
  LOOP_LOG="$RUN_LOG"
else
  LOOP_LOG="$SESSION_LOG"
fi

"$DIR/shai-read" | "$DIR/shai-stamp" >>"$LOOP_LOG"

cat "$SESSION_LOG" "$RUN_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" "${EVAL_OPTS[@]}" | "$DIR/shai-stamp" |
  tee -a "$LOOP_LOG" | tee "$LATEST" | print_event

# The re-eval loop: shai-dispatch exits 1 when at least one tool ran (re-evaluate), 0 when the
# turn is complete. ONLY 1 means "a tool ran": any other non-zero exit is a dispatch failure
# and terminates the loop with an error event — shai-loop must never re-evaluate on a failure,
# or a broken dispatch would spin forever, burning an API call per iteration (see #257).
dispatch_round=0
while :; do
  dispatch_round=$((dispatch_round + 1))
  if [ "$dispatch_round" -gt "$MAX_DISPATCH_ROUNDS" ]; then
    emit_dispatch_error "re-eval loop exceeded $MAX_DISPATCH_ROUNDS dispatch rounds — stopping"
    break
  fi
  if cat "$LATEST" | "$DIR/shai-dispatch" | "$DIR/shai-stamp" >>"$LOOP_LOG"; then
    break
  else
    # shai-dispatch exited non-zero. Only exit 1 means "a tool ran": any other non-zero exit
    # is a dispatch failure and stops the loop with an error event instead of a re-eval spin.
    # ($? here is the pipeline's raw status — do NOT use `if ! pipeline` for this, since `!`
    # inverts $? and a failing dispatch would read as exit 0.)
    dispatch_rc=$?
    if [ "$dispatch_rc" -ne 1 ]; then
      emit_dispatch_error "shai-dispatch failed (exit $dispatch_rc) — stopping the re-eval loop"
      break
    fi
    re_eval
  fi
done

if [ "$RUN_LOG" != "/dev/null" ]; then
  commit_run
fi

cat "$LATEST"
