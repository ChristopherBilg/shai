#!/bin/bash
# shai-print — render an event to human-readable text
# Usage: cat event.json | shai-print [--debug|--dispatches]
# Reads: one JSON event on stdin
# Writes: formatted text to stdout; --debug adds tool_use/tool_result lines, --dispatches adds "⏺ name(args)" tool-call lines
# Exit: 0 for well-formed event input
set -euo pipefail

DEBUG=false
DISPATCHES=false
case "${1:-}" in
  --debug) DEBUG=true ;;
  --dispatches) DISPATCHES=true ;;
esac

# --dispatches joins tool args as an unescaped "key: value, ..." string, so a value
# containing ", " or ")" would read ambiguously. Non-scalar values (e.g. arrays) are
# rendered as their JSON representation.
jq -r --argjson debug "$DEBUG" --argjson dispatches "$DISPATCHES" '
  if .type == "message" and .source == "assistant" then
    (if .payload.content then .payload.content else empty end),
    (if $debug then (.payload.tool_calls[]? | "[tool_use: \(.function.name) \(.function.arguments)]") else empty end),
    (if $dispatches then (.payload.tool_calls[]? | "⏺ \(.function.name)(\(.function.arguments | fromjson | to_entries | map("\(.key): \(.value)") | join(", ")))") else empty end)
  elif .type == "tool_result" and $debug then
    "[tool_result: \(.payload.content)]"
  elif .type == "error" then
    "Error: \(.payload.text)"
  else empty end
'
