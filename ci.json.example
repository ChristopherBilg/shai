{
  "_comment": "Example config for the ci tool. Copy this file to $SHAI_HOME/ci.json (default ~/.shai/ci.json) and edit the repos map; nothing installs it for you, and the ci tool refuses to run anything that is not listed here. Keys under repos are normalized git remote URLs of the checkout: no scheme, no credentials, no trailing .git (e.g. github.com/owner/repo). Each check needs a command (run through bash -c in the repo, or in the cwd the tool was given) and may set timeout in whole seconds (default 120). Checks run in an environment scrubbed of every exported SHAI_* variable and of DEEPSEEK_API_KEY/ANTHROPIC_API_KEY, so a check observes the checkout under test rather than the agent that dispatched the tool; a per-check \"env\" object re-injects variables by literal value for the rare check that needs one (e.g. \"env\": {\"DEEPSEEK_API_KEY\": \"sk-...\"}). The scrub is scoped to SHAI_* names plus those two keys, so any other credential the agent exports (e.g. GITHUB_TOKEN) still reaches the check. Config stays user-owned under $SHAI_HOME on purpose: it is never read from a cloned repo, since that would be arbitrary code execution from repo content. shai-doctor reports whether this file exists, parses, and which repo keys it covers. The lint check is not purely local: tests/install-lint-tools.sh downloads pinned linux_amd64 shellcheck/shfmt binaries, so it needs network access and fails on other platforms (e.g. macOS). The all aggregate covers lint too: it installs the pinned binaries first (mirroring the lint check's command), so a green all always means lint ran — it can no longer silently skip it.",
  "version": "1.0",
  "repos": {
    "github.com/ChristopherBilg/shai": {
      "checks": {
        "tests": { "command": "./tests/run.sh", "timeout": 900 },
        "conventions": { "command": "./tests/conventions.sh", "timeout": 120 },
        "docs": { "command": "./tests/docs.sh", "timeout": 120 },
        "tools-sync": { "command": "./tests/tools-sync.sh", "timeout": 120 },
        "completions": { "command": "./tests/completions-sync.sh", "timeout": 120 },
        "constants-sync": { "command": "./tests/constants-sync.sh", "timeout": 120 },
        "doctor-sync": { "command": "./tests/doctor-sync.sh", "timeout": 120 },
        "tool-schema": { "command": "./tests/validate-tool-schema.sh", "timeout": 120 },
        "lint": {
          "command": "./tests/install-lint-tools.sh >/dev/null && ./tests/lint.sh",
          "timeout": 300
        },
        "all": {
          "command": "./tests/install-lint-tools.sh >/dev/null && ./tests/conventions.sh && ./tests/docs.sh && ./tests/tools-sync.sh && ./tests/completions-sync.sh && ./tests/constants-sync.sh && ./tests/doctor-sync.sh && ./tests/validate-tool-schema.sh && ./tests/run.sh && ./tests/lint.sh",
          "timeout": 1800
        }
      }
    }
  }
}
