{
  "_comment": "Example config for the ci tool. Copy this file to $SHAI_HOME/ci.json (default ~/.shai/ci.json) and edit the repos map; nothing installs it for you, and the ci tool refuses to run anything that is not listed here. Keys under repos are normalized git remote URLs of the checkout: no scheme, no credentials, no trailing .git (e.g. github.com/owner/repo). Each check needs a command (run through bash -c in the repo, or in the cwd the tool was given) and may set timeout in whole seconds (default 120). Config stays user-owned under $SHAI_HOME on purpose: it is never read from a cloned repo, since that would be arbitrary code execution from repo content. shai-doctor reports whether this file exists, parses, and which repo keys it covers. The lint check is the one entry that is not purely local: tests/install-lint-tools.sh downloads pinned linux_amd64 shellcheck/shfmt binaries, so lint needs network access and fails on other platforms (e.g. macOS) — that is why the all aggregate deliberately omits it and every other check is in it. Run lint separately where those binaries work.",
  "version": "1.0",
  "repos": {
    "github.com/ChristopherBilg/shai": {
      "checks": {
        "tests": { "command": "./tests/run.sh", "timeout": 900 },
        "conventions": { "command": "./tests/conventions.sh", "timeout": 120 },
        "docs": { "command": "./tests/docs.sh", "timeout": 120 },
        "tools-sync": { "command": "./tests/tools-sync.sh", "timeout": 120 },
        "constants-sync": { "command": "./tests/constants-sync.sh", "timeout": 120 },
        "doctor-sync": { "command": "./tests/doctor-sync.sh", "timeout": 120 },
        "tool-schema": { "command": "./tests/validate-tool-schema.sh", "timeout": 120 },
        "lint": {
          "command": "./tests/install-lint-tools.sh >/dev/null && ./tests/lint.sh",
          "timeout": 300
        },
        "all": {
          "command": "./tests/conventions.sh && ./tests/docs.sh && ./tests/tools-sync.sh && ./tests/constants-sync.sh && ./tests/doctor-sync.sh && ./tests/validate-tool-schema.sh && ./tests/run.sh",
          "timeout": 1200
        }
      }
    }
  }
}
