#!/bin/bash
# shai-stamp — add the execution envelope (version + meta) to each event on stdin
# Usage: cat events.jsonl | shai-stamp
# Reads: one JSON event per line on stdin; ambient trace context from the environment
#        (SHAI_SCHEMA_VERSION, SHAI_SESSION_ID, SHAI_RUN_ID, SHAI_SPAN_ID, SHAI_PARENT_SPAN_ID)
# Writes: the same events, each with `version` and `meta` added; an unset variable becomes null.
#         A line that is not a JSON object is passed through verbatim rather than dropped.
# Exit: 0 always — this filter must never break the eval/dispatch loop
set -euo pipefail

# A downstream reader that closes early (e.g. a failed tee redirect) must not kill this
# filter: its contract is exit 0, always. Ignoring PIPE turns the fatal signal into a
# write error, and the guarded printfs below keep that error from tripping `set -e`.
trap '' PIPE

VERSION="${SHAI_SCHEMA_VERSION:-1.0}"

while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue
  # per line, not per invocation: this filter is a concurrent pipeline stage, so process-start
  # time is when the pipeline forked, not when the upstream stage emitted this event
  TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if out=$(printf '%s' "$line" | jq -c \
    --arg version "$VERSION" \
    --arg run "${SHAI_RUN_ID:-}" \
    --arg session "${SHAI_SESSION_ID:-}" \
    --arg span "${SHAI_SPAN_ID:-}" \
    --arg parent "${SHAI_PARENT_SPAN_ID:-}" \
    --arg ts "$TIMESTAMP" '
    def nullable: if . == "" then null else . end;
    if type == "object" then
      . + {version: $version,
           meta: {run_id: ($run | nullable),
                  session_id: ($session | nullable),
                  span_id: ($span | nullable),
                  parent_span_id: ($parent | nullable),
                  timestamp: $ts}}
    else error("not an object") end' 2>/dev/null) && [ -n "$out" ]; then
    printf '%s\n' "$out" 2>/dev/null || true
  else
    printf '%s\n' "$line" 2>/dev/null || true
  fi
done
