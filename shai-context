#!/bin/bash
# shai-context — pure jq reducer: build the Anthropic {system,messages} request from the event log
# Usage: cat sessions/<id>.jsonl | shai-context [--max-bytes N]
# Reads: the JSONL event log on stdin; SHAI_MAX_CONTEXT_BYTES from the environment (default 1300000)
# Writes: one JSON {system, messages} request object
# Exit: 0 normally; 1 if --max-bytes is given without a value
set -euo pipefail

MAX_BYTES="${SHAI_MAX_CONTEXT_BYTES:-1300000}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --max-bytes)
      [ "$#" -lt 2 ] && {
        echo "error: --max-bytes requires a value" >&2
        exit 1
      }
      MAX_BYTES="$2"
      shift 2
      ;;
    *) break ;;
  esac
done

jq -R -s -c --argjson max_bytes "$MAX_BYTES" '
  split("\n") | map(select(length > 0)) | map(try fromjson catch null) | map(select(. != null))
  | map(select((type=="object") and ((.payload? | type) == "object")))
  | . as $events
  | ($events | map(select(.type=="message" and .source=="system") | .payload.text) | join("\n\n")) as $system
  | ($events | map(select(.source != "system"))) as $conv
  | [ range(0; ($conv|length)) as $i | select($conv[$i].type=="message" and $conv[$i].source=="user") | $i ] as $uidx
  | (if ($uidx | length) == 0 then 0
     else
       ($uidx[-1]) as $last_start
       | ($conv[$last_start:] | map(tojson | utf8bytelength) | add // 0) as $last_bytes
       | ($system | utf8bytelength) as $sys_bytes
       | ($max_bytes - $sys_bytes - $last_bytes) as $budget
       | (reduce range(($uidx|length)-2; -1; -1) as $i (
           {start: $last_start, used: 0, done: false};
           if .done then . else
             (if $i < (($uidx|length)-1) then $uidx[$i+1] else ($conv|length) end) as $next
             | ($conv[$uidx[$i]:$next] | map(tojson | utf8bytelength) | add // 0) as $turn_bytes
             | if (.used + $turn_bytes) <= $budget
               then .start = $uidx[$i] | .used += $turn_bytes
               else .done = true end
           end
         ) | .start)
     end) as $start
  | ($conv[$start:]) as $win
  | (reduce $win[] as $e (
        {messages: [], pending: []};
        if $e.type == "tool_result" then
          .pending += [{type:"tool_result", tool_use_id: $e.payload.tool_use_id, content: $e.payload.content, is_error: ($e.payload.is_error // false)}]
        else
          (if (.pending|length) > 0 then .messages += [{role:"user", content: .pending}] | .pending = [] else . end)
          | if $e.type=="message" and $e.source=="user" then
              .messages += [{role:"user", content: $e.payload.text}]
            elif $e.type=="message" and $e.source=="assistant" then
              .messages += [{role:"assistant", content: $e.payload.content}]
            else . end
        end
      )
      | (if (.pending|length) > 0 then .messages += [{role:"user", content: .pending}] else . end)
      | .messages
    ) as $messages
  | {system: $system, messages: $messages}
'
