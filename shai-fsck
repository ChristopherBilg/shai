#!/bin/bash
# shai-fsck — report $SHAI_HOME store inconsistencies as normalized findings
# Usage: shai-fsck [--store STORE] [--check ID] [--after DATE] [--before DATE]
#        [--fix] [--dry-run] [--summary] [--json]
# Reads: $SHAI_HOME/sessions/, $SHAI_HOME/runs/, $SHAI_HOME/ledgers/, $SHAI_HOME/failures/,
#        workflows/ (L4 resolves a ledger filename against the shipped workflow directories)
# Writes: findings table to stdout (digest to stderr), the findings array to stdout with
#         --json, or the digest alone to stdout with --summary; --fix additionally repairs
#         every fixable finding and logs one repair:/manual: line per action to stderr.
#         A repair never edits, rewrites, truncates, or drops a line from an event-bearing
#         log: S5 rebuilds the derived .latest.json from its log, and S4/S6/R1/R5/R6 delete
#         whole redundant units. Everything else is refused with its named manual remedy.
# Exit: 0 clean (no findings, or --fix repaired everything it found); 1 problems found
#       (or --fix left problems it cannot safely repair, or a --dry-run plan refused a
#       repair the real --fix would fail); 2 usage error; 3 operational
#       failure (the scan or a repair could not complete: jq missing, $SHAI_HOME
#       absent/unreadable, or an unexpected command failure). 3 vs 1 is the point: a timer
#       or CI job can tell "your state directory is dirty" apart from "the check never ran".
set -euo pipefail

# fsck_failed: ERR-trap handler — any unexpected command failure means the scan (or, during
# the fix phase, a repair) did not complete, which must read as 3 (operational), never 1
# ("problems found"). $PHASE names the phase so the message is honest about which failed.
PHASE=scan
# shellcheck disable=SC2317  # invoked by the ERR trap below, not visible to static analysis
fsck_failed() {
  local rc=$?
  if [ "$PHASE" = "repair" ]; then
    printf 'shai-fsck: repair failed (exit %s) — repairs are incomplete\n' "$rc" >&2
  else
    printf 'shai-fsck: scan failed (exit %s) — the report may be incomplete\n' "$rc" >&2
  fi
  exit 3
}
trap fsck_failed ERR

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# R6 must classify an uncommitted run exactly as shai-retry --run would, so the verdict
# comes from lib/replay.sh's classify_replay (issue #386) — sourced, never reimplemented.
# The lib runs `set -uo pipefail` when sourced, so it never tightens this script's options.
# shellcheck source=lib/replay.sh
source "$DIR/lib/replay.sh"

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
SESSIONS_DIR="$STATE_DIR/sessions"
RUNS_DIR="$STATE_DIR/runs"
LEDGERS_DIR="$STATE_DIR/ledgers"
FAILURES_DIR="$STATE_DIR/failures"
# The install tree's workflows/: L4 checks a ledger filename against the workflow
# directories shipped next to this script (the repo root in a dev clone, the versioned
# install tree in a release install — the exec wrapper hands off to the real script path).
WORKFLOWS_DIR="$DIR/workflows"

# Check catalog: id -> the store its scan reads ("all" for the cross-store X1 name-pattern
# check). Shipped: S1-S9 (the session store, issues #389/#390), R1-R7 (the run store,
# #391), L1-L4 (ledgers), F1-F4 (failures), X1 (cross-store).
declare -A CHECK_STORE=([S1]=sessions [S2]=sessions [S3]=sessions [S4]=sessions
  [S5]=sessions [S6]=sessions [S7]=sessions [S8]=sessions [S9]=sessions
  [R1]=runs [R2]=runs [R3]=runs [R4]=runs [R5]=runs [R6]=runs [R7]=runs
  [L1]=ledgers [L2]=ledgers [L3]=ledgers [L4]=ledgers
  [F1]=failures [F2]=failures [F3]=failures [F4]=failures [X1]=all)
# Known ids in scan order (associative-array keys alone have no defined order); the order
# also fixes the findings' row order within a store.
KNOWN_CHECKS=(S1 S2 S3 S4 S5 S6 S7 S8 S9 R1 R2 R3 R4 R5 R6 R7 L1 L2 L3 L4 F1 F2 F3 F4 X1)
ALL_STORES=(sessions runs ledgers failures)

STORES=() CHECKS=()
AFTER="" BEFORE=""
FIX=false DRY_RUN=false SUMMARY=false JSON=false
# Count of planned repairs a --dry-run refused (S5's not-a-regular-file guard, #439): the
# plan exits 1 instead of the false 0 of "everything is repairable" when one is refused.
DRY_REFUSED=0

# known_check <id>: 0 when the id is in the check catalog.
known_check() {
  local id="$1" c
  for c in "${KNOWN_CHECKS[@]}"; do
    [ "$c" = "$id" ] && return 0
  done
  return 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --store)
      shift
      case "${1:-}" in
        sessions | runs | ledgers | failures) STORES+=("$1") ;;
        "")
          printf 'error: --store requires one of: sessions, runs, ledgers, failures\n' >&2
          exit 2
          ;;
        *)
          printf 'error: unknown store: %s (expected one of: %s)\n' "$1" "${ALL_STORES[*]}" >&2
          exit 2
          ;;
      esac
      ;;
    --check)
      shift
      if [ -z "${1:-}" ]; then
        printf 'error: --check requires a check id\n' >&2
        exit 2
      fi
      if ! known_check "$1"; then
        printf 'error: unknown check id: %s (known: %s)\n' "$1" "${KNOWN_CHECKS[*]}" >&2
        exit 2
      fi
      CHECKS+=("$1")
      ;;
    --after)
      shift
      AFTER="${1:-}"
      if [ -z "$AFTER" ]; then
        printf 'error: --after requires a date (YYYY-MM-DD)\n' >&2
        exit 2
      fi
      if ! [[ "$AFTER" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        printf 'error: --after date must be YYYY-MM-DD\n' >&2
        exit 2
      fi
      ;;
    --before)
      shift
      BEFORE="${1:-}"
      if [ -z "$BEFORE" ]; then
        printf 'error: --before requires a date (YYYY-MM-DD)\n' >&2
        exit 2
      fi
      if ! [[ "$BEFORE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        printf 'error: --before date must be YYYY-MM-DD\n' >&2
        exit 2
      fi
      ;;
    --fix) FIX=true ;;
    --dry-run) DRY_RUN=true ;;
    --summary) SUMMARY=true ;;
    --json) JSON=true ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

# The default run is already read-only, so --dry-run without --fix is a flag that would do
# nothing — refuse it rather than silently accept it.
if [ "$DRY_RUN" = true ] && [ "$FIX" != true ]; then
  printf 'error: --dry-run requires --fix\n' >&2
  exit 2
fi
# --summary is the table renderer's digest-only mode; --json is the machine renderer. Both
# at once would silently ignore one of them.
if [ "$SUMMARY" = true ] && [ "$JSON" = true ]; then
  printf 'error: --summary cannot be combined with --json\n' >&2
  exit 2
fi

# Operational guards — these are the exit 3 conditions, checked before any scan so a
# failed prerequisite can never masquerade as a clean scan.
if ! command -v jq >/dev/null 2>&1; then
  printf 'error: jq is required but was not found on PATH\n' >&2
  exit 3
fi
if [ ! -e "$STATE_DIR" ]; then
  printf 'error: SHAI_HOME does not exist: %s\n' "$STATE_DIR" >&2
  exit 3
fi
if [ ! -d "$STATE_DIR" ]; then
  printf 'error: SHAI_HOME is not a directory: %s\n' "$STATE_DIR" >&2
  exit 3
fi
if [ ! -r "$STATE_DIR" ] || [ ! -x "$STATE_DIR" ]; then
  printf 'error: SHAI_HOME is not readable: %s\n' "$STATE_DIR" >&2
  exit 3
fi

# Findings accumulator: checks append normalized records here and nothing downstream knows
# how a check reached its conclusion. The table renderer, the --json renderer, the digest,
# and --fix's repair worklist all read the same file, so the summary line
# "N problems found, M fixable with --fix" is true by construction.
FINDINGS_FILE="$(mktemp)"
trap 'rm -f "$FINDINGS_FILE"' EXIT

# finding <check> <severity> <store> <target> <path> <summary> <fixable> <remedy>: append one
# normalized finding carrying the eight-key contract to the accumulator.
finding() {
  jq -nc \
    --arg check "$1" --arg severity "$2" --arg store "$3" --arg target "$4" \
    --arg path "$5" --arg summary "$6" --argjson fixable "$7" --arg remedy "$8" \
    '{check:$check, severity:$severity, store:$store, target:$target, path:$path,
      summary:$summary, fixable:$fixable, remedy:$remedy}' >>"$FINDINGS_FILE"
}

# item_date <id>: "YYYY-MM-DD" embedded in a real-shaped <prefix>_YYYYMMDDTHHMMSS_<hex> id,
# or "" when the id carries no parseable timestamp.
item_date() {
  local id="$1" ts
  if [[ "$id" =~ ^[^_]+_[0-9]{8}T[0-9]{6}_[0-9a-f]{8}$ ]]; then
    ts="${id#*_}"
    printf '%s-%s-%s' "${ts:0:4}" "${ts:4:2}" "${ts:6:2}"
  fi
}

# in_window <date>: inclusive [--after, --before] on "YYYY-MM-DD". An undated item ("") is
# in-window only when no bound is active, matching shai-events' documented semantics: items
# whose embedded date cannot be read are dropped when a window is set.
in_window() {
  local date="$1"
  if [ -z "$date" ]; then
    if [ -n "$AFTER" ] || [ -n "$BEFORE" ]; then return 1; fi
    return 0
  fi
  if [ -n "$AFTER" ] && [[ "$date" < "$AFTER" ]]; then return 1; fi
  if [ -n "$BEFORE" ] && [[ "$date" > "$BEFORE" ]]; then return 1; fi
}

# store_dir <store>: the on-disk directory backing one of the four store names.
store_dir() {
  case "$1" in
    sessions) printf '%s' "$SESSIONS_DIR" ;;
    runs) printf '%s' "$RUNS_DIR" ;;
    ledgers) printf '%s' "$LEDGERS_DIR" ;;
    failures) printf '%s' "$FAILURES_DIR" ;;
  esac
}

# S4 — no orphan .latest.json: a sessions/<id>.latest.json with no sibling
# sessions/<id>.jsonl. Severity error, fixable by deleting the orphan. Pure filesystem —
# no jq, no event parsing — which is exactly why it proves the spine end to end.
ck_S4() {
  local f id date log
  for f in "$SESSIONS_DIR"/*.latest.json; do
    if [ ! -f "$f" ]; then continue; fi
    id="$(basename "$f" .latest.json)"
    # The date window short-circuits at the filename level, before any file is opened.
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$SESSIONS_DIR/$id.jsonl"
    if [ ! -e "$log" ]; then
      finding S4 error sessions "$id" "$f" "orphan latest.json (no session log)" true delete
    fi
  done
}

# S1/S2/S3/S5/S6/S7/S8/S9 — sessions/<id>.jsonl plus its .latest.json sibling, one jq
# pass per session log. The --after/--before window short-circuits at the filename level,
# exactly like S4, before any file is opened.
#
# S1 (error): every line parses as a JSON object. A blank line is a violation, not
#   whitespace noise: shai-stamp skips blanks deliberately, and a blank reaching the tail
#   of a session log would make shai-retry's classifier report "nothing to resume" for a
#   resumable run.
# S2 (error): every event carries top-level type, source, and payload — string, string,
#   and object respectively, not merely present keys. A null (or wrong-typed) value passes
#   a has() check while every downstream selector (shai-context, shai-runs/trace/stats)
#   matches on the real values and silently drops or misrenders it.
# S3 (error): every event with a non-null meta.session_id matches the filename stem.
#   Events predating the execution envelope have no meta at all and are skipped, never
#   flagged — CLAUDE.md's additive-envelope guarantee keeps old session logs working.
# S5 (error): for a non-stillborn session, .latest.json exists, is non-empty, parses, and
#   is JSON-equal to the last event of the log. shai-loop's dispatch loop reads LATEST
#   (shai-loop:149,206,226) and shai-retry reads it too, so a missing/empty/stale file
#   misleads both. The comparison happens on parsed values (jq ==), which is
#   key-order-insensitive — the in-process equivalent of the jq -S text comparison.
#   Exception: an error event in .latest.json is never a mismatch — error events are
#   deliberately kept out of the session log (shai-loop's commit_run filters them, and
#   emit_dispatch_error writes them to LATEST only), so a session that ended in an eval
#   error, truncation, or dispatch failure leaves LATEST holding its genuine most-recent
#   event (CLAUDE.md:139) beside a log whose tail is the last committed event. Flagging
#   that divergence would be a false positive, and "rebuild" would overwrite the only
#   copy of the error.
#   Exception: a session log with no parseable events is never "rebuildable". The repair
#   is `tail -n 1` of the log, and with zero events that writes an empty file (or the
#   last garbage line) — destroying whatever the old LATEST held, while a rescan still
#   reports S5, so the repair can never converge and the exit-0 promise would be false.
#   Every zero-event shape (missing/empty/unparseable/content latest) is refused with a
#   named manual remedy instead, mirroring the error-event carve-out above.
# S6 (warn): stillborn session — exactly one event, a message/system seed, beside an
#   empty .latest.json, the pair wf_seed_session writes. Evaluated before S5 and claims
#   the session: without the precedence every stillborn session reports twice (correctly
#   as S6 and spuriously as S5). An empty .latest.json beside a multi-event log stays a
#   genuine S5.
# S7 (error): every tool_result's payload.tool_call_id appears in a PRECEDING assistant
#   event's payload.tool_calls[].id. Ordering is load-bearing, not just set membership:
#   shai-context renders each tool_result into a {role:"tool", tool_call_id} message, and
#   a result with no preceding call — including one that matches a later assistant event —
#   is a 400 from the API on the next turn.
# S8 (warn): every assistant tool_calls[].id has a matching tool_result later in the
#   session — except on the FINAL assistant event, the resumable-tail case shai-retry
#   exists to handle (every interrupted session ends there, and that is healthy, not
#   corruption — hence warn, not error, for the non-final violations too).
# S9 (info/warn): version is a known schema version ("1.0"). No version at all is info —
#   the same legacy tolerance as S3, since unstamped events predate the envelope; an
#   unrecognized version string is the warn.
#
# The pass appends complete accumulator records itself (the same eight-key contract as
# finding()); routing each through the shell would cost a second jq invocation per
# finding. Dispatch runs ck_S once per scan, from the first selected S1/S2/S3/S5/S6/S7/
# S8/S9 arm, so the one-pass-per-file property holds however many S ids are selected.
SESS_SCAN_PROGRAM='
  def s_emit($check; $severity; $summary; $fixable; $remedy; $path):
    {check: $check, severity: $severity, store: "sessions", target: $sid, path: $path,
     summary: $summary, fixable: $fixable, remedy: $remedy};
  # A line that fails to parse carries the catch marker {__unparseable: true}, which is
  # itself an object — the type check alone would admit it as an event, so every
  # event-shaped select goes through this helper.
  def is_event($v): (($v | type) == "object") and (($v.__unparseable // false) | not);
  [inputs] as $lines
  | [$lines | to_entries[]
     | {i: .key, n: (.key + 1), line: .value,
        v: (try (.value | fromjson) catch {__unparseable: true})}] as $parsed
  | [$parsed[] | select(is_event(.v))] as $events
  | ($events | length) as $events_n
  | (if $events_n == 0 then null else $events[$events_n - 1].v end) as $last_event
  | (if $latest_state != "empty" then false
     elif $events_n != 1 then false
     else ($events[0].v.type == "message" and $events[0].v.source == "system")
     end) as $stillborn
  | (if $latest_state == "present"
     then ($latest_text | try ({ok: true, v: fromjson}) catch {ok: false})
     else {ok: false} end) as $latest_parsed
  | ([$parsed[] | select(is_event(.v))
     | select(.v.type == "message" and .v.source == "assistant") | .i]) as $assist_i
  | ($assist_i | length) as $assist_n
  | (if $assist_n == 0 then null else $assist_i[$assist_n - 1] end) as $last_assist_i
  | ([$parsed[] | select(is_event(.v))
     | select(.v.type == "tool_result")
     | {i: .i, id: (.v.payload.tool_call_id // null)}]) as $results
  | (reduce range(0; ($parsed | length)) as $i ({seen: {}, out: []};
       $parsed[$i].v as $v
       | if (is_event($v) | not) then .
         elif ($v.type == "message" and $v.source == "assistant") then
             . + {seen: (.seen + (reduce ($v.payload.tool_calls // [] | .[]) as $tc ({};
                        if (($tc.id // null) == null) then .
                        else . + {($tc.id | tostring): true} end)))}
         elif $v.type == "tool_result" then
             (($v.payload.tool_call_id // null)) as $tid
             | if $tid == null then
                 . + {out: (.out + [("tool_result " + ($parsed[$i].n | tostring)
                                     + " has no tool_call_id")])}
               elif .seen[($tid | tostring)] == true then .
               else
                 . + {out: (.out + [("tool_result " + ($parsed[$i].n | tostring)
                                     + " tool_call_id " + ($tid | tojson)
                                     + " has no preceding assistant tool call")])}
               end
         else . end)
     | .out) as $s7_bad
  | ((if $s1 then
        [$parsed[]
         | if is_event(.v) then empty
           elif .line == "" then
               s_emit("S1"; "error"; ("line " + (.n | tostring) + " is blank");
                      false; "manual: hand-edit the session log to repair or remove the line"; $path)
           else
               s_emit("S1"; "error"; ("line " + (.n | tostring) + " is not a JSON object");
                      false; "manual: hand-edit the session log to repair or remove the line"; $path)
           end]
      else [] end)
     + (if $s2 then
          [$parsed[]
           | select(is_event(.v))
           | select(((.v.type | type) != "string") or ((.v.source | type) != "string")
                    or ((.v.payload | type) != "object"))
           | s_emit("S2"; "error";
                    ("event " + (.n | tostring) + " missing or invalid type, source, or payload");
                    false; "manual: hand-edit the session log to repair the event"; $path)]
        else [] end)
     + (if $s3 then
          [$parsed[]
           | select(is_event(.v))
           | select(((.v.meta // null) | type) == "object")
           | select((.v.meta.session_id // null) != null)
           | select(.v.meta.session_id != $sid)
           | s_emit("S3"; "error";
                    ("event " + (.n | tostring) + " meta.session_id "
                     + (.v.meta.session_id | tojson) + " does not match the session id");
                    false; "manual: hand-edit the session log to correct meta.session_id"; $path)]
        else [] end)
     + (if $s5 and ($stillborn | not) then
          if ($latest_state == "present") and ($latest_parsed.ok)
             and ($latest_parsed.v.type == "error") then []
          elif $events_n == 0 then
            [s_emit("S5"; "error";
                    "latest.json cannot be rebuilt (the session log has no parseable events)";
                    false;
                    "manual: hand-edit the session log to restore an event, or delete the session pair";
                    $latest_path)]
          elif $latest_state == "missing" then
            [s_emit("S5"; "error"; "latest.json missing"; true; "rebuild"; $latest_path)]
          elif $latest_state == "other" then
            [s_emit("S5"; "error"; "latest.json is not a regular file"; true; "rebuild"; $latest_path)]
          elif $latest_state == "empty" then
            [s_emit("S5"; "error"; "latest.json empty"; true; "rebuild"; $latest_path)]
          elif ($latest_parsed.ok | not) then
            [s_emit("S5"; "error"; "latest.json does not parse as JSON"; true; "rebuild"; $latest_path)]
          elif $latest_parsed.v == $last_event then []
          else
            [s_emit("S5"; "error"; "latest.json is not the last event"; true; "rebuild"; $latest_path)]
          end
        else [] end)
     + (if $s6 and $stillborn then
          [s_emit("S6"; "warn"; "stillborn session (one system event, empty latest.json)";
                  true; "delete pair"; $path)]
        else [] end)
     + (if $s7 then
          [$s7_bad[] | s_emit("S7"; "error"; .; false;
                              "manual: hand-edit the session log to repair the tool_result"; $path)]
        else [] end)
     + (if $s8 then
          [$parsed[]
           | select(is_event(.v))
           | select(.v.type == "message" and .v.source == "assistant")
           | select(.i != $last_assist_i)
           | .n as $n
           | .v as $v
           | .i as $i
           | ($v.payload.tool_calls // [] | .[]) as $tc
           | if (($tc.id // null) == null) then
               s_emit("S8"; "warn"; ("assistant tool call (event " + ($n | tostring) + ") has no id");
                      false; "manual: hand-edit the session log to repair the tool call"; $path)
             elif any($results[]; .i > $i and .id == $tc.id) then empty
             else
               s_emit("S8"; "warn";
                      ("assistant tool call " + ($tc.id | tojson) + " (event " + ($n | tostring)
                       + ") has no tool_result");
                      false; "manual: hand-edit the session log to repair the tool call"; $path)
             end]
        else [] end)
     + (if $s9 then
          [$parsed[]
           | select(is_event(.v))
           | if (.v | has("version") | not) then
               s_emit("S9"; "info"; ("event " + (.n | tostring) + " has no version");
                      false; "manual: ignore (legacy events predate the envelope) or restamp"; $path)
             elif .v.version == "1.0" then empty
             else
               s_emit("S9"; "warn";
                      ("event " + (.n | tostring) + " has unknown version " + (.v.version | tojson));
                      false; "manual: restamp the event to a known version or hand-edit the log"; $path)
             end]
        else [] end))
  | .[]
'
ck_S() {
  if [ -n "${S_SCAN_DONE:-}" ]; then return; fi
  S_SCAN_DONE=1
  local f id date latest latest_state want_s1 want_s2 want_s3 want_s5 want_s6 want_s7 want_s8 want_s9
  want_s1="$(want S1)"
  want_s2="$(want S2)"
  want_s3="$(want S3)"
  want_s5="$(want S5)"
  want_s6="$(want S6)"
  want_s7="$(want S7)"
  want_s8="$(want S8)"
  want_s9="$(want S9)"
  for f in "$SESSIONS_DIR"/*.jsonl; do
    [ -f "$f" ] || continue
    id="$(basename "$f" .jsonl)"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    latest="$SESSIONS_DIR/$id.latest.json"
    if [ ! -e "$latest" ]; then
      latest_state=missing
    elif [ ! -f "$latest" ]; then
      latest_state=other
    elif [ ! -s "$latest" ]; then
      latest_state=empty
    else
      latest_state=present
    fi
    # $latest_text is defined for every branch of the program: the real file when it is a
    # readable regular file, /dev/null otherwise. It is $latest_state that makes a
    # missing/empty/non-file .latest.json report correctly, never the rawfile content.
    if [ -f "$latest" ]; then
      jq -cnR --rawfile latest_text "$latest" \
        --arg sid "$id" --arg path "$f" --arg latest_path "$latest" \
        --arg latest_state "$latest_state" \
        --argjson s1 "$want_s1" --argjson s2 "$want_s2" --argjson s3 "$want_s3" \
        --argjson s5 "$want_s5" --argjson s6 "$want_s6" --argjson s7 "$want_s7" \
        --argjson s8 "$want_s8" --argjson s9 "$want_s9" \
        "$SESS_SCAN_PROGRAM" "$f" >>"$FINDINGS_FILE"
    else
      jq -cnR --rawfile latest_text /dev/null \
        --arg sid "$id" --arg path "$f" --arg latest_path "$latest" \
        --arg latest_state "$latest_state" \
        --argjson s1 "$want_s1" --argjson s2 "$want_s2" --argjson s3 "$want_s3" \
        --argjson s5 "$want_s5" --argjson s6 "$want_s6" --argjson s7 "$want_s7" \
        --argjson s8 "$want_s8" --argjson s9 "$want_s9" \
        "$SESS_SCAN_PROGRAM" "$f" >>"$FINDINGS_FILE"
    fi
  done
}

# want <id>: "true"/"false" whether check <id> is selected for this run. The L and F jq
# passes receive these as --argjson so one pass per store file emits exactly the selected
# family members' findings.
want() {
  if [ -n "${WANT_CHECKS[$1]:-}" ]; then printf 'true'; else printf 'false'; fi
}

# --- run-store checks (R1-R7, issue #391) ------------------------------------------
# R1/R2/R3/R5 share exactly one jq pass per events.jsonl: run_summary caches a single
# jq -s summary (line count, non-object lines, meta.run_id values, span ids, span
# parents) that each check then filters in memory, so no check re-parses a store file.
# R6 is the mandated exception — it calls lib/replay.sh's classify_replay, whose own
# reads of the run and session logs are #386's contract, not part of this scan's budget.

# run_summary <log>: the cached one-pass jq summary of a run log. Prints a JSON object
# with keys count, bad_lines (1-based lines that are not JSON objects), run_ids
# ({line, rid} per line carrying a meta.run_id), spans (unique meta.span_id strings),
# and span_parents ({line, span, parent} per line carrying a meta.span_id); prints
# nothing when the file does not parse as JSON (the caller treats that as
# "unparseable" and lets R1 own the report).
declare -A RUN_SUMMARIES=()
RUN_SUMMARY_PROGRAM='{count: length,
  bad_lines: [to_entries[] | select((.value | type) != "object") | (.key + 1)],
  run_ids: [to_entries[] | select((.value | type) == "object")
            | select((.value.meta.run_id? // null) != null)
            | {line: (.key + 1), rid: .value.meta.run_id}],
  spans: [.[] | select(type == "object") | .meta.span_id? // empty
          | select(type == "string")] | unique,
  span_parents: [to_entries[] | select((.value | type) == "object")
                 | select((.value.meta.span_id? // null) != null)
                 | {line: (.key + 1), span: .value.meta.span_id,
                    parent: (.value.meta.parent_span_id? // null)}]}'
run_summary() {
  local log="$1"
  if [ -z "${RUN_SUMMARIES[$log]+x}" ]; then
    RUN_SUMMARIES[$log]="$(jq -c -s "$RUN_SUMMARY_PROGRAM" "$log" 2>/dev/null)" || RUN_SUMMARIES[$log]=""
  fi
  printf '%s' "${RUN_SUMMARIES[$log]}"
}

# run_dir_empty <dir>: 0 when <dir> has no entries at all — R1's narrow fixable case.
# A directory that still holds any file (span dumps, a partial log) is the only trace
# of an API call and gets a manual remedy instead. dotglob counts hidden files too.
run_dir_empty() {
  local entries=()
  shopt -s nullglob dotglob
  entries=("$1"/*)
  shopt -u nullglob dotglob
  [ "${#entries[@]}" -eq 0 ]
}

# R1 — runs/<id>/events.jsonl must exist, be non-empty, and parse line-by-line as JSON
# objects. Severity error. The only fixable shape is a wholly empty run directory; a
# directory holding anything else is evidence a human should look at, so those shapes
# get manual remedies.
ck_R1() {
  local dir id date log summary n bad line
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    dir="${dir%/}" # canonical path: the finding's path is the fixer's verbatim input
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then
      if run_dir_empty "$dir"; then
        finding R1 error runs "$id" "$dir" "run directory is empty (no events.jsonl)" true delete
      else
        finding R1 error runs "$id" "$dir" "run directory has files but no events.jsonl" \
          false "manual: inspect the files, then delete the run directory"
      fi
      continue
    fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then
      finding R1 error runs "$id" "$log" "events.jsonl contains a line that does not parse as JSON" \
        false "manual: repair or delete the run log"
      continue
    fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then
      finding R1 error runs "$id" "$log" "events.jsonl is empty" \
        false "manual: inspect the run directory, then delete it"
      continue
    fi
    bad="$(printf '%s' "$summary" | jq -c '.bad_lines')"
    if [ "$bad" != "[]" ]; then
      while IFS= read -r line; do
        finding R1 error runs "$id" "$log" "events.jsonl line $line is not a JSON object" \
          false "manual: repair or delete the run log"
      done < <(printf '%s' "$bad" | jq -r '.[]')
    fi
  done
}

# R2 — every meta.run_id in a run log must equal the directory name. Severity error,
# not fixable: which side is wrong (the directory name or the log) is a human judgment
# call. Only lines carrying a meta.run_id are checked; unstamped lines are not
# violations. Runs whose log R1 already reported (missing/empty/unparseable) are
# skipped rather than double-counted.
ck_R2() {
  local dir id date log summary n line rid
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    dir="${dir%/}"
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then continue; fi
    while IFS=$'\t' read -r line rid; do
      finding R2 error runs "$id" "$log" \
        "line $line: meta.run_id $rid does not match the run directory" \
        false "manual: rename the run directory or correct the run log"
    done < <(printf '%s' "$summary" | jq -r --arg id "$id" \
      '.run_ids[] | select(.rid != $id) | "\(.line)\t\(.rid)"')
  done
}

# R3 — span ids must form span_1..span_N with no gaps, and meta.parent_span_id must
# form a linear chain (span_k's parent is span_{k-1}; span_1's parent is null).
# Severity warn, not fixable. span_0 is exempt: a hand-run shai-eval with SHAI_RUN_ID
# set but no SHAI_SPAN_ID dumps to span_0-request.json, and real spans start at
# span_1, so span_0 is never a gap and never a chain member. The chain is checked
# only when the sequence is contiguous — a gapped sequence has no linear chain by
# definition, and reporting both for one corruption would double-count it. Span ids
# outside the span_N shape are reported individually: a corrupted id like span_1x is
# otherwise invisible to both the gap and the chain check.
ck_R3() {
  local dir id date log summary n max missing k parent expected s
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    dir="${dir%/}"
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then continue; fi
    while IFS= read -r s; do
      finding R3 warn runs "$id" "$log" \
        "span id $s is not in span_N form (span_1..span_N, or span_0 for hand runs)" \
        false "manual: repair the run log"
    done < <(printf '%s' "$summary" | jq -r '.spans[] | select(test("^span_[0-9]+$") | not)')
    max="$(printf '%s' "$summary" | jq -r '[.spans[]
      | select(test("^span_[0-9]+$")) | sub("^span_"; "") | tonumber
      | select(. > 0)] | if length == 0 then 0 else max end')"
    if [ "$max" -eq 0 ]; then continue; fi
    missing="$(printf '%s' "$summary" | jq -c --argjson max "$max" '
      [.spans[] | select(test("^span_[0-9]+$")) | sub("^span_"; "") | tonumber
       | select(. > 0)] as $have | [range(1; $max + 1)] - $have')"
    if [ "$missing" != "[]" ]; then
      while IFS= read -r k; do
        finding R3 warn runs "$id" "$log" "span_$k missing (gaps in the span sequence)" \
          false "manual: repair the run log"
      done < <(printf '%s' "$missing" | jq -r '.[]')
      continue
    fi
    while IFS=$'\t' read -r k parent expected; do
      finding R3 warn runs "$id" "$log" \
        "span_$k parent_span_id is $parent (expected $expected)" \
        false "manual: repair the run log"
    done < <(printf '%s' "$summary" | jq -r '
      [.span_parents[]
       | select(.span | type == "string")
       | select(.span | test("^span_[0-9]+$"))
       | .n = (.span | sub("^span_"; "") | tonumber)
       | select(.n > 0)
       | .expected = (if .n == 1 then null else "span_" + ((.n - 1) | tostring) end)
       | select(.parent != .expected)
       | "\(.n)\t\(.parent)\t\(.expected)"] | .[]')
  done
}

# R4 — every <span>-request.json / <span>-response.json dump must parse as JSON.
# Severity warn, deliberately not fixable: a malformed dump is the only record of a
# failed API call, so deleting it must stay a human decision. One jq validation pass
# per dump file, and no other check reads dumps.
ck_R4() {
  local dir id date dump fname dumps=()
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    dir="${dir%/}"
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    shopt -s nullglob
    dumps=("$dir"/span_*-request.json "$dir"/span_*-response.json)
    shopt -u nullglob
    for dump in "${dumps[@]+"${dumps[@]}"}"; do
      if ! jq -e . "$dump" >/dev/null 2>&1; then
        fname="$(basename "$dump")"
        finding R4 warn runs "$id" "$dump" "$fname does not parse as JSON" \
          false "manual: inspect the dump, then delete or repair it"
      fi
    done
  done
}

# R5 — a span dump must have a matching event in its run log; a dump whose span has no
# event is an orphan (the defect the live-audit found: span_9-request.json with events
# only through span_8). Severity warn, fixable by deleting the dump. span_0 is exempt
# (CLAUDE.md: a hand-run shai-eval without SHAI_SPAN_ID dumps to span_0-request.json —
# legitimate, never an orphan). R5 only classifies dumps when the run log is present,
# non-empty, and parseable: without an authoritative span set orphanhood is unprovable,
# and those directories are already R1's report.
ck_R5() {
  local dir id date log summary dump fname span found s spans=() dumps=()
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    dir="${dir%/}"
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    if [ "$(printf '%s' "$summary" | jq -r '.count')" -eq 0 ]; then continue; fi
    mapfile -t spans < <(printf '%s' "$summary" | jq -r '.spans[]')
    shopt -s nullglob
    dumps=("$dir"/span_*-request.json "$dir"/span_*-response.json)
    shopt -u nullglob
    for dump in "${dumps[@]+"${dumps[@]}"}"; do
      fname="$(basename "$dump")"
      span="${fname%-request.json}"
      span="${span%-response.json}"
      if [ "$span" = "span_0" ]; then continue; fi
      found=""
      for s in "${spans[@]+"${spans[@]}"}"; do
        if [ "$s" = "$span" ]; then
          found=1
          break
        fi
      done
      if [ -z "$found" ]; then
        finding R5 warn runs "$id" "$dump" "$fname has no matching event in the run log" true delete
      fi
    done
  done
}

# R6 — a run's events must appear in some session log; buffer-then-commit means a run
# directory whose events never reached a session is an uncommitted run. Severity warn.
# The verdict comes from classify_replay — the exact five preconditions shai-retry
# --run applies — so fsck can never call a run "resumable" that shai-retry would refuse
# (issue #386's contract, including the meta.retry_of half of the committed test).
# A resumable run is never fixable; its remedy is the literal resume command, and the
# summary carries it too so every renderer lets the user act on it directly. Only dead
# runs (no user message, or no session id) are fixable: their events are unreplayable,
# so deletion loses nothing recoverable. classify_replay is only called on present,
# non-empty, parseable run logs — R1 owns the other shapes, and the classifier's own
# jq would otherwise fail on a malformed log.
ck_R6() {
  local dir id date log summary n
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    dir="${dir%/}"
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then continue; fi
    classify_replay "$id"
    case "$REPLAY_VERDICT" in
      committed) ;;
      replayable)
        finding R6 warn runs "$id" "$log" \
          "uncommitted run (resumable) — shai-retry --run $id" false "shai-retry --run $id"
        ;;
      no-user-message)
        finding R6 warn runs "$id" "$log" "uncommitted run (dead: no user message)" true delete
        ;;
      no-session-id)
        finding R6 warn runs "$id" "$log" "uncommitted run (dead: no session id)" true delete
        ;;
      unsafe-session-id)
        finding R6 warn runs "$id" "$log" \
          "uncommitted run (session id in the run log is unsafe: $REPLAY_SESSION)" \
          false "manual: repair the run log"
        ;;
      unsafe-run-id | no-log) ;; # unreachable behind the gates above; fail-closed skip
      *)
        # classify_replay only emits the verdicts above; fail closed rather than
        # silently misclassifying a run.
        printf 'error: cannot classify run log: %s\n' "$log" >&2
        exit 3
        ;;
    esac
  done
}

# R7 — every meta.run_id referenced by a session event must have a run directory on
# disk. Severity info, never fixable: shai-prune --runs legitimately removes run
# directories while their events remain committed in the session log, and shai-trace
# already handles that ("run directory not found; using session log"). Reported so a
# user understands why shai-trace warns, not because anything is broken. Run ids
# containing / or .. are skipped — they could never name a real run directory, and
# probing them would re-derive shai-retry's path guard as a bare existence check.
# ck_R7 also fires on the --store runs path (the dispatch arm and the missing-runs/
# exception above), where the scan loop's sessions-store readability guard does not
# apply — the check carries its own exit-3 guard so an unreadable sessions dir aborts the
# scan instead of reading as a false-clean report.
ck_R7() {
  local f id date refs rid
  # A missing sessions dir is clean by definition (no session logs, no references);
  # a present-but-unreadable one must abort — mirror the per-store guard above.
  if [ -d "$SESSIONS_DIR" ] && { [ ! -r "$SESSIONS_DIR" ] || [ ! -x "$SESSIONS_DIR" ]; }; then
    printf 'error: cannot scan %s (not readable) — scan aborted\n' "$SESSIONS_DIR" >&2
    exit 3
  fi
  for f in "$SESSIONS_DIR"/*.jsonl; do
    if [ ! -f "$f" ]; then continue; fi
    id="$(basename "$f" .jsonl)"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    # Raw input with a per-line try/catch, exactly like SESS_SCAN_PROGRAM: a session line
    # that does not parse is S1's finding to report, and aborting here would discard that
    # report along with every reference the file's readable lines do carry — turning a
    # reported problem into "the check never ran". What still aborts is the case this
    # guard exists for: a session log jq cannot read at all, which raw mode leaves as
    # jq's own non-zero exit (the same chmod-only shape as the sessions-dir guard above).
    if ! refs="$(jq -cnR '[inputs | (try fromjson catch empty)
                           | select(type == "object") | .meta.run_id? // empty
                           | select(type == "string") | select(length > 0)
                           | select(test("^[^/]+$")) | select(contains("..") | not)]
                           | unique' "$f" 2>/dev/null)"; then
      printf 'error: cannot scan %s (not readable) — scan aborted\n' "$f" >&2
      exit 3
    fi
    while IFS= read -r rid; do
      if [ ! -d "$RUNS_DIR/$rid" ]; then
        finding R7 info runs "$rid" "$RUNS_DIR/$rid" \
          "run directory missing (events remain in the session log)" false \
          "manual: ignore (the run was likely pruned) or recreate the run directory"
      fi
    done < <(printf '%s' "$refs" | jq -r '.[]')
  done
}

# L1/L2/L3 — ledgers/<workflow>.jsonl, one jq pass per file. The --after/--before window
# does not apply here: it is a filename-level filter for items carrying an embedded date,
# and a ledger line that fails L1 has no parseable date at all, while an L2 duplicate is a
# fact about the whole file.
#
# L1 (error): every line parses and has a non-empty string key, a ts, and a session_id.
#   wf_mark writes all three, so a violation is a hand edit or a torn append.
# L2 (error): no key appears twice. wf_mark is idempotent (wf_seen short-circuits), so a
#   duplicate is evidence of a dispatcher race or a hand edit — it breaks the "have I done
#   this already" guarantee the ledger exists to answer, hence error, and the summary
#   names the duplicated key.
# L3 (info): session_id resolves to an existing session log. shai-prune --sessions
#   legitimately removes sessions a ledger still names, so this is info, not a defect.
#
# The pass appends complete accumulator records itself (same eight-key contract as
# finding()) — routing each through the shell would cost a second jq invocation per
# finding. Dispatch runs ck_L once per scan, from the first selected L1/L2/L3 arm, so the
# one-pass-per-file property holds however many L ids are selected.
ck_L() {
  if [ -n "${L_SCAN_DONE:-}" ]; then return; fi
  L_SCAN_DONE=1
  local f wf
  for f in "$LEDGERS_DIR"/*.jsonl; do
    [ -f "$f" ] || continue
    wf="$(basename "$f" .jsonl)"
    jq -cnR --arg path "$f" --arg wf "$wf" \
      --argjson l1 "$(want L1)" --argjson l2 "$(want L2)" --argjson l3 "$(want L3)" \
      --argjson sessions "$SESSION_MAP_JSON" \
      '
      def l1_reason($v):
        if $v.__unparseable == true then "is not valid JSON"
        elif ($v | type) != "object" then "is not a JSON object"
        elif ((($v.key // null) | type) != "string") or $v.key == "" then
          "key is missing or not a non-empty string"
        elif ($v | has("ts") | not) or $v.ts == null then "is missing ts"
        elif ($v | has("session_id") | not) or $v.session_id == null then
          "is missing session_id"
        else empty end;
      [inputs] as $lines
      | [$lines | to_entries[] |
          {n: (.key + 1), v: (try (.value | fromjson) catch {__unparseable: true})}]
          as $parsed
      | (if $l1 then
           $parsed[]
           | l1_reason(.v) as $reason
           | {check: "L1", severity: "error", store: "ledgers",
              target: $wf, path: $path,
              summary: ("line " + (.n | tostring) + " " + $reason),
              fixable: false,
              remedy: "hand-edit the ledger to repair or remove the line"}
         else empty end),
        (if $l2 then
           [$parsed[] | .v | select(type == "object") | .key
            | select((type == "string") and (. != ""))]
           | group_by(.)
           | map(select(length > 1))
           | .[]
           | {check: "L2", severity: "error", store: "ledgers",
              target: $wf, path: $path,
              summary: ("duplicate key \"" + .[0] + "\" (" + (length | tostring) + " entries)"),
              fixable: false,
              remedy: "hand-edit the ledger to remove the duplicate entry"}
         else empty end),
        (if $l3 then
           $parsed[]
           | .v as $v
           | select((($v.session_id // null) | type) == "string"
                    and $v.session_id != ""
                    and $sessions[$v.session_id] != true)
           | {check: "L3", severity: "info", store: "ledgers",
              target: $wf, path: $path,
              summary: ("line " + (.n | tostring) + " references missing session \""
                        + $v.session_id + "\""),
              fixable: false,
              remedy: "ignore (the session was likely pruned) or hand-edit the ledger entry"}
         else empty end)
      ' "$f" >>"$FINDINGS_FILE"
  done
}

# L4 — the ledger filename names a directory under workflows/ (info). A ledger outlives a
# workflow that was renamed or deleted; that is normal operation, so this reports rather
# than judges — info, never fixable.
ck_L4() {
  local f wf
  for f in "$LEDGERS_DIR"/*.jsonl; do
    [ -f "$f" ] || continue
    wf="$(basename "$f" .jsonl)"
    if [ ! -d "$WORKFLOWS_DIR/$wf" ]; then
      finding L4 info ledgers "$wf" "$f" \
        "no workflows/$wf/ directory (workflow removed or renamed?)" false \
        "ignore (the ledger outlived the workflow) or delete the ledger by hand"
    fi
  done
}

# F1-F4 — failures/<workflow>.jsonl, one jq pass per file. The failure store feeds
# shai-stats' Failures: section, so a malformed record silently skews reported failure
# rates — F1/F3 are errors for exactly that reason. Like the L family, the --after/--before
# window does not apply (per-record corruption has no filename-level date to filter on).
#
# F1 (error): every line parses and carries all seven documented keys — ts, workflow,
#   run_id, session_id, category, summary, context (nulls are fine: fail_record writes
#   null ids when no trace context exists).
# F2 (warn): category is one of the five documented values (api_error, dispatch_error,
#   tool_error, policy_denial, workflow_error). A new category may legitimately land in
#   code before the docs catch up, so this notices rather than blocks. A record missing
#   the key entirely is F1's job (the guard below checks has("category") so the two never
#   double-report); a present-but-null category is impossible through fail_record (the
#   category is a --arg string) and is flagged here too.
# F3 (error): context is a JSON object. fail_record's {"raw": ...} fallback guarantees the
#   object shape, so a violation means a hand edit or a writer outside the documented path
#   — should be impossible, hence error.
# F4 (info): a non-null run_id/session_id resolves (to runs/<id>/ or sessions/<id>.jsonl).
#   Null ids — no trace context — are skipped, not flagged; pruning legitimately removes
#   runs/sessions a record still names, so unresolved ids are info.
ck_F() {
  if [ -n "${F_SCAN_DONE:-}" ]; then return; fi
  F_SCAN_DONE=1
  local f wf
  for f in "$FAILURES_DIR"/*.jsonl; do
    [ -f "$f" ] || continue
    wf="$(basename "$f" .jsonl)"
    jq -cnR --arg path "$f" --arg wf "$wf" \
      --argjson f1 "$(want F1)" --argjson f2 "$(want F2)" \
      --argjson f3 "$(want F3)" --argjson f4 "$(want F4)" \
      --argjson sessions "$SESSION_MAP_JSON" --argjson runs "$RUN_MAP_JSON" \
      '
      def categories: ["api_error", "dispatch_error", "tool_error", "policy_denial",
                       "workflow_error"];
      def f1_reason($v):
        if $v.__unparseable == true then "is not valid JSON"
        elif ($v | type) != "object" then "is not a JSON object"
        elif ($v | has("ts") | not) then "is missing key ts"
        elif ($v | has("workflow") | not) then "is missing key workflow"
        elif ($v | has("run_id") | not) then "is missing key run_id"
        elif ($v | has("session_id") | not) then "is missing key session_id"
        elif ($v | has("category") | not) then "is missing key category"
        elif ($v | has("summary") | not) then "is missing key summary"
        elif ($v | has("context") | not) then "is missing key context"
        else empty end;
      [inputs] as $lines
      | [$lines | to_entries[] |
          {n: (.key + 1), v: (try (.value | fromjson) catch {__unparseable: true})}]
          as $parsed
      | (if $f1 then
           $parsed[]
           | f1_reason(.v) as $reason
           | {check: "F1", severity: "error", store: "failures",
              target: $wf, path: $path,
              summary: ("line " + (.n | tostring) + " " + $reason),
              fixable: false,
              remedy: "hand-edit the failure log to repair or remove the line"}
         else empty end),
        (if $f2 then
           $parsed[]
           | select((.v | type) == "object")
           | .v.category as $c
           | select((.v | has("category")) and ((categories | index($c)) == null))
           | {check: "F2", severity: "warn", store: "failures",
              target: $wf, path: $path,
              summary: (if $c == null then ("line " + (.n | tostring) + " category is null")
                        else ("line " + (.n | tostring) + " has unknown category \"" + $c + "\"") end),
              fixable: false,
              remedy: "ignore (a new category may predate its docs) or hand-edit the record"}
         else empty end),
        (if $f3 then
           $parsed[]
           | select((.v | type) == "object")
           | select((.v | has("context")) and ((.v.context | type) != "object"))
           | {check: "F3", severity: "error", store: "failures",
              target: $wf, path: $path,
              summary: ("line " + (.n | tostring) + " context is " + (.v.context | type) +
                        ", not an object"),
              fixable: false,
              remedy: "hand-edit the record — every writer must go through fail_record"}
         else empty end),
        (if $f4 then
           ($parsed[]
            | select((.v | type) == "object")
            | .v.run_id as $rid
            | select((($rid // null) | type) == "string"
                     and $rid != ""
                     and $runs[$rid] != true)
            | {check: "F4", severity: "info", store: "failures",
               target: $wf, path: $path,
               summary: ("line " + (.n | tostring) + " run_id \"" + $rid + "\" does not resolve"),
               fixable: false,
               remedy: "ignore (the run was likely pruned) or hand-edit the record"}),
           ($parsed[]
            | select((.v | type) == "object")
            | .v.session_id as $sid
            | select((($sid // null) | type) == "string"
                     and $sid != ""
                     and $sessions[$sid] != true)
            | {check: "F4", severity: "info", store: "failures",
               target: $wf, path: $path,
               summary: ("line " + (.n | tostring) + " session_id \"" + $sid + "\" does not resolve"),
               fixable: false,
               remedy: "ignore (the session was likely pruned) or hand-edit the record"})
         else empty end)
      ' "$f" >>"$FINDINGS_FILE"
  done
}

# X1 — every entry under a store directory matches that store's expected name pattern
# (info). This is the "report the unknown, touch nothing" half of fsck: without it the
# clean verdict is a lie by omission, because "no problems found" would mean only "every
# file I recognized was fine". The patterns are the real writers' shapes: sessions/ holds
# <id>.jsonl plus its <id>.latest.json sibling, runs/<id>/ holds events.jsonl plus
# <span>-request.json / <span>-response.json dumps, and ledgers/ and failures/ hold
# <workflow>.jsonl. Deliberately never fixable: deleting something fsck cannot classify
# is exactly what an integrity tool must not do, so the remedy is manual.
ck_X1() {
  local store="$1" dir f g base gbase
  dir="$(store_dir "$store")"
  case "$store" in
    sessions)
      for f in "$dir"/*; do
        [ -e "$f" ] || continue
        base="$(basename "$f")"
        if [ -f "$f" ]; then
          case "$base" in
            *.jsonl | *.latest.json) ;;
            *) x1_finding sessions "$base" "*.jsonl or *.latest.json" ;;
          esac
        else
          x1_finding sessions "$base" "*.jsonl or *.latest.json"
        fi
      done
      ;;
    ledgers | failures)
      for f in "$dir"/*; do
        [ -e "$f" ] || continue
        base="$(basename "$f")"
        if [ -f "$f" ]; then
          case "$base" in
            *.jsonl) ;;
            *) x1_finding "$store" "$base" "*.jsonl" ;;
          esac
        else
          x1_finding "$store" "$base" "*.jsonl"
        fi
      done
      ;;
    runs)
      for f in "$dir"/*; do
        [ -e "$f" ] || continue
        base="$(basename "$f")"
        if [ -d "$f" ]; then
          for g in "$f"/*; do
            [ -e "$g" ] || continue
            gbase="$(basename "$g")"
            case "$gbase" in
              events.jsonl | *-request.json | *-response.json) ;;
              *) x1_finding runs "$base/$gbase" \
                "events.jsonl, *-request.json, or *-response.json" ;;
            esac
          done
        else
          x1_finding runs "$base" "a run directory"
        fi
      done
      ;;
  esac
}

# x1_finding <store> <store-relative-path> <expected-pattern>: emit one X1 info finding.
x1_finding() {
  local store="$1" rel="$2" expected="$3"
  finding X1 info "$store" "$rel" "$(store_dir "$store")/$rel" \
    "unrecognized entry (expected $expected)" false \
    "inspect and remove the file by hand if it is a stray or temp file"
}

# scan: run every selected check against every selected store. --store and --check are
# repeatable filters; a check that belongs to an unselected store simply never fires.
declare -A WANT_STORES=()
if [ "${#STORES[@]}" -eq 0 ]; then
  for s in "${ALL_STORES[@]}"; do WANT_STORES["$s"]=1; done
else
  for s in "${STORES[@]}"; do WANT_STORES["$s"]=1; done
fi
declare -A WANT_CHECKS=()
if [ "${#CHECKS[@]}" -eq 0 ]; then
  for c in "${KNOWN_CHECKS[@]}"; do WANT_CHECKS["$c"]=1; done
else
  for c in "${CHECKS[@]}"; do WANT_CHECKS["$c"]=1; done
fi

# Resolution maps for L3/F4: the existing session ids and run ids, gathered once from the
# filesystem and handed into the ledger/failure passes as {"<id>": true} JSON objects, so
# a record's session_id/run_id resolution test happens inside the file's single jq pass
# rather than as a per-record filesystem lookup.
declare -a EXISTING_SESSIONS=() EXISTING_RUNS=()
if [ -d "$SESSIONS_DIR" ]; then
  for f in "$SESSIONS_DIR"/*.jsonl; do
    [ -f "$f" ] || continue
    EXISTING_SESSIONS+=("$(basename "$f" .jsonl)")
  done
fi
if [ -d "$RUNS_DIR" ]; then
  for d in "$RUNS_DIR"/*/; do
    [ -d "$d" ] || continue
    EXISTING_RUNS+=("$(basename "$d")")
  done
fi
SESSION_MAP_JSON="$(printf '%s\n' "${EXISTING_SESSIONS[@]+"${EXISTING_SESSIONS[@]}"}" |
  jq -cRn '[inputs | {(.): true}] | add // {}')"
RUN_MAP_JSON="$(printf '%s\n' "${EXISTING_RUNS[@]+"${EXISTING_RUNS[@]}"}" |
  jq -cRn '[inputs | {(.): true}] | add // {}')"

for store in "${ALL_STORES[@]}"; do
  if [ -z "${WANT_STORES[$store]:-}" ]; then continue; fi
  dir="$(store_dir "$store")"
  # A store directory that was never created is an empty store, not a failure — with one
  # exception: R7's subject is run directories that are NOT on disk (it reads session
  # logs, not runs/), so a missing runs/ is exactly the state it exists to report. Run
  # it before the per-check loop rather than letting the empty-store skip swallow it.
  if [ ! -d "$dir" ]; then
    if [ "$store" = "runs" ] && [ -n "${WANT_CHECKS[R7]:-}" ]; then ck_R7; fi
    continue
  fi
  if [ ! -r "$dir" ] || [ ! -x "$dir" ]; then
    printf 'error: cannot scan %s (not readable) — scan aborted\n' "$dir" >&2
    exit 3
  fi
  for check in "${KNOWN_CHECKS[@]}"; do
    if [ -z "${WANT_CHECKS[$check]:-}" ]; then continue; fi
    if [ "${CHECK_STORE[$check]}" != "$store" ] && [ "${CHECK_STORE[$check]}" != "all" ]; then continue; fi
    # Explicit dispatch, not a dynamic "$check" invocation: shellcheck can prove these
    # functions are reached, and new check families add case arms here next to their
    # catalog entries above. S1-S3/S5-S9, L1-L3, and F1-F4 share one jq pass per store
    # file across the whole family (ck_S/ck_L/ck_F), dispatched from the first selected
    # member's arm.
    case "$check" in
      S1 | S2 | S3 | S5 | S6 | S7 | S8 | S9) ck_S ;;
      S4) ck_S4 ;;
      R1) ck_R1 ;;
      R2) ck_R2 ;;
      R3) ck_R3 ;;
      R4) ck_R4 ;;
      R5) ck_R5 ;;
      R6) ck_R6 ;;
      R7) ck_R7 ;;
      L1 | L2 | L3) ck_L ;;
      L4) ck_L4 ;;
      F1 | F2 | F3 | F4) ck_F ;;
      X1) ck_X1 "$store" ;;
    esac
  done
done

# One jq pass over the accumulator (never over store files) computes every downstream
# number: the digest, the exit verdict, and --fix's worklist.
STATS="$(jq -s '{
  errors: ([.[] | select(.severity == "error")] | length),
  warnings: ([.[] | select(.severity == "warn")] | length),
  info: ([.[] | select(.severity == "info")] | length),
  fixable: ([.[] | select(.fixable == true)] | length),
  unfixable: ([.[] | select(.fixable != true)] | length),
  total: length
}' "$FINDINGS_FILE")"
total="$(printf '%s' "$STATS" | jq -r '.total')"
errors="$(printf '%s' "$STATS" | jq -r '.errors')"
warnings="$(printf '%s' "$STATS" | jq -r '.warnings')"
info="$(printf '%s' "$STATS" | jq -r '.info')"
fixable="$(printf '%s' "$STATS" | jq -r '.fixable')"
unfixable="$(printf '%s' "$STATS" | jq -r '.unfixable')"

# --- --fix: repair what the findings say is repairable, refuse the rest ---------------
# The worklist is the accumulator itself: records with fixable == true, in scan order.
# Each fixable check maps to exactly one safe action — rebuild a derived file (S5) or
# delete a whole redundant unit (S4, S6, R1's wholly-empty run directory, R5, R6's dead
# run). Nothing else is ever touched: an event-bearing .jsonl is never edited, rewritten,
# truncated, or dropped line-by-line (CLAUDE.md's head -n 20 rewind guarantee must hold
# with or without fsck), and an unfixable finding is reported with its named manual
# remedy rather than papered over. Repairs are independent — none depends on another
# having run — and scoping (--store/--check/--after/--before) was already applied by the
# scan, so the worklist is scoped by construction.
apply_fixes() {
  local check fixable store target path remedy latest log run_dir worklist
  # One pass over the accumulator builds the whole worklist; jq failing here must abort
  # (exit 3 via the ERR trap), never silently skip the repairs — hence the assignment,
  # whose command-substitution failure set -e does check.
  worklist="$(jq -rs '.[] | [.check, (.fixable | tostring), .store, .target, .path, .remedy] | @tsv' \
    "$FINDINGS_FILE")"
  while IFS=$'\t' read -r check fixable store target path remedy; do
    if [ "$fixable" = "true" ]; then
      case "$check" in
        S4)
          # Orphan .latest.json with no sibling session log: delete the orphan.
          printf 'repair: delete %s (%s)\n' "$path" "$check" >&2
          if [ "$DRY_RUN" != true ]; then rm -f -- "$path"; fi
          ;;
        S5)
          # Rebuild .latest.json from the last line of the session log — the exact
          # invariant the dispatch loop and shai-retry expect of LATEST. Rebuild, never
          # delete: removing LATEST can turn a repairable run into an unresumable one.
          # The temp-file + mv keeps a failed rebuild from truncating the old file. The
          # not-a-regular-file guard runs BEFORE the plan line and in dry-run too (#439):
          # a directory (or any non-file) sitting where .latest.json belongs makes the
          # real repair fail, so the plan must never claim that rebuild. Dry-run prints
          # a manual: refusal instead (the verdict then exits 1); a real --fix fails the
          # repair (exit 3) instead of mv'ing into a directory.
          if [ -e "$path" ] && [ ! -f "$path" ]; then
            if [ "$DRY_RUN" = true ]; then
              printf 'manual: %s %s — %s\n' "$check" "$path" \
                'rebuild blocked: the path is not a regular file (move it aside, then re-run --fix)' >&2
              DRY_REFUSED=$((DRY_REFUSED + 1))
            else
              printf 'error: cannot rebuild %s (not a regular file)\n' "$path" >&2
              exit 3
            fi
          else
            printf 'repair: rebuild %s (%s)\n' "$path" "$check" >&2
            if [ "$DRY_RUN" != true ]; then
              latest="$path"
              log="$(store_dir "$store")/$target.jsonl"
              tail -n 1 "$log" >"$latest.tmp.$$"
              mv "$latest.tmp.$$" "$latest"
            fi
          fi
          ;;
        S6)
          # Stillborn session: the seeded pair (one system event + empty .latest.json)
          # is a wholly redundant unit — delete both halves.
          latest="${path%.jsonl}.latest.json"
          printf 'repair: delete pair %s and %s (%s)\n' "$path" "$latest" "$check" >&2
          if [ "$DRY_RUN" != true ]; then rm -f -- "$path" "$latest"; fi
          ;;
        R1)
          # Wholly empty run directory. rmdir, not rm -rf: only the emptiness the check
          # verified is deleted, and a directory that somehow gained an entry between
          # scan and fix fails the repair (exit 3) instead of losing a file.
          printf 'repair: delete %s (%s)\n' "$path" "$check" >&2
          if [ "$DRY_RUN" != true ]; then rmdir -- "$path"; fi
          ;;
        R5)
          # Orphan span dump (no matching event in the run log): delete the dump only.
          printf 'repair: delete %s (%s)\n' "$path" "$check" >&2
          if [ "$DRY_RUN" != true ]; then rm -f -- "$path"; fi
          ;;
        R6)
          # Dead uncommitted run — no user message or no session id, so nothing
          # replayable is lost. Delete the whole run directory. A resumable run is never
          # fixable (its remedy is the printed shai-retry command), so it can never
          # reach this arm.
          run_dir="$(store_dir "$store")/$target"
          printf 'repair: delete %s (%s)\n' "$run_dir" "$check" >&2
          if [ "$DRY_RUN" != true ]; then rm -rf -- "$run_dir"; fi
          ;;
        *)
          # fail closed: a fixable record the fixer does not know how to repair means the
          # accumulator contract broke, and repairing nothing is safer than guessing.
          printf 'error: finding %s is marked fixable but has no repair action\n' "$check" >&2
          exit 3
          ;;
      esac
    else
      printf 'manual: %s %s — %s\n' "$check" "$path" "$remedy" >&2
    fi
  done <<<"$worklist"
}
if [ "$FIX" = true ]; then
  PHASE=repair
  apply_fixes
  PHASE=scan
fi

# The exit verdict. A bare run exits 1 on any finding; --fix exits 0 when it repaired
# everything it found and 1 only when findings remain that it cannot safely repair
# (fixable == false records — the repairs above never remove those, and each was printed
# with its named manual remedy) or when a --dry-run plan refused a repair the real --fix
# would fail (S5's not-a-regular-file guard, #439): a plan that cannot execute must not
# read as the false 0 of "everything is repairable". Both verdicts come from the same
# accumulator the renderers read, never from a post-fix re-scan.
VERDICT=1
if [ "$FIX" = true ]; then
  if [ "$unfixable" -eq 0 ] && [ "$DRY_REFUSED" -eq 0 ]; then VERDICT=0; fi
else
  if [ "$total" -eq 0 ]; then VERDICT=0; fi
fi

# plural <n> <singular> <plural>: the word matching <n> (English count agreement).
plural() {
  if [ "$1" = "1" ]; then printf '%s' "$2"; else printf '%s' "$3"; fi
}

# digest: the trailing summary line, computed from the accumulator alone.
digest() {
  printf '%d %s, %d %s, %d info — %d fixable with --fix\n' \
    "$errors" "$(plural "$errors" error errors)" \
    "$warnings" "$(plural "$warnings" warning warnings)" \
    "$info" "$fixable"
}

# store_count <store>: item count for the clean line (session logs, run directories, ledger
# files, failure logs).
store_count() {
  local store="$1" dir f n=0
  dir="$(store_dir "$store")"
  if [ ! -d "$dir" ]; then
    printf '0'
    return
  fi
  if [ "$store" = "runs" ]; then
    for f in "$dir"/*/; do
      if [ -d "$f" ]; then n=$((n + 1)); fi
    done
  else
    for f in "$dir"/*.jsonl; do
      if [ -f "$f" ]; then n=$((n + 1)); fi
    done
  fi
  printf '%d' "$n"
}

# clean_line: the distinctive project-owned clean output, with per-store item counts.
clean_line() {
  local store count label parts=() part joined=""
  for store in "${ALL_STORES[@]}"; do
    if [ -z "${WANT_STORES[$store]:-}" ]; then continue; fi
    count="$(store_count "$store")"
    case "$store" in
      sessions) label="$(plural "$count" session sessions)" ;;
      runs) label="$(plural "$count" run runs)" ;;
      ledgers) label="$(plural "$count" ledger ledgers)" ;;
      failures) label="$(plural "$count" "failure log" "failure logs")" ;;
    esac
    parts+=("$count $label")
  done
  # "${parts[*]}" joins on the first IFS character only, so a ", " separator is built
  # explicitly rather than smuggled through IFS.
  for part in "${parts[@]}"; do
    if [ -n "$joined" ]; then joined="$joined, "; fi
    joined="$joined$part"
  done
  printf 'no problems found (%s)\n' "$joined"
}

if [ "$JSON" = true ]; then
  # JSON output is the findings array itself — the composability point for jq pipelines —
  # and nothing else. [] when clean. The repair/manual plan stays on stderr.
  jq -s . "$FINDINGS_FILE"
  exit "$VERDICT"
fi

# policy.json and ci.json stay shai-doctor's to validate — point there instead of
# duplicating either verdict. Human-facing table mode only: --json and --summary keep
# both streams to their single contract line.
if [ "$SUMMARY" != true ]; then
  printf 'note: policy.json and ci.json are validated by shai-doctor, not shai-fsck\n' >&2
fi

if [ "$total" -eq 0 ]; then
  clean_line
  exit 0
fi

if [ "$SUMMARY" = true ]; then
  digest
  exit "$VERDICT"
fi

# Table mode: one row per finding on stdout — honest and row-countable — with the digest
# trailing on stderr, so assert_row_count sees exactly header + findings.
printf '%-8s  %-5s  %-8s  %-29s  %s\n' "SEVERITY" "CHECK" "STORE" "TARGET" "SUMMARY"
mapfile -t rows < <(jq -r '[.severity, .check, .store, .target, .summary] | @tsv' "$FINDINGS_FILE")
for row in "${rows[@]}"; do
  IFS=$'\t' read -r sev check store target summary <<<"$row" || true
  printf '%-8s  %-5s  %-8s  %-29s  %s\n' "$sev" "$check" "$store" "$target" "$summary"
done
digest >&2
exit "$VERDICT"
