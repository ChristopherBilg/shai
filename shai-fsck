#!/bin/bash
# shai-fsck — report $SHAI_HOME store inconsistencies as normalized findings
# Usage: shai-fsck [--store STORE] [--check ID] [--after DATE] [--before DATE]
#        [--fix] [--dry-run] [--summary] [--json]
# Reads: $SHAI_HOME/sessions/, $SHAI_HOME/runs/, $SHAI_HOME/ledgers/, $SHAI_HOME/failures/
# Writes: findings table to stdout (digest to stderr), the findings array to stdout with
#         --json, or the digest alone to stdout with --summary; never modifies the store
# Exit: 0 clean (no findings); 1 problems found; 2 usage error; 3 operational failure
#       (the scan could not complete: jq missing, $SHAI_HOME absent/unreadable, or an
#       unexpected command failure). 3 vs 1 is the point: a timer or CI job can tell
#       "your state directory is dirty" apart from "the check never ran".
set -euo pipefail

# fsck_failed: ERR-trap handler — any unexpected command failure means the scan did not
# complete, which must read as 3 (operational), never 1 ("problems found").
# shellcheck disable=SC2317  # invoked by the ERR trap below, not visible to static analysis
fsck_failed() {
  local rc=$?
  printf 'shai-fsck: scan failed (exit %s) — the report may be incomplete\n' "$rc" >&2
  exit 3
}
trap fsck_failed ERR

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# R6 must classify an uncommitted run exactly as shai-retry --run would, so the verdict
# comes from lib/replay.sh's classify_replay (issue #386) — sourced, never reimplemented.
# The lib runs `set -uo pipefail` when sourced, so it never tightens this script's options.
# shellcheck source=lib/replay.sh
source "$DIR/lib/replay.sh"

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
SESSIONS_DIR="$STATE_DIR/sessions"
RUNS_DIR="$STATE_DIR/runs"
LEDGERS_DIR="$STATE_DIR/ledgers"
FAILURES_DIR="$STATE_DIR/failures"

# Check catalog: id -> the store its scan reads. S4 (the #389 findings-spine check) and
# the R1-R7 run-store family (#391) are shipped; the session/ledger/failure check
# families append their ids here in later issues.
declare -A CHECK_STORE=([S4]=sessions [R1]=runs [R2]=runs [R3]=runs [R4]=runs [R5]=runs [R6]=runs [R7]=runs)
# Known ids in scan order (associative-array keys alone have no defined order).
KNOWN_CHECKS=(S4 R1 R2 R3 R4 R5 R6 R7)
ALL_STORES=(sessions runs ledgers failures)

STORES=() CHECKS=()
AFTER="" BEFORE=""
FIX=false DRY_RUN=false SUMMARY=false JSON=false

# known_check <id>: 0 when the id is in the check catalog.
known_check() {
  local id="$1" c
  for c in "${KNOWN_CHECKS[@]}"; do
    [ "$c" = "$id" ] && return 0
  done
  return 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --store)
      shift
      case "${1:-}" in
        sessions | runs | ledgers | failures) STORES+=("$1") ;;
        "")
          printf 'error: --store requires one of: sessions, runs, ledgers, failures\n' >&2
          exit 2
          ;;
        *)
          printf 'error: unknown store: %s (expected one of: %s)\n' "$1" "${ALL_STORES[*]}" >&2
          exit 2
          ;;
      esac
      ;;
    --check)
      shift
      if [ -z "${1:-}" ]; then
        printf 'error: --check requires a check id\n' >&2
        exit 2
      fi
      if ! known_check "$1"; then
        printf 'error: unknown check id: %s (known: %s)\n' "$1" "${KNOWN_CHECKS[*]}" >&2
        exit 2
      fi
      CHECKS+=("$1")
      ;;
    --after)
      shift
      AFTER="${1:-}"
      if [ -z "$AFTER" ]; then
        printf 'error: --after requires a date (YYYY-MM-DD)\n' >&2
        exit 2
      fi
      if ! [[ "$AFTER" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        printf 'error: --after date must be YYYY-MM-DD\n' >&2
        exit 2
      fi
      ;;
    --before)
      shift
      BEFORE="${1:-}"
      if [ -z "$BEFORE" ]; then
        printf 'error: --before requires a date (YYYY-MM-DD)\n' >&2
        exit 2
      fi
      if ! [[ "$BEFORE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        printf 'error: --before date must be YYYY-MM-DD\n' >&2
        exit 2
      fi
      ;;
    --fix) FIX=true ;;
    --dry-run) DRY_RUN=true ;;
    --summary) SUMMARY=true ;;
    --json) JSON=true ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

# The default run is already read-only, so --dry-run without --fix is a flag that would do
# nothing — refuse it rather than silently accept it.
if [ "$DRY_RUN" = true ] && [ "$FIX" != true ]; then
  printf 'error: --dry-run requires --fix\n' >&2
  exit 2
fi
# --summary is the table renderer's digest-only mode; --json is the machine renderer. Both
# at once would silently ignore one of them.
if [ "$SUMMARY" = true ] && [ "$JSON" = true ]; then
  printf 'error: --summary cannot be combined with --json\n' >&2
  exit 2
fi
# --fix is parsed and validated here; the fix behaviour lands in a later issue. Say so
# instead of silently accepting a flag that does nothing.
if [ "$FIX" = true ]; then
  printf 'warning: --fix is parsed but not implemented yet (a later issue); no files were modified\n' >&2
fi

# Operational guards — these are the exit 3 conditions, checked before any scan so a
# failed prerequisite can never masquerade as a clean scan.
if ! command -v jq >/dev/null 2>&1; then
  printf 'error: jq is required but was not found on PATH\n' >&2
  exit 3
fi
if [ ! -e "$STATE_DIR" ]; then
  printf 'error: SHAI_HOME does not exist: %s\n' "$STATE_DIR" >&2
  exit 3
fi
if [ ! -d "$STATE_DIR" ]; then
  printf 'error: SHAI_HOME is not a directory: %s\n' "$STATE_DIR" >&2
  exit 3
fi
if [ ! -r "$STATE_DIR" ] || [ ! -x "$STATE_DIR" ]; then
  printf 'error: SHAI_HOME is not readable: %s\n' "$STATE_DIR" >&2
  exit 3
fi

# Findings accumulator: checks append normalized records here and nothing downstream knows
# how a check reached its conclusion. The table renderer, the --json renderer, the digest,
# and (in a later issue) --fix all read the same file, so the summary line
# "N problems found, M fixable with --fix" is true by construction.
FINDINGS_FILE="$(mktemp)"
trap 'rm -f "$FINDINGS_FILE"' EXIT

# finding <check> <severity> <store> <target> <path> <summary> <fixable> <remedy>: append one
# normalized finding carrying the eight-key contract to the accumulator.
finding() {
  jq -nc \
    --arg check "$1" --arg severity "$2" --arg store "$3" --arg target "$4" \
    --arg path "$5" --arg summary "$6" --argjson fixable "$7" --arg remedy "$8" \
    '{check:$check, severity:$severity, store:$store, target:$target, path:$path,
      summary:$summary, fixable:$fixable, remedy:$remedy}' >>"$FINDINGS_FILE"
}

# item_date <id>: "YYYY-MM-DD" embedded in a real-shaped <prefix>_YYYYMMDDTHHMMSS_<hex> id,
# or "" when the id carries no parseable timestamp.
item_date() {
  local id="$1" ts
  if [[ "$id" =~ ^[^_]+_[0-9]{8}T[0-9]{6}_[0-9a-f]{8}$ ]]; then
    ts="${id#*_}"
    printf '%s-%s-%s' "${ts:0:4}" "${ts:4:2}" "${ts:6:2}"
  fi
}

# in_window <date>: inclusive [--after, --before] on "YYYY-MM-DD". An undated item ("") is
# in-window only when no bound is active, matching shai-events' documented semantics: items
# whose embedded date cannot be read are dropped when a window is set.
in_window() {
  local date="$1"
  if [ -z "$date" ]; then
    if [ -n "$AFTER" ] || [ -n "$BEFORE" ]; then return 1; fi
    return 0
  fi
  if [ -n "$AFTER" ] && [[ "$date" < "$AFTER" ]]; then return 1; fi
  if [ -n "$BEFORE" ] && [[ "$date" > "$BEFORE" ]]; then return 1; fi
}

# store_dir <store>: the on-disk directory backing one of the four store names.
store_dir() {
  case "$1" in
    sessions) printf '%s' "$SESSIONS_DIR" ;;
    runs) printf '%s' "$RUNS_DIR" ;;
    ledgers) printf '%s' "$LEDGERS_DIR" ;;
    failures) printf '%s' "$FAILURES_DIR" ;;
  esac
}

# S4 — no orphan .latest.json: a sessions/<id>.latest.json with no sibling
# sessions/<id>.jsonl. Severity error, fixable by deleting the orphan. Pure filesystem —
# no jq, no event parsing — which is exactly why it proves the spine end to end.
ck_S4() {
  local f id date log
  for f in "$SESSIONS_DIR"/*.latest.json; do
    if [ ! -f "$f" ]; then continue; fi
    id="$(basename "$f" .latest.json)"
    # The date window short-circuits at the filename level, before any file is opened.
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$SESSIONS_DIR/$id.jsonl"
    if [ ! -e "$log" ]; then
      finding S4 error sessions "$id" "$f" "orphan latest.json (no session log)" true delete
    fi
  done
}

# --- run-store checks (R1-R7, issue #391) ------------------------------------------
# R1/R2/R3/R5 share exactly one jq pass per events.jsonl: run_summary caches a single
# jq -s summary (line count, non-object lines, meta.run_id values, span ids, span
# parents) that each check then filters in memory, so no check re-parses a store file.
# R6 is the mandated exception — it calls lib/replay.sh's classify_replay, whose own
# reads of the run and session logs are #386's contract, not part of this scan's budget.

# run_summary <log>: the cached one-pass jq summary of a run log. Prints a JSON object
# with keys count, bad_lines (1-based lines that are not JSON objects), run_ids
# ({line, rid} per line carrying a meta.run_id), spans (unique meta.span_id strings),
# and span_parents ({line, span, parent} per line carrying a meta.span_id); prints
# nothing when the file does not parse as JSON (the caller treats that as
# "unparseable" and lets R1 own the report).
declare -A RUN_SUMMARIES=()
RUN_SUMMARY_PROGRAM='{count: length,
  bad_lines: [to_entries[] | select((.value | type) != "object") | (.key + 1)],
  run_ids: [to_entries[] | select((.value | type) == "object")
            | select((.value.meta.run_id? // null) != null)
            | {line: (.key + 1), rid: .value.meta.run_id}],
  spans: [.[] | select(type == "object") | .meta.span_id? // empty
          | select(type == "string")] | unique,
  span_parents: [to_entries[] | select((.value | type) == "object")
                 | select((.value.meta.span_id? // null) != null)
                 | {line: (.key + 1), span: .value.meta.span_id,
                    parent: (.value.meta.parent_span_id? // null)}]}'
run_summary() {
  local log="$1"
  if [ -z "${RUN_SUMMARIES[$log]+x}" ]; then
    RUN_SUMMARIES[$log]="$(jq -c -s "$RUN_SUMMARY_PROGRAM" "$log" 2>/dev/null)" || RUN_SUMMARIES[$log]=""
  fi
  printf '%s' "${RUN_SUMMARIES[$log]}"
}

# run_dir_empty <dir>: 0 when <dir> has no entries at all — R1's narrow fixable case.
# A directory that still holds any file (span dumps, a partial log) is the only trace
# of an API call and gets a manual remedy instead. dotglob counts hidden files too.
run_dir_empty() {
  local entries=()
  shopt -s nullglob dotglob
  entries=("$1"/*)
  shopt -u nullglob dotglob
  [ "${#entries[@]}" -eq 0 ]
}

# R1 — runs/<id>/events.jsonl must exist, be non-empty, and parse line-by-line as JSON
# objects. Severity error. The only fixable shape is a wholly empty run directory; a
# directory holding anything else is evidence a human should look at, so those shapes
# get manual remedies.
ck_R1() {
  local dir id date log summary n bad line
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then
      if run_dir_empty "$dir"; then
        finding R1 error runs "$id" "$dir" "run directory is empty (no events.jsonl)" true delete
      else
        finding R1 error runs "$id" "$dir" "run directory has files but no events.jsonl" \
          false "manual: inspect the files, then delete the run directory"
      fi
      continue
    fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then
      finding R1 error runs "$id" "$log" "events.jsonl contains a line that does not parse as JSON" \
        false "manual: repair or delete the run log"
      continue
    fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then
      finding R1 error runs "$id" "$log" "events.jsonl is empty" \
        false "manual: inspect the run directory, then delete it"
      continue
    fi
    bad="$(printf '%s' "$summary" | jq -c '.bad_lines')"
    if [ "$bad" != "[]" ]; then
      while IFS= read -r line; do
        finding R1 error runs "$id" "$log" "events.jsonl line $line is not a JSON object" \
          false "manual: repair or delete the run log"
      done < <(printf '%s' "$bad" | jq -r '.[]')
    fi
  done
}

# R2 — every meta.run_id in a run log must equal the directory name. Severity error,
# not fixable: which side is wrong (the directory name or the log) is a human judgment
# call. Only lines carrying a meta.run_id are checked; unstamped lines are not
# violations. Runs whose log R1 already reported (missing/empty/unparseable) are
# skipped rather than double-counted.
ck_R2() {
  local dir id date log summary n line rid
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then continue; fi
    while IFS=$'\t' read -r line rid; do
      finding R2 error runs "$id" "$log" \
        "line $line: meta.run_id $rid does not match the run directory" \
        false "manual: rename the run directory or correct the run log"
    done < <(printf '%s' "$summary" | jq -r --arg id "$id" \
      '.run_ids[] | select(.rid != $id) | "\(.line)\t\(.rid)"')
  done
}

# R3 — span ids must form span_1..span_N with no gaps, and meta.parent_span_id must
# form a linear chain (span_k's parent is span_{k-1}; span_1's parent is null).
# Severity warn, not fixable. span_0 is exempt: a hand-run shai-eval with SHAI_RUN_ID
# set but no SHAI_SPAN_ID dumps to span_0-request.json, and real spans start at
# span_1, so span_0 is never a gap and never a chain member. The chain is checked
# only when the sequence is contiguous — a gapped sequence has no linear chain by
# definition, and reporting both for one corruption would double-count it. Span ids
# outside the span_N shape are reported individually: a corrupted id like span_1x is
# otherwise invisible to both the gap and the chain check.
ck_R3() {
  local dir id date log summary n max missing k parent expected s
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then continue; fi
    while IFS= read -r s; do
      finding R3 warn runs "$id" "$log" \
        "span id $s is not in span_N form (span_1..span_N, or span_0 for hand runs)" \
        false "manual: repair the run log"
    done < <(printf '%s' "$summary" | jq -r '.spans[] | select(test("^span_[0-9]+$") | not)')
    max="$(printf '%s' "$summary" | jq -r '[.spans[]
      | select(test("^span_[0-9]+$")) | sub("^span_"; "") | tonumber
      | select(. > 0)] | if length == 0 then 0 else max end')"
    if [ "$max" -eq 0 ]; then continue; fi
    missing="$(printf '%s' "$summary" | jq -c --argjson max "$max" '
      [.spans[] | select(test("^span_[0-9]+$")) | sub("^span_"; "") | tonumber
       | select(. > 0)] as $have | [range(1; $max + 1)] - $have')"
    if [ "$missing" != "[]" ]; then
      while IFS= read -r k; do
        finding R3 warn runs "$id" "$log" "span_$k missing (gaps in the span sequence)" \
          false "manual: repair the run log"
      done < <(printf '%s' "$missing" | jq -r '.[]')
      continue
    fi
    while IFS=$'\t' read -r k parent expected; do
      finding R3 warn runs "$id" "$log" \
        "span_$k parent_span_id is $parent (expected $expected)" \
        false "manual: repair the run log"
    done < <(printf '%s' "$summary" | jq -r '
      [.span_parents[]
       | select(.span | type == "string")
       | select(.span | test("^span_[0-9]+$"))
       | .n = (.span | sub("^span_"; "") | tonumber)
       | select(.n > 0)
       | .expected = (if .n == 1 then null else "span_" + ((.n - 1) | tostring) end)
       | select(.parent != .expected)
       | "\(.n)\t\(.parent)\t\(.expected)"] | .[]')
  done
}

# R4 — every <span>-request.json / <span>-response.json dump must parse as JSON.
# Severity warn, deliberately not fixable: a malformed dump is the only record of a
# failed API call, so deleting it must stay a human decision. One jq validation pass
# per dump file, and no other check reads dumps.
ck_R4() {
  local dir id date dump fname dumps=()
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    shopt -s nullglob
    dumps=("$dir"/span_*-request.json "$dir"/span_*-response.json)
    shopt -u nullglob
    for dump in "${dumps[@]+"${dumps[@]}"}"; do
      if ! jq -e . "$dump" >/dev/null 2>&1; then
        fname="$(basename "$dump")"
        finding R4 warn runs "$id" "$dump" "$fname does not parse as JSON" \
          false "manual: inspect the dump, then delete or repair it"
      fi
    done
  done
}

# R5 — a span dump must have a matching event in its run log; a dump whose span has no
# event is an orphan (the defect the live-audit found: span_9-request.json with events
# only through span_8). Severity warn, fixable by deleting the dump. span_0 is exempt
# (CLAUDE.md: a hand-run shai-eval without SHAI_SPAN_ID dumps to span_0-request.json —
# legitimate, never an orphan). R5 only classifies dumps when the run log is present,
# non-empty, and parseable: without an authoritative span set orphanhood is unprovable,
# and those directories are already R1's report.
ck_R5() {
  local dir id date log summary dump fname span found s spans=() dumps=()
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    if [ "$(printf '%s' "$summary" | jq -r '.count')" -eq 0 ]; then continue; fi
    mapfile -t spans < <(printf '%s' "$summary" | jq -r '.spans[]')
    shopt -s nullglob
    dumps=("$dir"/span_*-request.json "$dir"/span_*-response.json)
    shopt -u nullglob
    for dump in "${dumps[@]+"${dumps[@]}"}"; do
      fname="$(basename "$dump")"
      span="${fname%-request.json}"
      span="${span%-response.json}"
      if [ "$span" = "span_0" ]; then continue; fi
      found=""
      for s in "${spans[@]+"${spans[@]}"}"; do
        if [ "$s" = "$span" ]; then
          found=1
          break
        fi
      done
      if [ -z "$found" ]; then
        finding R5 warn runs "$id" "$dump" "$fname has no matching event in the run log" true delete
      fi
    done
  done
}

# R6 — a run's events must appear in some session log; buffer-then-commit means a run
# directory whose events never reached a session is an uncommitted run. Severity warn.
# The verdict comes from classify_replay — the exact five preconditions shai-retry
# --run applies — so fsck can never call a run "resumable" that shai-retry would refuse
# (issue #386's contract, including the meta.retry_of half of the committed test).
# A resumable run is never fixable; its remedy is the literal resume command, and the
# summary carries it too so every renderer lets the user act on it directly. Only dead
# runs (no user message, or no session id) are fixable: their events are unreplayable,
# so deletion loses nothing recoverable. classify_replay is only called on present,
# non-empty, parseable run logs — R1 owns the other shapes, and the classifier's own
# jq would otherwise fail on a malformed log.
ck_R6() {
  local dir id date log summary n
  for dir in "$RUNS_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    id="$(basename "$dir")"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    log="$dir/events.jsonl"
    if [ ! -f "$log" ]; then continue; fi
    summary="$(run_summary "$log")"
    if [ -z "$summary" ]; then continue; fi
    n="$(printf '%s' "$summary" | jq -r '.count')"
    if [ "$n" -eq 0 ]; then continue; fi
    classify_replay "$id"
    case "$REPLAY_VERDICT" in
      committed) ;;
      replayable)
        finding R6 warn runs "$id" "$log" \
          "uncommitted run (resumable) — shai-retry --run $id" false "shai-retry --run $id"
        ;;
      no-user-message)
        finding R6 warn runs "$id" "$log" "uncommitted run (dead: no user message)" true delete
        ;;
      no-session-id)
        finding R6 warn runs "$id" "$log" "uncommitted run (dead: no session id)" true delete
        ;;
      unsafe-session-id)
        finding R6 warn runs "$id" "$log" \
          "uncommitted run (session id in the run log is unsafe: $REPLAY_SESSION)" \
          false "manual: repair the run log"
        ;;
      unsafe-run-id | no-log) ;; # unreachable behind the gates above; fail-closed skip
      *)
        # classify_replay only emits the verdicts above; fail closed rather than
        # silently misclassifying a run.
        printf 'error: cannot classify run log: %s\n' "$log" >&2
        exit 3
        ;;
    esac
  done
}

# R7 — every meta.run_id referenced by a session event must have a run directory on
# disk. Severity info, never fixable: shai-prune --runs legitimately removes run
# directories while their events remain committed in the session log, and shai-trace
# already handles that ("run directory not found; using session log"). Reported so a
# user understands why shai-trace warns, not because anything is broken. Run ids
# containing / or .. are skipped — they could never name a real run directory, and
# probing them would re-derive shai-retry's path guard as a bare existence check.
# ck_R7 also fires on the --store runs path (the dispatch arm and the missing-runs/
# exception above), where the scan loop's sessions-store readability guard does not
# apply — the check carries its own exit-3 guards so an unreadable sessions dir or an
# unparseable session log aborts the scan instead of reading as a false-clean report.
ck_R7() {
  local f id date refs rid
  # A missing sessions dir is clean by definition (no session logs, no references);
  # a present-but-unreadable one must abort — mirror the per-store guard above.
  if [ -d "$SESSIONS_DIR" ] && { [ ! -r "$SESSIONS_DIR" ] || [ ! -x "$SESSIONS_DIR" ]; }; then
    printf 'error: cannot scan %s (not readable) — scan aborted\n' "$SESSIONS_DIR" >&2
    exit 3
  fi
  for f in "$SESSIONS_DIR"/*.jsonl; do
    if [ ! -f "$f" ]; then continue; fi
    id="$(basename "$f" .jsonl)"
    date="$(item_date "$id")"
    if ! in_window "$date"; then continue; fi
    if ! refs="$(jq -c -s '[.[] | select(type == "object") | .meta.run_id? // empty
                           | select(type == "string") | select(length > 0)
                           | select(test("^[^/]+$")) | select(contains("..") | not)]
                           | unique' "$f" 2>/dev/null)"; then
      printf 'error: cannot scan %s (unreadable or unparseable) — scan aborted\n' "$f" >&2
      exit 3
    fi
    while IFS= read -r rid; do
      if [ ! -d "$RUNS_DIR/$rid" ]; then
        finding R7 info runs "$rid" "$RUNS_DIR/$rid" \
          "run directory missing (events remain in the session log)" false ""
      fi
    done < <(printf '%s' "$refs" | jq -r '.[]')
  done
}

# scan: run every selected check against every selected store. --store and --check are
# repeatable filters; a check that belongs to an unselected store simply never fires.
declare -A WANT_STORES=()
if [ "${#STORES[@]}" -eq 0 ]; then
  for s in "${ALL_STORES[@]}"; do WANT_STORES["$s"]=1; done
else
  for s in "${STORES[@]}"; do WANT_STORES["$s"]=1; done
fi
declare -A WANT_CHECKS=()
if [ "${#CHECKS[@]}" -eq 0 ]; then
  for c in "${KNOWN_CHECKS[@]}"; do WANT_CHECKS["$c"]=1; done
else
  for c in "${CHECKS[@]}"; do WANT_CHECKS["$c"]=1; done
fi

for store in "${ALL_STORES[@]}"; do
  if [ -z "${WANT_STORES[$store]:-}" ]; then continue; fi
  dir="$(store_dir "$store")"
  # A store directory that was never created is an empty store, not a failure — with one
  # exception: R7's subject is run directories that are NOT on disk (it reads session
  # logs, not runs/), so a missing runs/ is exactly the state it exists to report. Run
  # it before the per-check loop rather than letting the empty-store skip swallow it.
  if [ ! -d "$dir" ]; then
    if [ "$store" = "runs" ] && [ -n "${WANT_CHECKS[R7]:-}" ]; then ck_R7; fi
    continue
  fi
  if [ ! -r "$dir" ] || [ ! -x "$dir" ]; then
    printf 'error: cannot scan %s (not readable) — scan aborted\n' "$dir" >&2
    exit 3
  fi
  for check in "${KNOWN_CHECKS[@]}"; do
    if [ -z "${WANT_CHECKS[$check]:-}" ]; then continue; fi
    if [ "${CHECK_STORE[$check]}" != "$store" ]; then continue; fi
    # Explicit dispatch, not a dynamic "$check" invocation: shellcheck can prove these
    # functions are reached, and the check families added in later issues add case arms
    # here next to their catalog entries above.
    case "$check" in
      S4) ck_S4 ;;
      R1) ck_R1 ;;
      R2) ck_R2 ;;
      R3) ck_R3 ;;
      R4) ck_R4 ;;
      R5) ck_R5 ;;
      R6) ck_R6 ;;
      R7) ck_R7 ;;
    esac
  done
done

# One jq pass over the accumulator (never over store files) computes every downstream
# number: the digest, the exit verdict, and — later — the --fix worklist.
STATS="$(jq -s '{
  errors: ([.[] | select(.severity == "error")] | length),
  warnings: ([.[] | select(.severity == "warn")] | length),
  info: ([.[] | select(.severity == "info")] | length),
  fixable: ([.[] | select(.fixable == true)] | length),
  total: length
}' "$FINDINGS_FILE")"
total="$(printf '%s' "$STATS" | jq -r '.total')"
errors="$(printf '%s' "$STATS" | jq -r '.errors')"
warnings="$(printf '%s' "$STATS" | jq -r '.warnings')"
info="$(printf '%s' "$STATS" | jq -r '.info')"
fixable="$(printf '%s' "$STATS" | jq -r '.fixable')"

# plural <n> <singular> <plural>: the word matching <n> (English count agreement).
plural() {
  if [ "$1" = "1" ]; then printf '%s' "$2"; else printf '%s' "$3"; fi
}

# digest: the trailing summary line, computed from the accumulator alone.
digest() {
  printf '%d %s, %d %s, %d info — %d fixable with --fix\n' \
    "$errors" "$(plural "$errors" error errors)" \
    "$warnings" "$(plural "$warnings" warning warnings)" \
    "$info" "$fixable"
}

# store_count <store>: item count for the clean line (session logs, run directories, ledger
# files, failure logs).
store_count() {
  local store="$1" dir f n=0
  dir="$(store_dir "$store")"
  if [ ! -d "$dir" ]; then
    printf '0'
    return
  fi
  if [ "$store" = "runs" ]; then
    for f in "$dir"/*/; do
      if [ -d "$f" ]; then n=$((n + 1)); fi
    done
  else
    for f in "$dir"/*.jsonl; do
      if [ -f "$f" ]; then n=$((n + 1)); fi
    done
  fi
  printf '%d' "$n"
}

# clean_line: the distinctive project-owned clean output, with per-store item counts.
clean_line() {
  local store count label parts=() part joined=""
  for store in "${ALL_STORES[@]}"; do
    if [ -z "${WANT_STORES[$store]:-}" ]; then continue; fi
    count="$(store_count "$store")"
    case "$store" in
      sessions) label="$(plural "$count" session sessions)" ;;
      runs) label="$(plural "$count" run runs)" ;;
      ledgers) label="$(plural "$count" ledger ledgers)" ;;
      failures) label="$(plural "$count" "failure log" "failure logs")" ;;
    esac
    parts+=("$count $label")
  done
  # "${parts[*]}" joins on the first IFS character only, so a ", " separator is built
  # explicitly rather than smuggled through IFS.
  for part in "${parts[@]}"; do
    if [ -n "$joined" ]; then joined="$joined, "; fi
    joined="$joined$part"
  done
  printf 'no problems found (%s)\n' "$joined"
}

if [ "$JSON" = true ]; then
  # JSON output is the findings array itself — the composability point for jq pipelines —
  # and nothing else. [] when clean.
  jq -s . "$FINDINGS_FILE"
  if [ "$total" -eq 0 ]; then exit 0; else exit 1; fi
fi

# policy.json and ci.json stay shai-doctor's to validate — point there instead of
# duplicating either verdict. Human-facing table mode only: --json and --summary keep
# both streams to their single contract line.
if [ "$SUMMARY" != true ]; then
  printf 'note: policy.json and ci.json are validated by shai-doctor, not shai-fsck\n' >&2
fi

if [ "$total" -eq 0 ]; then
  clean_line
  exit 0
fi

if [ "$SUMMARY" = true ]; then
  digest
  exit 1
fi

# Table mode: one row per finding on stdout — honest and row-countable — with the digest
# trailing on stderr, so assert_row_count sees exactly header + findings.
printf '%-8s  %-5s  %-8s  %-29s  %s\n' "SEVERITY" "CHECK" "STORE" "TARGET" "SUMMARY"
mapfile -t rows < <(jq -r '[.severity, .check, .store, .target, .summary] | @tsv' "$FINDINGS_FILE")
for row in "${rows[@]}"; do
  IFS=$'\t' read -r sev check store target summary <<<"$row" || true
  printf '%-8s  %-5s  %-8s  %-29s  %s\n' "$sev" "$check" "$store" "$target" "$summary"
done
digest >&2
exit 1
