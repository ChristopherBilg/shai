#!/bin/bash
# shai-prune — manually remove session logs, run directories, workflow ledgers, and failure records
# Usage: shai-prune [--sessions] [--runs] [--ledgers] [--failures] [--dry-run] [--before YYYY-MM-DD]
# Reads: $SHAI_HOME/sessions/*.jsonl, $SHAI_HOME/sessions/*.latest.json, $SHAI_HOME/runs/*/,
#   $SHAI_HOME/ledgers/*.jsonl, and $SHAI_HOME/failures/*.jsonl
# Writes: removes selected files/directories, including ledger and failure files (or lists them with --dry-run)
# Exit: 0 on success or nothing to prune; 1 on invalid arguments
set -euo pipefail

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
SESSIONS_DIR="$STATE_DIR/sessions"
RUNS_DIR="$STATE_DIR/runs"
LEDGERS_DIR="$STATE_DIR/ledgers"
FAILURES_DIR="$STATE_DIR/failures"

do_sessions=false
do_runs=false
do_ledgers=false
do_failures=false
dry_run=false
before=""

while [ $# -gt 0 ]; do
  case "$1" in
    --sessions) do_sessions=true ;;
    --runs) do_runs=true ;;
    --ledgers) do_ledgers=true ;;
    --failures) do_failures=true ;;
    --dry-run) dry_run=true ;;
    --before)
      shift
      before="${1:-}"
      if [ -z "$before" ]; then
        printf 'error: --before requires a YYYY-MM-DD argument\n' >&2
        exit 1
      fi
      ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 1
      ;;
  esac
  shift
done

if ! "$do_sessions" && ! "$do_runs" && ! "$do_ledgers" && ! "$do_failures"; then
  do_sessions=true
  do_runs=true
  do_ledgers=true
  do_failures=true
fi

FIND_BEFORE=()
REF=""
if [ -n "$before" ]; then
  if ! [[ "$before" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    printf 'error: --before requires YYYY-MM-DD format (got "%s")\n' "$before" >&2
    exit 1
  fi
  REF=$(mktemp)
  cleanup_ref() { [ -n "$REF" ] && rm -f "$REF"; }
  trap cleanup_ref EXIT
  touch -t "$(printf '%s' "$before" | tr -d '-')0000" "$REF"
  FIND_BEFORE=(! -newer "$REF")
fi

TARGETS=()
FILTER_TARGETS=()

if "$do_sessions" && [ -d "$SESSIONS_DIR" ]; then
  while IFS= read -r -d '' f; do
    TARGETS+=("$f")
  done < <(find "$SESSIONS_DIR" -maxdepth 1 -type f \( -name '*.jsonl' -o -name '*.latest.json' \) "${FIND_BEFORE[@]}" -print0 2>/dev/null)
fi

if "$do_runs" && [ -d "$RUNS_DIR" ]; then
  while IFS= read -r -d '' d; do
    TARGETS+=("$d")
  done < <(find "$RUNS_DIR" -mindepth 1 -maxdepth 1 -type d "${FIND_BEFORE[@]}" -print0 2>/dev/null)
fi

if "$do_ledgers" && [ -d "$LEDGERS_DIR" ]; then
  while IFS= read -r -d '' f; do
    TARGETS+=("$f")
  done < <(find "$LEDGERS_DIR" -maxdepth 1 -type f -name '*.jsonl' "${FIND_BEFORE[@]}" -print0 2>/dev/null)
fi

if "$do_failures" && [ -d "$FAILURES_DIR" ]; then
  if [ -n "$before" ]; then
    # Failure files are pruned by record content, not mtime: --before drops the lines
    # whose ts predates the cutoff, and files left empty (or already empty) are deleted.
    # Records without a string ts cannot be dated and are kept. A file jq cannot parse is
    # left untouched (fail closed: never drop unreadable records).
    while IFS= read -r -d '' f; do
      if [ ! -s "$f" ]; then
        # already empty: nothing to filter, the removal loop deletes it
        FILTER_TARGETS+=("$f")
        continue
      fi
      if ! old="$(jq -r -s --arg b "$before" '[.[] | select((.ts | type) == "string" and .ts < $b)] | length' "$f" 2>/dev/null)"; then
        # fail closed: an unparseable file (or a missing jq) must not be dropped
        # silently — warn here so it is never lost without a trace, and keep it out
        # of FILTER_TARGETS so it is left untouched (not listed, not counted)
        printf 'warning: cannot parse %s, leaving it untouched\n' "$f" >&2
        continue
      fi
      if [ "$old" -gt 0 ]; then
        FILTER_TARGETS+=("$f")
      fi
    done < <(find "$FAILURES_DIR" -maxdepth 1 -type f -name '*.jsonl' -print0 2>/dev/null)
  else
    while IFS= read -r -d '' f; do
      TARGETS+=("$f")
    done < <(find "$FAILURES_DIR" -maxdepth 1 -type f -name '*.jsonl' -print0 2>/dev/null)
  fi
fi

TOTAL=$((${#TARGETS[@]} + ${#FILTER_TARGETS[@]}))
if [ "$TOTAL" -eq 0 ]; then
  printf 'nothing to prune\n'
  exit 0
fi

for t in "${TARGETS[@]}" "${FILTER_TARGETS[@]}"; do
  printf '%s\n' "$t"
done

if "$dry_run"; then
  printf '\n%d item(s) would be removed (dry run)\n' "$TOTAL"
  exit 0
fi

if [ -t 0 ]; then
  printf '\nremove %d item(s)? [y/N] ' "$TOTAL" >/dev/tty
  read -r confirm </dev/tty
  case "$confirm" in
    y | Y | yes | YES) ;;
    *)
      printf 'aborted\n'
      exit 0
      ;;
  esac
fi

for t in "${TARGETS[@]}"; do
  rm -rf "$t"
done
for t in "${FILTER_TARGETS[@]}"; do
  if [ ! -s "$t" ]; then
    rm -f "$t"
    continue
  fi
  # mktemp creates the temp file 0600 and mv carries its mode onto the target, so copy
  # the original mode before the rename; creating the temp in the target's directory
  # keeps the rename atomic even when $SHAI_HOME is on a different mount than /tmp.
  tmp="$(mktemp "$(dirname "$t")/.prune.XXXXXX")"
  mode="$(stat -c '%a' "$t" 2>/dev/null || true)"
  if [ -n "$mode" ]; then
    chmod "$mode" "$tmp" 2>/dev/null || true
  fi
  if jq -c --arg b "$before" 'select((.ts | type) != "string" or .ts >= $b)' "$t" >"$tmp" 2>/dev/null; then
    if [ -s "$tmp" ]; then
      mv "$tmp" "$t"
    else
      rm -f "$tmp"
      rm -f "$t" # empty after pruning → delete
    fi
  else
    rm -f "$tmp"
    printf 'warning: cannot parse %s, leaving it untouched\n' "$t" >&2
  fi
done
printf 'removed %d item(s)\n' "$TOTAL"
