#!/bin/bash
# shai-doctor — validate environment prerequisites for shai
# Usage: shai-doctor
# Reads: $PATH (CLI tool availability), environment variables, tool-declared config files,
#        $SHAI_HOME/policy.json and $SHAI_POLICY_OVERLAY (policy file validation)
# Writes: diagnostic report to stderr
# Exit: 0 if all core checks pass; 1 if any core check fails
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# shellcheck source=lib/workflow.sh
source "$DIR/lib/workflow.sh"

ERRORS=0
WARNINGS=0

CORE_TOOLS=(jq curl date od mktemp tr)
COND_TOOLS=(systemctl journalctl timeout)

check_tool() {
  local name="$1" level="$2"
  if command -v "$name" >/dev/null 2>&1; then
    printf '  [OK]   %s\n' "$name" >&2
  elif [ "$level" = "core" ]; then
    printf '  [FAIL] %s\n' "$name" >&2
    ERRORS=$((ERRORS + 1))
  else
    printf '  [WARN] %s\n' "$name" >&2
    WARNINGS=$((WARNINGS + 1))
  fi
}

check_env() {
  local name="$1" level="$2"
  local val="${!name:-}"
  if [ -n "$val" ]; then
    printf '  [OK]   %s\n' "$name" >&2
  elif [ "$level" = "core" ]; then
    printf '  [FAIL] %s\n' "$name" >&2
    ERRORS=$((ERRORS + 1))
  else
    printf '  [WARN] %s\n' "$name" >&2
    WARNINGS=$((WARNINGS + 1))
  fi
}

check_config() {
  local name="$1" default="$2" unset_label="${3:-}"
  local val="${!name:-}"
  printf '  [OK]   %s\n' "$name" >&2
  if [ -n "$val" ]; then
    printf '         %s\n' "$val" >&2
  elif [ -n "$default" ]; then
    printf '         %s (default)\n' "$default" >&2
  elif [ -n "$unset_label" ]; then
    printf '         (%s)\n' "$unset_label" >&2
  else
    printf '         (unset)\n' >&2
  fi
}

# expand_path <declared>: expand the $SHAI_HOME / $HOME / ~ prefixes a tool.json may use in a
# declared path. Only those three are substituted — tool.json is data, never eval'd.
expand_path() {
  local p="$1"
  p="${p//\$\{SHAI_HOME\}/${SHAI_HOME:-$HOME/.shai}}"
  p="${p//\$SHAI_HOME/${SHAI_HOME:-$HOME/.shai}}"
  p="${p//\$\{HOME\}/$HOME}"
  p="${p//\$HOME/$HOME}"
  p="${p/#\~/$HOME}"
  printf '%s' "$p"
}

# check_config_file <declared-path> <level> [format] [keys-of] [hint]
# A missing or malformed file is an error at level 'core' and a warning at 'conditional' —
# the same degraded-but-usable treatment the conditional env vars get.
# 'format' defaults to json here — the single place that default lives, matching
# tests/validate-tool-schema.sh, which accepts only a missing or "json" format. Omitting it in
# tool.json therefore still gets the parse check and the 'keys' listing, never a silent skip.
# The status line ends with the *declared* path (with $SHAI_HOME still unexpanded) so
# tests/doctor-sync.sh can match it against tool.json without re-expanding anything;
# the resolved path and any detail go on an indented continuation line.
check_config_file() {
  local declared="$1" level="$2" format="${3:-json}" keys_of="${4:-}" hint="${5:-}"
  local path detail="" marker keys
  path="$(expand_path "$declared")"
  if [ ! -f "$path" ]; then
    marker=bad
    detail="not found: $path"
    [ -n "$hint" ] && detail="$detail — $hint"
  elif [ "$format" = "json" ] && ! jq empty "$path" >/dev/null 2>&1; then
    marker=bad
    detail="not valid JSON: $path"
  else
    marker=ok
    detail="$path"
    if [ -n "$keys_of" ] && [ "$format" = "json" ]; then
      keys=$(jq -r --arg k "$keys_of" '
        (.[$k] // {}) | if type == "object" then (keys_unsorted | join(", ")) else "" end
      ' "$path" 2>/dev/null) || keys=""
      if [ -n "$keys" ]; then
        detail="$path ($keys_of: $keys)"
      else
        detail="$path (no $keys_of entries)"
      fi
    fi
  fi

  if [ "$marker" = "ok" ]; then
    printf '  [OK]   %s\n' "$declared" >&2
  elif [ "$level" = "core" ]; then
    printf '  [FAIL] %s\n' "$declared" >&2
    ERRORS=$((ERRORS + 1))
  else
    printf '  [WARN] %s\n' "$declared" >&2
    WARNINGS=$((WARNINGS + 1))
  fi
  printf '         %s\n' "$detail" >&2
}

printf '=== shai-doctor ===\n\n' >&2

printf 'Core tools:\n' >&2
for t in "${CORE_TOOLS[@]}"; do check_tool "$t" core; done

printf '\nConditional tools:\n' >&2
for t in "${COND_TOOLS[@]}"; do check_tool "$t" conditional; done

printf '\nEnvironment:\n' >&2
check_env DEEPSEEK_API_KEY core

printf '\nConfiguration:\n' >&2
check_config SHAI_HOME "$HOME/.shai"
check_config SHAI_MODEL "deepseek-v4-pro"
check_config SHAI_MAX_CONTEXT_BYTES "1300000"
check_config SHAI_UNIT_DIR "$HOME/.config/systemd/user"
check_config SHAI_SUGGEST "1"
# SHAI_SUGGEST_REPO has no default: when unset, wf_suggest_repo resolves it from the install
# dir's origin remote. Report what the detection finds so the section always shows the
# effective value, not just the mechanism.
suggest_repo_label="unset — auto-detected"
if [ -z "${SHAI_SUGGEST_REPO:-}" ]; then
  if detected=$(wf_suggest_repo 2>/dev/null); then
    suggest_repo_label="unset — auto-detected: $detected"
  fi
fi
check_config SHAI_SUGGEST_REPO "" "$suggest_repo_label"

# Completions are informational: a missing completion file degrades tab completion only,
# so it is a warning, never an error. The paths match `shai-completions install`'s
# targets, honoring XDG_DATA_HOME exactly as the installer does. The zsh OK label says
# only what the test established: presence is necessary but not sufficient — zsh loads
# the file only when its directory is in $fpath at compinit time, which a bare
# [ -f ] cannot check.
printf '\nCompletions:\n' >&2
COMPLETIONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
ZSH_COMPLETIONS="$COMPLETIONS_DIR/zsh/site-functions/_shai"
BASH_COMPLETIONS="$COMPLETIONS_DIR/bash-completion/completions/shai"
if [ -f "$ZSH_COMPLETIONS" ]; then
  printf '  [OK]   zsh completion file present (%s)\n' "$ZSH_COMPLETIONS" >&2
else
  printf '  [WARN] zsh completions not found: %s (run: shai-completions install zsh)\n' \
    "$ZSH_COMPLETIONS" >&2
  WARNINGS=$((WARNINGS + 1))
fi
if [ -f "$BASH_COMPLETIONS" ]; then
  printf '  [OK]   bash completions (%s)\n' "$BASH_COMPLETIONS" >&2
else
  printf '  [WARN] bash completions not found: %s (run: shai-completions install bash)\n' \
    "$BASH_COMPLETIONS" >&2
  WARNINGS=$((WARNINGS + 1))
fi

# Derive additional deps from tool plugins
if command -v jq >/dev/null 2>&1 && [ -d "$DIR/tools" ]; then
  SEEN_TOOLS=("${CORE_TOOLS[@]}" "${COND_TOOLS[@]}")
  SEEN_ENVS=(DEEPSEEK_API_KEY)
  is_seen() {
    local item="$1" s
    for s in "${SEEN_TOOLS[@]+"${SEEN_TOOLS[@]}"}"; do
      [ "$s" = "$item" ] && return 0
    done
    return 1
  }
  is_env_seen() {
    local item="$1" s
    for s in "${SEEN_ENVS[@]+"${SEEN_ENVS[@]}"}"; do
      [ "$s" = "$item" ] && return 0
    done
    return 1
  }

  # Env vars: collect every tool.json declaration first, then report each unique var once at
  # its strictest declared level (core beats conditional). A var declared by several tools at
  # different levels must not get its severity from whichever tool.json glob order happens to
  # come first. No conflict exists today (every tool-declared env var is conditional); this
  # keeps the doctor correct if one appears — e.g. a var one tool needs to function (core) and
  # another merely degrades without (conditional) should FAIL, not WARN.
  ENV_NAMES=() ENV_LEVELS=() ENV_COUNT=0
  for tj in "$DIR"/tools/*/tool.json; do
    [ -f "$tj" ] || continue
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      local_name=$(printf '%s' "$line" | jq -r '.name')
      local_level=$(printf '%s' "$line" | jq -r '.level')
      found=0
      i=0
      while [ "$i" -lt "$ENV_COUNT" ]; do
        if [ "${ENV_NAMES[$i]}" = "$local_name" ]; then
          if [ "$local_level" = "core" ]; then
            ENV_LEVELS[i]="core"
          fi
          found=1
          break
        fi
        i=$((i + 1))
      done
      if [ "$found" -eq 0 ]; then
        ENV_NAMES[ENV_COUNT]="$local_name"
        ENV_LEVELS[ENV_COUNT]="$local_level"
        ENV_COUNT=$((ENV_COUNT + 1))
      fi
    done < <(jq -c '.capabilities.requires.env // [] | .[]' "$tj" 2>/dev/null)
  done

  printf '\nTool-declared dependencies:\n' >&2
  for tj in "$DIR"/tools/*/tool.json; do
    [ -f "$tj" ] || continue
    # tools
    while IFS= read -r dep; do
      [ -n "$dep" ] || continue
      if ! is_seen "$dep"; then
        SEEN_TOOLS+=("$dep")
        check_tool "$dep" conditional
      fi
    done < <(jq -r '.capabilities.requires.tools // [] | .[]' "$tj" 2>/dev/null)
  done
  # Report each unique env var once, at its strictest declared level. DEEPSEEK_API_KEY is
  # skipped here — the unconditional check above already reported it, and SEEN_ENVS is seeded
  # with it for exactly that.
  i=0
  while [ "$i" -lt "$ENV_COUNT" ]; do
    if ! is_env_seen "${ENV_NAMES[$i]}"; then
      SEEN_ENVS+=("${ENV_NAMES[$i]}")
      check_env "${ENV_NAMES[$i]}" "${ENV_LEVELS[$i]}"
    fi
    i=$((i + 1))
  done

  # Config files a tool needs but nothing installs for it (e.g. the ci tool's ci.json).
  # The section header prints unconditionally so an empty section is itself a signal.
  printf '\nTool-declared files:\n' >&2
  SEEN_FILES=""
  for tj in "$DIR"/tools/*/tool.json; do
    [ -f "$tj" ] || continue
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      # A non-object entry makes jq exit non-zero; keep the scan (and the summary line)
      # alive instead of aborting the whole diagnostic under `set -e`.
      file_path=$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null) || file_path=""
      [ -n "$file_path" ] || continue
      case "$SEEN_FILES" in *"|$file_path|"*) continue ;; esac
      SEEN_FILES="$SEEN_FILES|$file_path|"
      file_level=$(printf '%s' "$line" | jq -r '.level // "conditional"')
      file_format=$(printf '%s' "$line" | jq -r '.format // empty')
      file_keys=$(printf '%s' "$line" | jq -r '.keys // empty')
      file_hint=$(printf '%s' "$line" | jq -r '.hint // empty')
      check_config_file "$file_path" "$file_level" "$file_format" "$file_keys" "$file_hint"
    done < <(jq -c '.capabilities.requires.files // [] | .[]' "$tj" 2>/dev/null)
  done

  # Tool behavior self-checks: probe an installed tool's actual behavior against its tool.json
  # contract instead of trusting that the shipped file is what runs. search_files documents
  # "grep extended regex; use | for alternation" (ERE) — the -E flag shipped in #136 — but a
  # stale install predating that fix silently searches for a literal pipe and returns zero
  # matches for every alternation (see #246, filed against exactly such a stale installed
  # copy; #232 shows installed copies diverge). The probe runs the local run.sh on a
  # two-file fixture and requires both alternatives to match, so a zero-match cannot be
  # mistaken for success. WARN, not FAIL: the environment is degraded (alternation searches
  # return wrong results) but shai still launches, so this gets the same degraded-but-usable
  # treatment as a conditional dependency.
  printf '\nTool behavior self-checks:\n' >&2
  if [ -x "$DIR/tools/search_files/run.sh" ] && command -v timeout >/dev/null 2>&1; then
    probe=$(mktemp -d) || true
    if [ -n "$probe" ]; then
      printf 'alpha one\n' >"$probe/a.txt"
      printf 'beta two\n' >"$probe/b.txt"
      out=$(bash "$DIR/tools/search_files/run.sh" \
        "$(jq -nc --arg p "$probe" '{pattern:"alpha|beta",path:$p}')" 2>&1) || true
      rm -rf "$probe"
      if [[ "$out" == *"alpha one"* && "$out" == *"beta two"* ]]; then
        printf '  [OK]   search_files alternation (grep -E)\n' >&2
      else
        printf '  [WARN] search_files alternation (grep -E)\n' >&2
        printf '         could not confirm alternation works: "alpha|beta" returned no matches\n' >&2
        printf '         on a probe fixture. A stale install predating the #136 -E fix (which\n' >&2
        printf '         silently searches for a literal pipe, so "foo|bar" finds nothing) is\n' >&2
        printf '         the usual cause, but a missing timeout/grep or any run failure looks\n' >&2
        printf '         the same. Reinstall shai (or update the installed tools) so\n' >&2
        printf '         alternation works as documented.\n' >&2
        WARNINGS=$((WARNINGS + 1))
      fi
    fi
  fi
fi

# check_policy_file <path> <label>: validate a policy.json file — JSON parse, schema shape
# (top level must be an object), and rule summary. Missing files are silent (policy.json is
# optional). WARN on any issue because the system degrades safely (writes prompt → denied
# headlessly) but silently drops every rule, which is the gap this check closes.
check_policy_file() {
  local path="$1" label="$2"
  [ -f "$path" ] || return 0

  if ! jq empty "$path" >/dev/null 2>&1; then
    printf '  [WARN] %s\n' "$label" >&2
    printf '         not valid JSON: %s\n' "$path" >&2
    WARNINGS=$((WARNINGS + 1))
    return 0
  fi

  local issues
  issues=$(jq -r '
    def valid_actions: ["allow", "prompt", "deny"];
    if type != "object" then
      "policy must be a JSON object (got \(type))"
    else
      ([
        (if (.rules | type) != "array" and has("rules") then
          ".rules must be an array"
        else empty end),

        (if (.rules | type) == "array" then
          .rules | to_entries[] |
          (if (.value.tool | type) != "string" or (.value.tool | length) == 0 then
            "rule[\(.key)]: missing or invalid .tool"
          else empty end),
          (if (.value.action | type) != "string" or
              ([.value.action] | inside(valid_actions) | not) then
            "rule[\(.key)]: invalid .action \(.value.action // "null") (expected allow/prompt/deny)"
          else empty end)
        else empty end),

        (if has("default") then
          if ([.default] | inside(valid_actions) | not) then
            "invalid .default \(.default) (expected allow/prompt/deny)"
          else empty end
        else empty end)
      ] | .[])
    end
  ' "$path" 2>/dev/null) || issues=""

  if [ -n "$issues" ]; then
    printf '  [WARN] %s\n' "$label" >&2
    while IFS= read -r line; do
      printf '         %s\n' "$line" >&2
    done <<<"$issues"
    WARNINGS=$((WARNINGS + 1))
    return 0
  fi

  local rule_count default_val summary
  rule_count=$(jq -r '.rules | length' "$path" 2>/dev/null) || rule_count=0
  default_val=$(jq -r '.default // empty' "$path" 2>/dev/null) || default_val=""
  local rule_word="rules"
  [ "$rule_count" -eq 1 ] && rule_word="rule"
  if [ -n "$default_val" ]; then
    summary="$rule_count $rule_word, default: $default_val"
  else
    summary="$rule_count $rule_word, no default"
  fi
  printf '  [OK]   %s\n' "$label" >&2
  printf '         %s (%s)\n' "$path" "$summary" >&2
}

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
if command -v jq >/dev/null 2>&1; then
  printf '\nPolicy files:\n' >&2
  check_policy_file "$STATE_DIR/policy.json" '$SHAI_HOME/policy.json'
  if [ -n "${SHAI_POLICY_OVERLAY:-}" ]; then
    local_label=$(basename "$SHAI_POLICY_OVERLAY")
    check_policy_file "$SHAI_POLICY_OVERLAY" "$local_label"
  fi
else
  # jq absence is already a core FAIL above; policy validation depends on jq, so skip the
  # section with a single WARN instead of reporting every policy file as broken JSON.
  printf '\nPolicy files:\n' >&2
  printf '  [WARN] policy validation skipped — jq not installed\n' >&2
  WARNINGS=$((WARNINGS + 1))
fi

printf '\n%d error%s, %d warning%s\n' \
  "$ERRORS" "$([ "$ERRORS" -ne 1 ] && echo s)" \
  "$WARNINGS" "$([ "$WARNINGS" -ne 1 ] && echo s)" >&2

[ "$ERRORS" -eq 0 ]
