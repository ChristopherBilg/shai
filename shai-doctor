#!/bin/bash
# shai-doctor — validate environment prerequisites for shai
# Usage: shai-doctor
# Reads: $PATH (CLI tool availability), environment variables, tool-declared config files
# Writes: diagnostic report to stderr
# Exit: 0 if all core checks pass; 1 if any core check fails
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

ERRORS=0
WARNINGS=0

CORE_TOOLS=(jq curl date od mktemp tr)
COND_TOOLS=(systemctl journalctl timeout)

check_tool() {
  local name="$1" level="$2"
  if command -v "$name" >/dev/null 2>&1; then
    printf '  [OK]   %s\n' "$name" >&2
  elif [ "$level" = "core" ]; then
    printf '  [FAIL] %s\n' "$name" >&2
    ERRORS=$((ERRORS + 1))
  else
    printf '  [WARN] %s\n' "$name" >&2
    WARNINGS=$((WARNINGS + 1))
  fi
}

check_env() {
  local name="$1" level="$2"
  local val="${!name:-}"
  if [ -n "$val" ]; then
    printf '  [OK]   %s\n' "$name" >&2
  elif [ "$level" = "core" ]; then
    printf '  [FAIL] %s\n' "$name" >&2
    ERRORS=$((ERRORS + 1))
  else
    printf '  [WARN] %s\n' "$name" >&2
    WARNINGS=$((WARNINGS + 1))
  fi
}

# expand_path <declared>: expand the $SHAI_HOME / $HOME / ~ prefixes a tool.json may use in a
# declared path. Only those three are substituted — tool.json is data, never eval'd.
expand_path() {
  local p="$1"
  p="${p//\$\{SHAI_HOME\}/${SHAI_HOME:-$HOME/.shai}}"
  p="${p//\$SHAI_HOME/${SHAI_HOME:-$HOME/.shai}}"
  p="${p//\$\{HOME\}/$HOME}"
  p="${p//\$HOME/$HOME}"
  p="${p/#\~/$HOME}"
  printf '%s' "$p"
}

# check_config_file <declared-path> <level> [format] [keys-of] [hint]
# A missing or malformed file is an error at level 'core' and a warning at 'conditional' —
# the same degraded-but-usable treatment the conditional env vars get.
# 'format' defaults to json here — the single place that default lives, matching
# tests/validate-tool-schema.sh, which accepts only a missing or "json" format. Omitting it in
# tool.json therefore still gets the parse check and the 'keys' listing, never a silent skip.
# The status line ends with the *declared* path (with $SHAI_HOME still unexpanded) so
# tests/doctor-sync.sh can match it against tool.json without re-expanding anything;
# the resolved path and any detail go on an indented continuation line.
check_config_file() {
  local declared="$1" level="$2" format="${3:-json}" keys_of="${4:-}" hint="${5:-}"
  local path detail="" marker keys
  path="$(expand_path "$declared")"
  if [ ! -f "$path" ]; then
    marker=bad
    detail="not found: $path"
    [ -n "$hint" ] && detail="$detail — $hint"
  elif [ "$format" = "json" ] && ! jq empty "$path" >/dev/null 2>&1; then
    marker=bad
    detail="not valid JSON: $path"
  else
    marker=ok
    detail="$path"
    if [ -n "$keys_of" ] && [ "$format" = "json" ]; then
      keys=$(jq -r --arg k "$keys_of" '
        (.[$k] // {}) | if type == "object" then (keys_unsorted | join(", ")) else "" end
      ' "$path" 2>/dev/null) || keys=""
      if [ -n "$keys" ]; then
        detail="$path ($keys_of: $keys)"
      else
        detail="$path (no $keys_of entries)"
      fi
    fi
  fi

  if [ "$marker" = "ok" ]; then
    printf '  [OK]   %s\n' "$declared" >&2
  elif [ "$level" = "core" ]; then
    printf '  [FAIL] %s\n' "$declared" >&2
    ERRORS=$((ERRORS + 1))
  else
    printf '  [WARN] %s\n' "$declared" >&2
    WARNINGS=$((WARNINGS + 1))
  fi
  printf '         %s\n' "$detail" >&2
}

printf '=== shai-doctor ===\n\n' >&2

printf 'Core tools:\n' >&2
for t in "${CORE_TOOLS[@]}"; do check_tool "$t" core; done

printf '\nConditional tools:\n' >&2
for t in "${COND_TOOLS[@]}"; do check_tool "$t" conditional; done

printf '\nEnvironment:\n' >&2
check_env DEEPSEEK_API_KEY core

# Derive additional deps from tool plugins
if command -v jq >/dev/null 2>&1 && [ -d "$DIR/tools" ]; then
  SEEN_TOOLS=("${CORE_TOOLS[@]}" "${COND_TOOLS[@]}")
  SEEN_ENVS=(DEEPSEEK_API_KEY)
  is_seen() {
    local item="$1" s
    for s in "${SEEN_TOOLS[@]+"${SEEN_TOOLS[@]}"}"; do
      [ "$s" = "$item" ] && return 0
    done
    return 1
  }
  is_env_seen() {
    local item="$1" s
    for s in "${SEEN_ENVS[@]+"${SEEN_ENVS[@]}"}"; do
      [ "$s" = "$item" ] && return 0
    done
    return 1
  }

  printf '\nTool-declared dependencies:\n' >&2
  for tj in "$DIR"/tools/*/tool.json; do
    [ -f "$tj" ] || continue
    # tools
    while IFS= read -r dep; do
      [ -n "$dep" ] || continue
      if ! is_seen "$dep"; then
        SEEN_TOOLS+=("$dep")
        check_tool "$dep" conditional
      fi
    done < <(jq -r '.capabilities.requires.tools // [] | .[]' "$tj" 2>/dev/null)
    # env vars
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      local_name=$(printf '%s' "$line" | jq -r '.name')
      local_level=$(printf '%s' "$line" | jq -r '.level')
      if ! is_env_seen "$local_name"; then
        SEEN_ENVS+=("$local_name")
        check_env "$local_name" "$local_level"
      fi
    done < <(jq -c '.capabilities.requires.env // [] | .[]' "$tj" 2>/dev/null)
  done

  # Config files a tool needs but nothing installs for it (e.g. the ci tool's ci.json).
  # The section header prints unconditionally so an empty section is itself a signal.
  printf '\nTool-declared files:\n' >&2
  SEEN_FILES=""
  for tj in "$DIR"/tools/*/tool.json; do
    [ -f "$tj" ] || continue
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      # A non-object entry makes jq exit non-zero; keep the scan (and the summary line)
      # alive instead of aborting the whole diagnostic under `set -e`.
      file_path=$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null) || file_path=""
      [ -n "$file_path" ] || continue
      case "$SEEN_FILES" in *"|$file_path|"*) continue ;; esac
      SEEN_FILES="$SEEN_FILES|$file_path|"
      file_level=$(printf '%s' "$line" | jq -r '.level // "conditional"')
      file_format=$(printf '%s' "$line" | jq -r '.format // empty')
      file_keys=$(printf '%s' "$line" | jq -r '.keys // empty')
      file_hint=$(printf '%s' "$line" | jq -r '.hint // empty')
      check_config_file "$file_path" "$file_level" "$file_format" "$file_keys" "$file_hint"
    done < <(jq -c '.capabilities.requires.files // [] | .[]' "$tj" 2>/dev/null)
  done

  # Tool behavior self-checks: probe an installed tool's actual behavior against its tool.json
  # contract instead of trusting that the shipped file is what runs. search_files documents
  # "grep extended regex; use | for alternation" (ERE) — the -E flag shipped in #136 — but a
  # stale install predating that fix silently searches for a literal pipe and returns zero
  # matches for every alternation (see #246, filed against exactly such a stale installed
  # copy; #232 shows installed copies diverge). The probe runs the local run.sh on a
  # two-file fixture and requires both alternatives to match, so a zero-match cannot be
  # mistaken for success. WARN, not FAIL: the environment is degraded (alternation searches
  # return wrong results) but shai still launches, so this gets the same degraded-but-usable
  # treatment as a conditional dependency.
  printf '\nTool behavior self-checks:\n' >&2
  if [ -x "$DIR/tools/search_files/run.sh" ] && command -v timeout >/dev/null 2>&1; then
    probe=$(mktemp -d) || true
    if [ -n "$probe" ]; then
      printf 'alpha one\n' >"$probe/a.txt"
      printf 'beta two\n' >"$probe/b.txt"
      out=$(bash "$DIR/tools/search_files/run.sh" \
        "$(jq -nc --arg p "$probe" '{pattern:"alpha|beta",path:$p}')" 2>&1) || true
      rm -rf "$probe"
      if [[ "$out" == *"alpha one"* && "$out" == *"beta two"* ]]; then
        printf '  [OK]   search_files alternation (grep -E)\n' >&2
      else
        printf '  [WARN] search_files alternation (grep -E)\n' >&2
        printf '         could not confirm alternation works: "alpha|beta" returned no matches\n' >&2
        printf '         on a probe fixture. A stale install predating the #136 -E fix (which\n' >&2
        printf '         silently searches for a literal pipe, so "foo|bar" finds nothing) is\n' >&2
        printf '         the usual cause, but a missing timeout/grep or any run failure looks\n' >&2
        printf '         the same. Reinstall shai (or update the installed tools) so\n' >&2
        printf '         alternation works as documented.\n' >&2
        WARNINGS=$((WARNINGS + 1))
      fi
    fi
  fi
fi

printf '\n%d error%s, %d warning%s\n' \
  "$ERRORS" "$([ "$ERRORS" -ne 1 ] && echo s)" \
  "$WARNINGS" "$([ "$WARNINGS" -ne 1 ] && echo s)" >&2

[ "$ERRORS" -eq 0 ]
