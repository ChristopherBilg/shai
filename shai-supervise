#!/bin/bash
# shai-supervise — manage shai workflows under systemd --user
# Usage: shai-supervise install|uninstall|start|stop|logs <script> [--interval <timespan>]
#        shai-supervise status [script] [--json]
#        shai-supervise repoint [<script> | --all] [--dry-run]
# Reads: SHAI_API_KEY, SHAI_API_URL, SHAI_MODEL, SHAI_HOME from environment (install only); target script from $DIR or $DIR/workflows;
#        installed unit files from $SHAI_UNIT_DIR (status, repoint)
# Writes: systemd unit files to $SHAI_UNIT_DIR (default ~/.config/systemd/user) (install/uninstall);
#        rewrites only the ExecStart= line of installed .service files (repoint)
# Exit: 0 on success; 1 on validation error, systemctl failure, or rewrite failure; 2 on usage error
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
UNIT_DIR="${SHAI_UNIT_DIR:-$HOME/.config/systemd/user}"
# shellcheck source=lib/units.sh
source "$DIR/lib/units.sh"

# unit_name <script>: strip workflows/ prefix, /run.sh suffix, and .sh suffix,
# validate, strip leading shai- if present, prepend shai-
unit_name() {
  local script="$1"
  script="${script#workflows/}"
  script="${script%/run.sh}"
  script="${script%.sh}"
  if [[ "$script" =~ [/] ]] || [[ "$script" == *..* ]]; then
    printf 'error: script name must not contain / or .. (got "%s")\n' "$script" >&2
    exit 1
  fi
  script="${script#shai-}"
  printf 'shai-%s' "$script"
}

cmd_install() {
  local script="$1" interval="${2:-15min}"
  local script_path="$DIR/$script"

  if [ ! -x "$script_path" ] && [ -x "$DIR/workflows/$script/run.sh" ]; then
    script_path="$DIR/workflows/$script/run.sh"
  fi

  if [ ! -x "$script_path" ]; then
    printf 'error: %s not found or not executable in %s\n' "$script" "$DIR" >&2
    exit 1
  fi

  local v
  for v in SHAI_API_KEY SHAI_API_URL SHAI_MODEL; do
    if [ -z "${!v:-}" ]; then
      printf 'error: %s must be set\n' "$v" >&2
      exit 1
    fi
  done

  local name shai_home
  name="$(unit_name "$script")"
  shai_home="${SHAI_HOME:-$HOME/.shai}"

  mkdir -p "$UNIT_DIR"

  cat >"$UNIT_DIR/$name.service" <<EOF
[Unit]
Description=shai $name workflow

[Service]
Type=oneshot
ExecStart=$script_path
Environment=SHAI_API_KEY=$SHAI_API_KEY
Environment=SHAI_API_URL=$SHAI_API_URL
Environment=SHAI_MODEL=$SHAI_MODEL
Environment=SHAI_HOME=$shai_home
EOF
  chmod 600 "$UNIT_DIR/$name.service"

  cat >"$UNIT_DIR/$name.timer" <<EOF
[Unit]
Description=shai $name timer

[Timer]
OnBootSec=5min
OnUnitActiveSec=$interval

[Install]
WantedBy=timers.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable "$name.timer"
  printf 'installed %s.timer (interval: %s)\n' "$name" "$interval"
}

cmd_uninstall() {
  local name
  name="$(unit_name "$1")"

  systemctl --user stop "$name.timer" 2>/dev/null || true
  systemctl --user disable "$name.timer" 2>/dev/null || true
  rm -f "$UNIT_DIR/$name.service" "$UNIT_DIR/$name.timer"
  systemctl --user daemon-reload
  printf 'uninstalled %s\n' "$name"
}

# repoint_old_base <exec>: the install directory embedded in an ExecStart path, for the
# two shapes cmd_install writes — <base>/shai-* (a direct script) or
# <base>/workflows/<name>/run.sh (a workflow). Exits 1 for any other shape: repoint must
# only rewrite units this script wrote, never guess at a foreign ExecStart.
repoint_old_base() {
  local exec="$1" base
  case "$exec" in
    */workflows/*/run.sh)
      base="${exec%/workflows/*/run.sh}"
      [ -n "$base" ] || return 1
      printf '%s' "$base"
      ;;
    */shai-*)
      printf '%s' "$(dirname "$exec")"
      ;;
    *)
      return 1
      ;;
  esac
}

# repoint_suffix <exec>: the remainder of an ExecStart path after its embedded install
# directory — the part that stays constant across versions and gets joined onto $DIR.
# Exits 1 for an unrecognized shape or a workflow segment that is not a plain name
# (cmd_install's unit_name rejects / and .., so such a unit was not written by it).
repoint_suffix() {
  local exec="$1" base suffix name
  base="$(repoint_old_base "$exec")" || return 1
  suffix="${exec#"$base"/}"
  case "$suffix" in
    workflows/*/run.sh)
      name="${suffix#workflows/}"
      name="${name%/run.sh}"
      if [ -z "$name" ] || [[ "$name" == *..* ]] || [[ "$name" == */* ]]; then
        return 1
      fi
      ;;
    shai-*) ;;
    *) return 1 ;;
  esac
  printf '%s' "$suffix"
}

# repoint_rewritten <exec> <new>: copy stdin to stdout with only the
# `ExecStart=<exec>` line replaced by `ExecStart=<new>`. `IFS= read -r` keeps every
# other line byte-for-byte, so OnUnitActiveSec, Environment=, and Description survive.
repoint_rewritten() {
  local exec="$1" new="$2" line
  while IFS= read -r line; do
    if [ "$line" = "ExecStart=$exec" ]; then
      printf 'ExecStart=%s\n' "$new"
    else
      printf '%s\n' "$line"
    fi
  done
}

# repoint_write <exec> <new> <service>: rewrite only the ExecStart= line via a temp file
# in the unit directory (atomic rename) and re-chmod 600 — the .service file holds the
# plaintext API key, so a failed rewrite must leave the original untouched.
repoint_write() {
  local exec="$1" new="$2" service="$3" tmp
  if ! tmp="$(mktemp "$UNIT_DIR/.shai-repoint.XXXXXX")"; then
    printf 'error: %s: could not create a temp file for the rewrite\n' "$service" >&2
    return 1
  fi
  if ! repoint_rewritten "$exec" "$new" <"$service" >"$tmp"; then
    rm -f "$tmp"
    printf 'error: %s: rewrite failed, original left untouched\n' "$service" >&2
    return 1
  fi
  if ! mv -f "$tmp" "$service"; then
    rm -f "$tmp"
    printf 'error: %s: could not move the rewritten unit into place, original left untouched\n' "$service" >&2
    return 1
  fi
  # mktemp's default mode is 600 already, but re-apply it after the rename explicitly:
  # 600 is the contract for a file holding the plaintext API key.
  if ! chmod 600 "$service"; then
    printf 'error: %s: could not restore mode 600 after the rewrite\n' "$service" >&2
    return 1
  fi
}

# repoint_unit <unit> <dry_run>: one unit's rewrite decision. Dispatch order is the
# unit_install_state classification: ok → skip; -- (no unit file or no ExecStart) →
# warn and skip; an unrecognized ExecStart shape → warn and skip, never guess.
# Anything else (stale, broken) with a recognized shape gets the ExecStart rewrite.
repoint_unit() {
  local unit="$1" dry_run="$2"
  local service="$UNIT_DIR/$unit.service" state exec base suffix new
  state="$(unit_install_state "$UNIT_DIR" "$DIR" "$unit")"
  case "$state" in
    ok)
      printf '%-24s  already current (skipped)\n' "$unit"
      return 0
      ;;
    --)
      printf 'warning: %s: no unit file or ExecStart line (skipped)\n' "$unit" >&2
      return 0
      ;;
  esac
  exec="$(unit_exec_start "$UNIT_DIR" "$unit")"
  if ! base="$(repoint_old_base "$exec")" || ! suffix="$(repoint_suffix "$exec")"; then
    printf 'warning: %s: unrecognized ExecStart shape (skipped)\n' "$unit" >&2
    return 0
  fi
  new="$DIR/$suffix"
  if [ "$dry_run" = true ]; then
    diff -u --label "$service" --label "$service (repointed)" "$service" \
      <(repoint_rewritten "$exec" "$new" <"$service") || true
    REPOINT_CHANGED=$((REPOINT_CHANGED + 1))
    return 0
  fi
  if ! repoint_write "$exec" "$new" "$service"; then
    REPOINT_FAILED=1
    return 0
  fi
  printf '%-24s  %s -> current\n' "$unit" "$(basename "$base")"
  REPOINT_CHANGED=$((REPOINT_CHANGED + 1))
}

# cmd_repoint: migrate units whose ExecStart bakes in a versioned path to $DIR (which,
# when invoked through an install's `current` symlink, is itself version-independent).
# Invocation from a versioned install directory is refused outright: it would rewrite
# ExecStart to another versioned path and re-bake the bug class repoint removes.
# Unlike re-running `install`, this preserves a customized OnUnitActiveSec and the
# Environment=SHAI_API_KEY= line, and needs no exported API key.
cmd_repoint() {
  case "$DIR" in
    */shai/v[0-9]*)
      printf 'error: repoint must run through the current symlink (e.g. the shai-supervise wrapper), not from a versioned install directory: %s\n' "$DIR" >&2
      exit 1
      ;;
  esac
  local script="" all=false dry_run=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=true ;;
      --dry-run) dry_run=true ;;
      --*)
        printf 'error: unknown option: %s\n' "$1" >&2
        exit 2
        ;;
      *)
        if [ -n "$script" ]; then
          printf 'error: unexpected argument: %s\n' "$1" >&2
          exit 2
        fi
        script="$1"
        ;;
    esac
    shift
  done
  if [ -n "$script" ] && [ "$all" = true ]; then
    printf 'error: specify either a script or --all, not both\n' >&2
    exit 2
  fi
  if [ -z "$script" ] && [ "$all" = false ]; then
    printf 'error: specify a script or --all\n' >&2
    exit 2
  fi

  local units=() f
  if [ -n "$script" ]; then
    units+=("$(unit_name "$script")")
  else
    for f in "$UNIT_DIR"/shai-*.service; do
      [ -e "$f" ] || continue
      units+=("$(basename "$f" .service)")
    done
    if [ "${#units[@]}" -gt 0 ]; then
      mapfile -t units < <(printf '%s\n' "${units[@]}" | sort)
    fi
  fi

  REPOINT_CHANGED=0
  REPOINT_FAILED=0
  local unit
  for unit in "${units[@]}"; do
    repoint_unit "$unit" "$dry_run"
  done

  if [ "$REPOINT_CHANGED" -gt 0 ] && [ "$dry_run" = false ]; then
    # One reload at the end, and only when a unit actually changed.
    systemctl --user daemon-reload
    if [ "$REPOINT_CHANGED" -eq 1 ]; then
      printf 'daemon-reloaded; 1 unit repointed\n'
    else
      printf 'daemon-reloaded; %d units repointed\n' "$REPOINT_CHANGED"
    fi
  elif [ "$REPOINT_CHANGED" -gt 0 ]; then
    printf '%d unit(s) would be repointed (dry run)\n' "$REPOINT_CHANGED"
  fi

  exit "$REPOINT_FAILED"
}

cmd_start() {
  local name
  name="$(unit_name "$1")"
  systemctl --user start "$name.timer"
}

cmd_stop() {
  local name
  name="$(unit_name "$1")"
  systemctl --user stop "$name.timer"
}

# Rows are joined with a real tab: neither systemd unit names nor the rendered
# columns can contain one, so it is an unambiguous separator between the fields
# that `status_query` collected and the renderers consume.
TAB=$'\t'

# Set by status_query for the unit it was called with; a failing `systemctl show`
# flips STATUS_FAILED so cmd_status can exit non-zero after rendering.
STATUS_FAILED=0
STATUS_LOAD="" STATUS_STATE="" STATUS_LAST="" STATUS_NEXT="" STATUS_INSTALL=""

# Set by cmd_repoint for the unit being rewritten: REPOINT_CHANGED counts rewritten
# units (a non-zero count is what triggers the single trailing daemon-reload), and
# REPOINT_FAILED flips on a write failure so cmd_repoint can exit 1 after finishing.
REPOINT_CHANGED=0
REPOINT_FAILED=0

# status_prop <props> <key>: the value of `key=` in `systemctl show` output ("" if absent)
status_prop() {
  local props="$1" key="$2"
  printf '%s\n' "$props" | while IFS='=' read -r k v; do
    if [ "$k" = "$key" ]; then
      printf '%s' "$v"
      return
    fi
  done
}

# status_timestamp <value>: "YYYY-MM-DD HH:MM" from a systemd timestamp such as
# "Www YYYY-MM-DD HH:MM:SS TZ". The shape is verified before anything is stripped,
# so "n/a", "0", a raw usec count, or a different `--timestamp=` style yields ""
# (rendered as "--") instead of a silently mistruncated string.
status_timestamp() {
  local val="${1:-}"
  if [[ "$val" =~ ^[A-Za-z]+[[:space:]]+(.*)$ ]]; then val="${BASH_REMATCH[1]}"; fi
  if [[ "$val" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

# status_next <realtime> <monotonic>: next elapse as "YYYY-MM-DD HH:MM".
# NextElapseUSecRealtime is only populated for calendar (OnCalendar=) timers; the
# monotonic timers `install` writes (OnBootSec=/OnUnitActiveSec=) populate
# NextElapseUSecMonotonic instead, which systemd reports either as a timestamp or
# as raw microseconds since boot -- the latter is converted with /proc/stat's
# btime. Unrecognized/absent values yield "".
status_next() {
  local realtime="${1:-}" monotonic="${2:-}" ts boot epoch
  ts=$(status_timestamp "$realtime")
  if [ -z "$ts" ]; then ts=$(status_timestamp "$monotonic"); fi
  if [ -n "$ts" ]; then
    printf '%s' "$ts"
    return
  fi
  # Bounded to 15 digits (~31 years of uptime) so USEC_INFINITY (20 digits, used
  # for "never") never reaches the arithmetic below.
  if [[ "$monotonic" =~ ^[0-9]{1,15}$ ]] && [ "$monotonic" != "0" ]; then
    boot=$(awk '/^btime /{print $2; exit}' /proc/stat 2>/dev/null) || boot=""
    if [ -n "$boot" ]; then
      epoch=$((boot + monotonic / 1000000))
      date -d "@$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || true
    fi
  fi
}

# status_query <unit>: fill STATUS_LOAD/STATUS_STATE/STATUS_LAST/STATUS_NEXT/STATUS_INSTALL
# from a single `systemctl show` call plus a read of the installed .service file. Both
# renderers go through this so the table and the JSON output cannot drift apart.
status_query() {
  local unit="$1" props
  if ! props=$(systemctl --user show -p LoadState,ActiveState,LastTriggerUSec,NextElapseUSecRealtime,NextElapseUSecMonotonic "$unit.timer" 2>/dev/null); then
    printf 'warning: systemctl show failed for %s.timer\n' "$unit" >&2
    STATUS_FAILED=1
    props=""
  fi
  STATUS_LOAD=$(status_prop "$props" "LoadState")
  STATUS_STATE=$(status_prop "$props" "ActiveState")
  STATUS_LAST=$(status_timestamp "$(status_prop "$props" "LastTriggerUSec")")
  STATUS_NEXT=$(status_next "$(status_prop "$props" "NextElapseUSecRealtime")" "$(status_prop "$props" "NextElapseUSecMonotonic")")
  # INSTALL is a file read (lib/units.sh), not a systemctl call: a stale unit is not a
  # query failure, so it must not flip STATUS_FAILED.
  STATUS_INSTALL=$(unit_install_state "$UNIT_DIR" "$DIR" "$unit")
  if [ "$STATUS_LOAD" = "not-found" ]; then STATUS_STATE="not-found"; fi
}

cmd_status() {
  local json=false script=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true ;;
      -*)
        printf 'error: unknown option: %s\n' "$1" >&2
        exit 1
        ;;
      *)
        if [ -n "$script" ]; then
          printf 'error: unexpected argument: %s\n' "$1" >&2
          exit 1
        fi
        script="$1"
        ;;
    esac
    shift
  done

  local units=() name f
  if [ -n "$script" ]; then
    name="$(unit_name "$script")"
    units+=("$name")
  else
    for f in "$UNIT_DIR"/shai-*.timer; do
      [ -e "$f" ] || continue
      units+=("$(basename "$f" .timer)")
    done
    if [ "${#units[@]}" -gt 0 ]; then
      mapfile -t units < <(printf '%s\n' "${units[@]}" | sort)
    fi
  fi

  if [ ${#units[@]} -eq 0 ]; then
    if [ "$json" = true ]; then printf '[]\n'; fi
    return
  fi

  local rows=() unit
  for unit in "${units[@]}"; do
    status_query "$unit"
    # An explicitly named unit that systemd does not know about is an error, as it
    # was when this delegated to `systemctl status` (which exits non-zero there).
    if [ -n "$script" ] && [ "$STATUS_LOAD" = "not-found" ]; then
      printf 'error: %s.timer not found (not installed?)\n' "$unit" >&2
      exit 1
    fi
    rows+=("$unit$TAB${STATUS_STATE:---}$TAB${STATUS_LAST:---}$TAB${STATUS_NEXT:---}$TAB${STATUS_INSTALL:---}")
  done

  # The TAB-separated fields are IFS-split on read, which is only safe while every field is
  # non-empty — hence the :--- defaults on all five.
  local row u s l n i
  if [ "$json" = true ]; then
    printf '['
    local first=true
    for row in "${rows[@]}"; do
      IFS="$TAB" read -r u s l n i <<<"$row"
      "$first" || printf ','
      first=false
      jq -nc --arg u "$u" --arg s "$s" --arg l "$l" --arg n "$n" --arg i "$i" \
        '{unit:$u, state:$s, last:$l, next:$n, install:$i}'
    done
    printf ']\n'
  else
    printf '%-30s %-10s  %-22s  %-17s  %s\n' "UNIT" "STATE" "LAST" "NEXT" "INSTALL"
    for row in "${rows[@]}"; do
      IFS="$TAB" read -r u s l n i <<<"$row"
      printf '%-30s %-10s  %-22s  %-17s  %s\n' "$u" "$s" "$l" "$n" "$i"
    done
  fi

  if [ "$STATUS_FAILED" -ne 0 ]; then exit 1; fi
}

cmd_logs() {
  local name
  name="$(unit_name "$1")"
  journalctl --user -u "$name.service" -f
}

case "${1:-}" in
  __unit_name)
    [ -z "${2:-}" ] && exit 1
    unit_name "$2"
    exit 0
    ;;
  install)
    [ -z "${2:-}" ] && {
      printf 'error: install requires a script name\n' >&2
      exit 1
    }
    script="$2"
    shift 2
    interval="15min"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --interval)
          [ -z "${2:-}" ] && {
            printf 'error: --interval requires a value\n' >&2
            exit 1
          }
          interval="$2"
          shift 2
          ;;
        *)
          printf 'error: unknown option: %s\n' "$1" >&2
          exit 1
          ;;
      esac
    done
    cmd_install "$script" "$interval"
    ;;
  uninstall)
    [ -z "${2:-}" ] && {
      printf 'error: uninstall requires a script name\n' >&2
      exit 1
    }
    cmd_uninstall "$2"
    ;;
  start)
    [ -z "${2:-}" ] && {
      printf 'error: start requires a script name\n' >&2
      exit 1
    }
    cmd_start "$2"
    ;;
  stop)
    [ -z "${2:-}" ] && {
      printf 'error: stop requires a script name\n' >&2
      exit 1
    }
    cmd_stop "$2"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  repoint)
    shift
    cmd_repoint "$@"
    ;;
  logs)
    [ -z "${2:-}" ] && {
      printf 'error: logs requires a script name\n' >&2
      exit 1
    }
    cmd_logs "$2"
    ;;
  *)
    printf 'Usage: shai-supervise install|uninstall|start|stop|repoint|status|logs [script] [options]\n' >&2
    exit 2
    ;;
esac
