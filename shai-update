#!/bin/bash
# shai-update — in-place shai upgrade, rollback, and version pruning
# Usage: shai-update [--check | --list | --rollback [VERSION] | --version V |
#        --prune --keep N [--dry-run]] [-y|--yes]
# Reads: $HOME/.local/share/shai/<version>/ install trees and .../current (the active one),
#   $HOME/.local/bin/shai* wrappers, installed systemd units (via shai-supervise repoint),
#   and gh release view/download in the network modes (default, --check, --version)
# Writes: a new version tree, the current symlink, ~/.local/bin wrappers, systemd
#   ExecStart lines (via shai-supervise repoint), and shell completions (via
#   shai-completions install); --prune removes old version trees, never current's target;
#   --check and --list write nothing
# Exit: 0 success (including already up to date, both --check verdicts, an aborted
#   prompt, nothing to prune); 1 failure (download/extract/rewrite error, unknown rollback
#   target, gh missing or unauthenticated); 2 usage error
set -euo pipefail

REPO="ChristopherBilg/shai"
INSTALL_DIR="${HOME}/.local/share/shai"
BIN_DIR="${HOME}/.local/bin"

mode_check=false
mode_list=false
mode_rollback=false
mode_prune=false
rollback_version=""
version_override=""
keep=""
dry_run=false
yes=false

while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode_check=true ;;
    --list) mode_list=true ;;
    --rollback)
      mode_rollback=true
      # The VERSION argument is optional: consume the next word only when it is not a flag.
      if [ -n "${2:-}" ] && [ "${2:0:1}" != "-" ]; then
        rollback_version="$2"
        shift
      fi
      ;;
    --version)
      [ -n "${2:-}" ] || {
        printf 'error: --version requires a version argument\n' >&2
        exit 2
      }
      version_override="$2"
      shift
      ;;
    --prune) mode_prune=true ;;
    --keep)
      [ -n "${2:-}" ] || {
        printf 'error: --keep requires a number\n' >&2
        exit 2
      }
      keep="$2"
      shift
      ;;
    --dry-run) dry_run=true ;;
    -y | --yes) yes=true ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

# One mode per run: --check, --list, --rollback, and --prune are mutually exclusive,
# and --version/--keep/--dry-run only make sense in their documented combinations.
modes=0
for m in "$mode_check" "$mode_list" "$mode_rollback" "$mode_prune"; do
  if [ "$m" = true ]; then modes=$((modes + 1)); fi
done
if [ "$modes" -gt 1 ]; then
  printf 'error: --check, --list, --rollback, and --prune are mutually exclusive\n' >&2
  exit 2
fi
if [ -n "$version_override" ] && [ "$modes" -gt 0 ]; then
  printf 'error: --version cannot be combined with --check, --list, --rollback, or --prune\n' >&2
  exit 2
fi
if [ "$mode_prune" = false ] && { [ -n "$keep" ] || [ "$dry_run" = true ]; }; then
  printf 'error: --keep and --dry-run require --prune\n' >&2
  exit 2
fi
if [ "$mode_prune" = true ] && [ -z "$keep" ]; then
  printf 'error: --prune requires --keep N\n' >&2
  exit 2
fi

# require_gh: the network modes need an authenticated gh. Exit 1, not 2, even though
# install.sh exits 2 here: 2 is the suite-wide usage-error code (shai-ask, shai-workflow,
# shai-supervise), and a missing tool is a runtime failure, not a call-site mistake.
require_gh() {
  if ! command -v gh &>/dev/null; then
    printf 'error: gh CLI is required (https://cli.github.com)\n' >&2
    exit 1
  fi
  if ! gh auth status &>/dev/null; then
    printf 'error: gh CLI is not authenticated — run: gh auth login\n' >&2
    exit 1
  fi
}

# version_dirs: the version directory names under $INSTALL_DIR, oldest first. The
# `current` symlink entry itself is excluded; an absent install dir yields nothing.
version_dirs() {
  local d n
  for d in "$INSTALL_DIR"/*/; do
    [ -e "$d" ] || continue
    n="${d%/}"
    n="${n##*/}"
    [ "$n" = "current" ] && continue
    printf '%s\n' "$n"
  done | LC_ALL=C sort
}

# current_name: the version current points at ("" when current is missing or dangling).
current_name() {
  local resolved=""
  if [ -L "$INSTALL_DIR/current" ]; then
    resolved="$(readlink -f "$INSTALL_DIR/current" 2>/dev/null || true)"
  fi
  printf '%s' "${resolved##*/}"
}

# current_version: the version shai-version reports through current, falling back to the
# release VERSION file for trees predating the script, then the literal "none".
current_version() {
  local v=""
  if [ -x "$INSTALL_DIR/current/shai-version" ]; then
    v="$("$INSTALL_DIR/current/shai-version" 2>/dev/null || true)"
  elif [ -s "$INSTALL_DIR/current/VERSION" ]; then
    v="$(cat "$INSTALL_DIR/current/VERSION" 2>/dev/null || true)"
  fi
  printf '%s' "${v:-none}"
}

# validate_version: mirror install.sh's guard — a version containing / or .. would
# escape the install directory. A bad value is a failure (1), not a usage error.
validate_version() {
  case "$1" in
    */* | *..*)
      printf 'error: version must not contain / or .. (got "%s")\n' "$1" >&2
      exit 1
      ;;
  esac
}

# latest_version: the newest GitHub Release tag, via gh.
latest_version() {
  local v
  if ! v=$(gh release view --repo "$REPO" --json tagName --jq '.tagName' 2>/dev/null); then
    printf 'error: could not resolve the latest release\n' >&2
    exit 1
  fi
  printf '%s' "$v"
}

# switch_to <version>: the shared re-pointing sequence — the current symlink, the wrapper
# rewrite, the systemd repoint, and the completion reinstall. The upgrade runs it after
# extraction; --rollback runs it alone. Unlike install.sh's best-effort completions, every
# step here is on the critical path: a failure must fail the run rather than leave
# wrappers or units disagreeing with current.
switch_to() {
  local version="$1" script wrapper target escaped

  # Self-update safety: this script may itself be executing through $INSTALL_DIR/current
  # (the wrapper execs that path), so this re-points the symlink the process came from.
  # That is safe: bash holds an open file descriptor on the old inode, and old version
  # directories are never deleted by shai-update — the second, independent reason --prune
  # is explicit rather than automatic. The temp name + `mv -Tf` dance is load-bearing in
  # the same way as install.sh's: without -T, replacing an existing current
  # symlink-to-directory would move the temp link *inside* the pointed-to directory
  # instead of over the link. The link target is relative so the tree stays relocatable.
  ln -sfn "$version" "$INSTALL_DIR/.current.$$"
  mv -Tf "$INSTALL_DIR/.current.$$" "$INSTALL_DIR/current"

  # Wrapper rewrite (idempotent; heals pre-current installs): the same bytes install.sh
  # writes, so the two installers cannot drift apart (asserted in tests/test_update.sh).
  mkdir -p "$BIN_DIR"
  for script in "$INSTALL_DIR/$version"/shai-*; do
    if [ -f "$script" ] && [ -x "$script" ]; then
      wrapper="$BIN_DIR/$(basename "$script")"
      target="$INSTALL_DIR/current/$(basename "$script")"
      escaped="${target//\'/\'\\\'\'}"
      printf "#!/bin/bash\nexec '%s' \"\$@\"\n" "$escaped" >"$wrapper"
      chmod +x "$wrapper"
    fi
  done

  # The two steps below MUST invoke through current, never a versioned path. Running
  # "$INSTALL_DIR/v2026.09.01/shai-supervise" would give that process
  # $DIR=.../v2026.09.01 and it would write *versioned* ExecStart lines — reintroducing
  # the exact defect this layout exists to remove. Through current, $DIR is
  # $INSTALL_DIR/current (bash does not resolve the symlink when cd'ing), so repoint
  # writes version-independent paths, and cmd_repoint itself refuses versioned
  # invocations. tests/test_update.sh asserts every unit's ExecStart contains /current/
  # and no version string after an upgrade — the explicit regression test for this trap.
  if ! "$INSTALL_DIR/current/shai-supervise" repoint --all; then
    printf 'error: shai-supervise repoint --all failed\n' >&2
    exit 1
  fi
  if ! "$INSTALL_DIR/current/shai-completions" install zsh; then
    printf 'error: shai-completions install zsh failed\n' >&2
    exit 1
  fi
  if ! "$INSTALL_DIR/current/shai-completions" install bash; then
    printf 'error: shai-completions install bash failed\n' >&2
    exit 1
  fi
}

cmd_list() {
  local current dirs=() n
  current="$(current_name)"
  mapfile -t dirs < <(version_dirs)
  for n in "${dirs[@]}"; do
    if [ "$n" = "$current" ]; then
      printf '%s (current)\n' "$n"
    else
      printf '%s\n' "$n"
    fi
  done
}

cmd_rollback() {
  local version="${1:-}" current prev dirs=() n
  current="$(current_name)"
  if [ -n "$version" ]; then
    if [ ! -d "$INSTALL_DIR/$version" ]; then
      printf 'error: version %s is not installed\n' "$version" >&2
      exit 1
    fi
  else
    # The previous version: the newest installed version that is not current's target
    # (dirs arrive oldest first, so the last non-current one wins).
    prev=""
    mapfile -t dirs < <(version_dirs)
    for n in "${dirs[@]}"; do
      if [ "$n" != "$current" ]; then
        prev="$n"
      fi
    done
    if [ -z "$prev" ]; then
      printf 'error: no previous version to roll back to\n' >&2
      exit 1
    fi
    version="$prev"
  fi
  printf 'rolling back to %s\n' "$version"
  switch_to "$version"
  printf 'rolled back to %s\n' "$version"
  printf '  Current: %s/current -> %s\n' "$INSTALL_DIR" "$version"
}

cmd_prune() {
  local keep="$1" dry_run="$2" current dirs=() others=0 to_remove seen=0 removed=0 n
  case "$keep" in
    '' | *[!0-9]*)
      printf 'error: --keep requires a positive integer (got "%s")\n' "$keep" >&2
      exit 2
      ;;
  esac
  if [ "$keep" -lt 1 ]; then
    printf 'error: --keep requires a positive integer (got "%s")\n' "$keep" >&2
    exit 2
  fi

  current="$(current_name)"
  mapfile -t dirs < <(version_dirs)
  for n in "${dirs[@]}"; do
    [ "$n" = "$current" ] || others=$((others + 1))
  done
  if [ "$others" -le "$keep" ]; then
    printf 'nothing to prune\n'
    exit 0
  fi
  # Remove the oldest (others - keep) versions that current does not point at. A version
  # directory is ~1.3MB, so pruning is a manual choice (shai-prune is manual retention
  # too, and gap-analysis.md lists auto-retention under Deliberately Excluded); keeping
  # current's target unconditionally is what keeps in-flight runs and rollback safe.
  to_remove=$((others - keep))
  for n in "${dirs[@]}"; do
    if [ "$n" = "$current" ]; then
      continue
    fi
    if [ "$seen" -lt "$to_remove" ]; then
      if [ "$dry_run" = true ]; then
        printf 'would remove %s\n' "$INSTALL_DIR/$n"
      else
        printf 'removing %s\n' "$INSTALL_DIR/$n"
        # :? keeps shellcheck's never-rm-/ invariant explicit: an empty INSTALL_DIR
        # would make this expand to a bare slash.
        rm -rf "${INSTALL_DIR:?}/$n"
      fi
      removed=$((removed + 1))
    fi
    seen=$((seen + 1))
  done
  if [ "$dry_run" = true ]; then
    printf '%d version(s) would be removed (dry run)\n' "$removed"
  else
    printf 'removed %d version(s)\n' "$removed"
  fi
}

cmd_check() {
  local target="$1" cur
  cur="$(current_version)"
  if [ "$cur" = "$target" ]; then
    printf 'up to date (%s)\n' "$cur"
  elif [ "$cur" = "none" ]; then
    printf 'update available: none -> %s\n' "$target"
  else
    printf 'update available: %s -> %s\n' "$cur" "$target"
  fi
}

cmd_upgrade() {
  local version="$1" cur answer tmp
  cur="$(current_version)"

  if [ "$cur" = "$version" ]; then
    printf 'already up to date (%s)\n' "$version"
    exit 0
  fi

  # The prompt reads stdin, so unattended use opts in with -y/--yes (or a piped `y`);
  # an empty/EOF answer aborts with nothing changed. Like shai-prune's confirmation,
  # a declined upgrade is a successful no-op, not an error.
  if [ "$yes" = false ]; then
    if [ "$cur" = "none" ]; then
      printf 'Install shai %s? [y/N] ' "$version"
    else
      printf 'Upgrade shai %s -> %s? [y/N] ' "$cur" "$version"
    fi
    answer=""
    read -r answer || answer=""
    case "$answer" in
      y | Y | yes | YES) ;;
      *)
        printf 'aborted\n'
        exit 0
        ;;
    esac
  fi

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT

  printf 'Downloading shai %s...\n' "$version"
  if ! gh release download "$version" --repo "$REPO" \
    --pattern "shai-${version}.tar.gz" --dir "$tmp"; then
    printf 'error: failed to download shai %s\n' "$version" >&2
    exit 1
  fi
  if ! tar xzf "$tmp/shai-${version}.tar.gz" \
    -C "$tmp" --strip-components=1; then
    printf 'error: failed to extract shai %s\n' "$version" >&2
    exit 1
  fi
  rm -f "$tmp/shai-${version}.tar.gz"

  # Ordering: the extraction above completes before the directory is moved into the
  # install tree and before current is re-pointed, so current can never point at a
  # partial extraction. If the run dies after the re-point, current is already valid
  # and every old directory remains on disk, so --rollback is always available. The
  # rm -rf only ever targets the version being (re)installed, never an old one.
  mkdir -p "$INSTALL_DIR"
  rm -rf "${INSTALL_DIR:?}/$version"
  mv "$tmp" "$INSTALL_DIR/$version"
  trap - EXIT

  switch_to "$version"

  printf '\nshai %s installed successfully\n' "$version"
  printf '  Files:    %s/\n' "$INSTALL_DIR/$version"
  printf '  Current:  %s/current -> %s\n' "$INSTALL_DIR" "$version"
  if [ "$cur" != "none" ]; then
    printf '  Previous: %s retained (rollback: shai-update --rollback)\n' "$cur"
  fi
  printf '  Wrappers: %s/\n' "$BIN_DIR"
}

if [ "$mode_list" = true ]; then
  cmd_list
  exit 0
fi
if [ "$mode_rollback" = true ]; then
  cmd_rollback "$rollback_version"
  exit 0
fi
if [ "$mode_prune" = true ]; then
  cmd_prune "$keep" "$dry_run"
  exit 0
fi

# Network modes: --check and the default upgrade (with or without --version).
require_gh

if [ -n "$version_override" ]; then
  validate_version "$version_override"
  target="$version_override"
else
  target="$(latest_version)"
  validate_version "$target"
fi

if [ "$mode_check" = true ]; then
  cmd_check "$target"
  exit 0
fi

cmd_upgrade "$target"
