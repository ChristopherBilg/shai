#!/bin/bash
# shai-repl — REPL/orchestrator: seed the system prompt, then delegate the eval+dispatch loop to shai-loop
# Usage: shai-repl [-q|--quiet]   (interactive; reads prompts until exit/quit/EOF)
# Reads: interactive prompt lines on stdin (or piped input); when stdin is a TTY, past prompts
#        from $SHAI_HOME/history to seed readline's in-session history; SHAI_SESSION_ID /
#        SHAI_SCHEMA_VERSION from the environment if already set (an inherited session id is
#        never overwritten); SHAI_MODEL when explicitly set (shown in the startup banner)
# Writes: a one-line startup banner on stdout when stdout is a TTY (version/session/model; not
#         suppressed by -q/--quiet), "Goodbye." on exit/quit/EOF, and accepted prompts appended
#         to $SHAI_HOME/history (one per line, plain text) when stdin is a TTY; assistant turns
#         via shai-loop, whose human-readable stderr is redirected to shai-repl's stdout (tool
#         dispatches shown by default; -q/--quiet hides them) with a blank line between turns;
#         shai-loop buffers events in $SHAI_HOME/runs/<run_id>/events.jsonl during a turn, then
#         commits finalized events to $SHAI_HOME/sessions/$SHAI_SESSION_ID.jsonl on success
# Exit: 0 on clean exit (exit/quit/EOF) and on any handled Ctrl-C — at the prompt the line is
#       cleared and the session continues; mid-turn the in-flight turn is aborted with an
#       Interrupted. notice and the session continues (a handled interrupt never changes the
#       exit status; when the runs dir is writable the notice adds a "partial turn kept in
#       run <id> — resume with: shai-retry --run <id>" hint — the aborted turn's events stay
#       in its run log, never the session log); 1 if DEEPSEEK_API_KEY is missing (health
#       check); 2 on unknown option; 3 if the system prompt is missing or empty (shai-prompt)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

LOOP_QUIET_FLAG=""
case "${1:-}" in
  -q | --quiet) LOOP_QUIET_FLAG="--quiet" ;;
  -*)
    printf 'shai-repl: unknown option: %s\n' "$1" >&2
    printf 'Usage: shai-repl [-q|--quiet]\n' >&2
    exit 2
    ;;
esac

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
# The system prompt is authored content, not code: it lives in prompts/system.txt and is
# loaded via shai-prompt, which fails loudly (exit 3) if the file is missing or empty. Under
# `set -e` that aborts before we ever seed a blank system turn into the session.
SYSTEM_PROMPT="$("$DIR/shai-prompt" system)"

TOOLS_FILE=$(mktemp)
chmod u+w "$TOOLS_FILE"
trap 'rm -f "$TOOLS_FILE"' EXIT
# SIGINT handling (see #299): Ctrl-C must never end the session. One INT trap for the whole
# script sets a flag that the prompt loop interprets: at the prompt bash aborts the blocked
# `read` and runs this trap (the flag, not read's status, is what distinguishes ^C from
# EOF/Ctrl-D), and mid-turn the terminal's SIGINT to the whole foreground process group kills
# the shai-loop pipeline, after which bash runs the trap. The flag is reset at the top of
# every loop iteration so it only ever describes the read/pipeline about to run.
interrupted=0
trap 'interrupted=1' INT
"$DIR/shai-tools" >"$TOOLS_FILE"

# mint_id <prefix> — UTC-sortable id with 4 urandom bytes for collision resistance
mint_id() {
  printf '%s_%s_%s' "$1" "$(date -u +%Y%m%dT%H%M%S)" "$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
}

# an inherited SHAI_SESSION_ID always wins: an nvim/tmux/cron wrapper owns the session
SHAI_SESSION_ID="${SHAI_SESSION_ID:-$(mint_id sess)}"
if [[ "$SHAI_SESSION_ID" =~ [/] ]] || [[ "$SHAI_SESSION_ID" == *..* ]]; then
  printf 'error: SHAI_SESSION_ID must not contain / or .. (got "%s")\n' "$SHAI_SESSION_ID" >&2
  exit 1
fi
export SHAI_SESSION_ID
export SHAI_SCHEMA_VERSION="${SHAI_SCHEMA_VERSION:-1.0}"

SESSIONS_DIR="$STATE_DIR/sessions"
SESSION_LOG="$SESSIONS_DIR/$SHAI_SESSION_ID.jsonl"

# a run and span are minted per turn and must never be inherited: the system prompt is seeded
# outside any turn, so it has to stamp with a null run/span
export SHAI_RUN_ID=""
export SHAI_SPAN_ID=""
export SHAI_PARENT_SPAN_ID=""

if ! "$DIR/shai-eval" --health-check; then
  printf "hint: run '%s/shai-doctor' for a full environment check (jq/curl, config, and this API key)\n" "$DIR" >&2
  exit 1
fi

mkdir -p "$SESSIONS_DIR"

if [ ! -s "$SESSION_LOG" ]; then
  # stamped with the session but no run/span: seeding happens outside any turn
  printf '%s' "$SYSTEM_PROMPT" | "$DIR/shai-read" --system | "$DIR/shai-stamp" >>"$SESSION_LOG"
fi

# one-line startup banner, stdout TTY only ([ -t 1 ]): version + session + model when SHAI_MODEL
# is explicitly set. It is startup info, not per-turn dispatch noise, so -q/--quiet does not
# suppress it. The deepseek-v4-flash default is never synthesized here — constants-sync.sh keeps
# that default in sync across shai-eval/CLAUDE.md/shai-doctor, and a third copy would drift.
if [ -t 1 ]; then
  printf 'shai %s — session %s%s — type %s\n' \
    "$("$DIR/shai-version")" "$SHAI_SESSION_ID" \
    "${SHAI_MODEL:+ — model $SHAI_MODEL}" "'exit' to quit"
fi

# Readline editing + persistent prompt history (#298). Gated on stdin being a TTY: `read -e`
# provides line editing (Ctrl-W/Ctrl-U), in-session up/down-arrow history, and Ctrl-R reverse
# search, and the history builtin (history -r to seed, -s/-a per accepted prompt) persists
# prompts to $SHAI_HOME/history (one per line, plain text) so they survive across launches.
# Piped stdin keeps the plain `read -r` loop and never touches the history file — scripted/CI
# input behaves exactly as before.
READ_EDIT=""
if [ -t 0 ]; then
  READ_EDIT="-e"
  HISTORY_FILE="$STATE_DIR/history"
  # seed readline with past prompts; no file on the very first launch
  history -r "$HISTORY_FILE" 2>/dev/null || true
fi

while :; do
  # the flag only ever describes the read/pipeline about to run — a stale interrupt (e.g. one
  # that landed between turns or during startup) must not masquerade as this iteration's EOF
  interrupted=0

  # read fails on EOF (Ctrl-D, or end of piped input) and on ^C at the prompt. The INT trap
  # separates them: flag set ⇒ ^C ⇒ clear the line and stay at the prompt, session continues;
  # flag unset ⇒ EOF (a piped final line without a trailing newline still falls through and
  # gets processed below). read's status is deliberately not consulted: with plain read ^C
  # returns 130, but with `read -e` (TTY only) Readline swallows ^C and read returns a
  # plain 1 — the flag is the only signal that works in both worlds.
  if ! read -r ${READ_EDIT:+"$READ_EDIT"} -p "> " line; then
    if [ "$interrupted" = 1 ]; then
      printf '\n' # move past the echoed ^C; the next prompt redraws the line
      continue
    fi
    [ -n "$line" ] || break
  fi

  case "$line" in
    "") continue ;;
    exit | quit) break ;;
  esac

  # TTY only: persist the accepted prompt for the next launch and keep it in readline's
  # in-memory history for the rest of this session. `read -e` does NOT add lines to the
  # history list in non-interactive bash (verified on bash 5.2.21: the history option is off
  # and the list stays empty), so `history -s` adds the line explicitly; `history -a` then
  # appends only the lines added since the last append, keeping $SHAI_HOME/history at one
  # prompt per line. Blank lines are skipped above and exit/quit break before this point, so
  # neither is recorded. Best-effort (|| true): an unwritable or missing $STATE_DIR must
  # never abort the REPL.
  if [ -n "$READ_EDIT" ]; then
    history -s "$line" 2>/dev/null || true
    history -a "$HISTORY_FILE" 2>/dev/null || true
  fi

  # a run is one user turn; shai-loop mints/advances spans and manages the run log internally.
  # 2>&1 >/dev/null sends shai-loop's stderr (its human-readable shai-print output) to shai-repl's
  # stdout (the terminal), and discards shai-loop's actual stdout (the final event JSON, which
  # the interactive REPL has no use for).
  SHAI_RUN_ID="$(mint_id run)"
  export SHAI_RUN_ID

  # The if/else (not a bare statement) absorbs the pipeline's 130 status without tripping
  # set -e: a mid-turn ^C delivers SIGINT to the whole foreground process group — nothing in
  # the shai-loop pipeline traps it — and bash runs the INT trap once the pipeline completes,
  # so flag set + non-zero rc is an interrupted turn, not a crash. Any other failure keeps the
  # old behavior (the REPL exits with the pipeline's status).
  # shellcheck disable=SC2069  # the swap (stderr to old stdout, then stdout to /dev/null) is deliberate, not a mis-ordered redirect
  if printf '%s\n' "$line" | "$DIR/shai-loop" --tools-file "$TOOLS_FILE" ${LOOP_QUIET_FLAG:+"$LOOP_QUIET_FLAG"} 2>&1 >/dev/null; then
    :
  else
    rc=$?
    if [ "$interrupted" = 1 ]; then
      # the aborted turn's events were buffered in runs/<run_id>/events.jsonl (buffer-then-
      # commit) and never reached the session log. When the runs dir is writable the run stays
      # intact for shai-trace and shai-retry --run, so the notice points at it; when it is
      # unwritable shai-loop fell back to RUN_LOG=/dev/null (no run log at all), so the hint
      # is only printed when the log actually exists — otherwise it would promise a resume
      # that shai-retry cannot deliver ("run log not found")
      printf 'Interrupted.\n'
      if [ -f "$STATE_DIR/runs/$SHAI_RUN_ID/events.jsonl" ]; then
        printf 'partial turn kept in run %s — resume with: shai-retry --run %s\n' "$SHAI_RUN_ID" "$SHAI_RUN_ID"
      fi
    else
      exit "$rc"
    fi
  fi

  # one blank line after every completed turn (normal, error, or interrupted) separates it from
  # the next prompt. Unconditional: exit/quit break before this, so the goodbye follows the last
  # prompt directly; only on EOF (Ctrl-D, or piped input without exit) does the goodbye follow
  # this separator — the intended trade-off per #300's "keep it unconditional" instruction.
  printf '\n'
done

# exit/quit and EOF (Ctrl-D) all land here: one goodbye, printed once, on stdout
printf "Goodbye.\n"
