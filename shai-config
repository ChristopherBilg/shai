#!/bin/bash
# shai-config — edit and test shai configuration: policy rules and CI checks
# Usage: shai-config policy list|add|remove|test / ci list|add|remove [options]
#        shai-config policy add --tool NAME --action ACTION [--args K=V ...] [--before N] [--force]
#        shai-config ci add --name NAME --command CMD [--timeout SECONDS] [--env K=V ...] [--repo KEY]
# Reads: $SHAI_HOME/policy.json; $SHAI_POLICY_OVERLAY; lib/policy.sh (check_policy, the single
#        source of verdicts); $SHAI_HOME/ci.json; lib/git-remote.sh (normalize_url, the repo-key
#        normalizer tools/ci/run.sh reads ci.json by — shared, never reimplemented); the cwd's
#        origin remote (ci list/add/remove, unless --repo overrides)
# Writes: $SHAI_HOME/policy.json (policy add/remove); $SHAI_HOME/ci.json (ci add/remove); each
#         via a temp file + mv — never a partial write, never a replacement of a corrupt file
# Exit: 0 on success; 1 on validation failure (shadow refusal, corrupt policy or ci config,
#        unknown index or check, invalid values, no git remote); 2 on usage error (unknown
#        noun/verb/flag)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
POLICY_FILE="$STATE_DIR/policy.json"
CONFIG_FILE="$STATE_DIR/ci.json"

# `policy test` verdicts must come from the same function shai-dispatch calls
# (lib/policy.sh), never a reimplementation — one function, two callers. The ci half
# sources lib/git-remote.sh for the same reason: the repo key is computed by the same
# normalize_url tools/ci/run.sh looks ci.json entries up with, so a key written here is
# provably the key read there. Both libs run `set -uo pipefail` when sourced so they never
# tighten a caller's options; this script's contract is plain `set -euo pipefail`, so
# re-apply it right after the sources.
# shellcheck source=lib/policy.sh
source "$DIR/lib/policy.sh"
# shellcheck source=lib/git-remote.sh
source "$DIR/lib/git-remote.sh"
set -euo pipefail

# usage_error: print the usage block to stderr and exit 2 (usage error — unknown
# noun/verb/flag, or a missing required option; invalid values exit 1 instead).
usage_error() {
  printf 'usage: shai-config <policy|ci> <command> [options]\n' >&2
  printf '       shai-config policy list [--json]\n' >&2
  printf '       shai-config policy add --tool NAME --action ACTION [--args K=V ...] [--before N] [--force]\n' >&2
  printf '       shai-config policy remove <index>\n' >&2
  printf '       shai-config policy test --tool NAME --input JSON [--overlay PATH] [--json]\n' >&2
  printf '       shai-config ci list [--repo KEY] [--json]\n' >&2
  printf '       shai-config ci add --name NAME --command CMD [--timeout SECONDS] [--env K=V ...] [--repo KEY]\n' >&2
  printf '       shai-config ci remove <name> [--repo KEY]\n' >&2
  exit 2
}

# load_policy <path>: the policy file's JSON (compact, one line) on stdout. Exit 1 with a
# shai-doctor pointer on stderr when the file is not a JSON object with a .rules array —
# the corrupt-policy abort (issue #345): parse before writing, and never replace a corrupt
# file with a fresh {"rules":[]}, because that destroys the user's rules in response to the
# very failure this tool exists to prevent.
load_policy() {
  local path="$1" parsed
  if [ ! -f "$path" ]; then
    printf 'error: no policy file at %s\n' "$path" >&2
    return 1
  fi
  if ! parsed=$(jq -c '
      if type == "object" and ((.rules // []) | type) == "array" then .
      else error("policy must be a JSON object with a .rules array")
      end' "$path" 2>/dev/null); then
    printf 'error: %s is not a valid policy (must be a JSON object with a .rules array)\n' "$path" >&2
    printf 'error: run shai-doctor to diagnose the policy file — nothing was changed\n' >&2
    return 1
  fi
  printf '%s' "$parsed"
}

# file_mode <path>: echo the file's octal permission bits, or nothing when unavailable.
# GNU coreutils and BSD/macOS stat disagree on flags, so try both (the repo targets both).
# Always returns 0: the caller assigns via command substitution, and a non-zero status
# there would abort the script under `set -e`.
file_mode() {
  local mode high low
  if mode=$(stat -c '%a' "$1" 2>/dev/null); then
    printf '%s' "$mode"
  elif high=$(stat -f '%Mp' "$1" 2>/dev/null) && low=$(stat -f '%Lp' "$1" 2>/dev/null); then
    while [ "${#low}" -lt 3 ]; do low="0$low"; done
    printf '%s%s' "$high" "$low"
  fi
  return 0
}

# write_policy <json>: atomically replace $STATE_DIR/policy.json — temp file + mv, the
# shai-completions install pattern. A failed write never leaves a truncated policy behind
# and never destroys the existing one. An existing file's permission bits are preserved
# across the replacement: mktemp creates the temp file 0600 and mv would otherwise carry
# that mode onto the policy, silently tightening a hand-edited 0644 file. A brand-new
# policy keeps the temp file's 0600 (the conservative default for a file the user never
# created).
write_policy() {
  local tmp mode=""
  if [ -f "$POLICY_FILE" ]; then
    mode=$(file_mode "$POLICY_FILE")
  fi
  if ! mkdir -p "$STATE_DIR"; then
    printf 'error: cannot create state directory %s\n' "$STATE_DIR" >&2
    return 1
  fi
  if ! tmp=$(mktemp "$STATE_DIR/.policy.json.XXXXXX"); then
    printf 'error: cannot write %s\n' "$POLICY_FILE" >&2
    return 1
  fi
  if ! printf '%s\n' "$1" >"$tmp"; then
    rm -f "$tmp"
    printf 'error: cannot write %s\n' "$POLICY_FILE" >&2
    return 1
  fi
  if [ -n "$mode" ] && ! chmod "$mode" "$tmp"; then
    rm -f "$tmp"
    printf 'error: cannot write %s\n' "$POLICY_FILE" >&2
    return 1
  fi
  if ! mv "$tmp" "$POLICY_FILE"; then
    rm -f "$tmp"
    printf 'error: cannot write %s\n' "$POLICY_FILE" >&2
    return 1
  fi
}

# cmd_list: read-only view of the effective stack — overlay rules first (check_policy
# consults them first at dispatch time), then base rules, each with its per-file 1-based
# index (the index `remove` consumes, and the index `rule:<file>:<idx>` reasons report).
# A FILE column is appended only when an overlay is active; the `default:` line shows the
# effective default (overlay default first, matching check_policy).
cmd_list() {
  local JSON=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) JSON=true ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        usage_error
        ;;
    esac
    shift
  done

  local overlay="${SHAI_POLICY_OVERLAY:-}"
  local has_base=false has_overlay=false
  if [ -f "$POLICY_FILE" ]; then has_base=true; fi
  if [ -n "$overlay" ] && [ -f "$overlay" ]; then has_overlay=true; fi

  if [ "$has_base" = false ] && [ "$has_overlay" = false ]; then
    if [ "$JSON" = true ]; then
      printf '{"rules":[],"default":null,"default_file":null}\n'
    else
      printf '(no policy files)\n'
    fi
    return 0
  fi

  local base_json="" overlay_json=""
  if "$has_base"; then
    base_json=$(load_policy "$POLICY_FILE") || exit 1
  fi
  if "$has_overlay"; then
    overlay_json=$(load_policy "$overlay") || exit 1
  fi

  # Effective default: overlay first, exactly like check_policy's fallback consultation.
  local have_default=false default="" default_file=""
  if "$has_overlay"; then
    if printf '%s' "$overlay_json" | jq -e 'has("default")' >/dev/null 2>&1; then
      default=$(printf '%s' "$overlay_json" | jq -r '.default')
      default_file="$overlay"
      have_default=true
    fi
  fi
  if [ "$have_default" = false ] && "$has_base"; then
    if printf '%s' "$base_json" | jq -e 'has("default")' >/dev/null 2>&1; then
      default=$(printf '%s' "$base_json" | jq -r '.default')
      default_file="$POLICY_FILE"
      have_default=true
    fi
  fi

  # rows(): emit one compact row object per rule, overlay first then base, in consultation
  # order. Indexes are per-file (the .key+1 the matcher itself reports), so a base rule and
  # an overlay rule can both show index 1 — the FILE column tells them apart.
  rows() {
    if "$has_overlay"; then
      printf '%s' "$overlay_json" | jq -c --arg file "$overlay" '
        (.rules // []) | to_entries[]
        | {index: (.key + 1), tool: .value.tool, action: .value.action,
           args: (.value.args // null), file: $file}'
    fi
    if "$has_base"; then
      printf '%s' "$base_json" | jq -c --arg file "$POLICY_FILE" '
        (.rules // []) | to_entries[]
        | {index: (.key + 1), tool: .value.tool, action: .value.action,
           args: (.value.args // null), file: $file}'
    fi
  }

  if [ "$JSON" = true ]; then
    local oj="null" bj="null" rules_json
    if "$has_overlay"; then oj="$overlay_json"; fi
    if "$has_base"; then bj="$base_json"; fi
    rules_json=$(jq -cn \
      --argjson o "$oj" --argjson b "$bj" \
      --arg of "$overlay" --arg bf "$POLICY_FILE" '
        def rs($p; $f):
          if $p == null then []
          else ($p.rules // []) | to_entries
            | map({index: (.key + 1), tool: .value.tool, action: .value.action,
                   args: (.value.args // null), file: $f})
          end;
        {rules: (rs($o; $of) + rs($b; $bf)), default: null, default_file: null}')
    if "$have_default"; then
      rules_json=$(printf '%s' "$rules_json" | jq -c --arg d "$default" --arg f "$default_file" \
        '.default = $d | .default_file = $f')
    fi
    printf '%s\n' "$rules_json"
    return 0
  fi

  local row idx tool action args file rule_count=0
  if "$has_overlay"; then
    printf ' IDX  ACTION  TOOL           FILE\n'
  else
    printf ' IDX  ACTION  TOOL\n'
  fi
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    idx=$(printf '%s' "$row" | jq -r '.index')
    tool=$(printf '%s' "$row" | jq -r '.tool')
    action=$(printf '%s' "$row" | jq -r '.action')
    args=$(printf '%s' "$row" | jq -cr '.args // ""')
    file=$(printf '%s' "$row" | jq -r '.file')
    printf ' %2s  %-6s  %-13s' "$idx" "$action" "$tool"
    if [ -n "$args" ]; then printf '  %s' "$args"; fi
    if "$has_overlay"; then printf '  %s' "$file"; fi
    printf '\n'
    rule_count=$((rule_count + 1))
  done < <(rows)
  if [ "$rule_count" -eq 0 ]; then
    printf '(no rules)\n'
  fi
  if "$have_default"; then
    printf 'default: %s\n' "$default"
  else
    printf 'default: (none)\n'
  fi
}

# cmd_add: append a rule to $SHAI_HOME/policy.json (default: append; --before N inserts at
# 0-based array position N). Refuses — writing nothing — when an earlier rule for the same
# tool has no `args` key (or a hand-edited empty args object, which check_policy's
# `to_entries | all` also treats as matching every call) and therefore decides every call
# to that tool (first-match-wins, so the new rule could never fire). Those are the
# exactly-decidable shadow cases only: no glob-subsumption reasoning, per issue #345.
# --force appends anyway.
cmd_add() {
  local TOOL="" ACTION="" BEFORE="" FORCE=false
  local -a ARG_PAIRS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --tool)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --tool requires a name\n' >&2
          exit 2
        fi
        TOOL="$1"
        ;;
      --action)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --action requires a value\n' >&2
          exit 2
        fi
        ACTION="$1"
        ;;
      --args)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --args requires K=V\n' >&2
          exit 2
        fi
        ARG_PAIRS+=("$1")
        ;;
      --before)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --before requires an index\n' >&2
          exit 2
        fi
        BEFORE="$1"
        ;;
      --force) FORCE=true ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        usage_error
        ;;
    esac
    shift
  done

  if [ -z "$TOOL" ]; then
    printf 'error: --tool is required\n' >&2
    usage_error
  fi
  if [ -z "$ACTION" ]; then
    printf 'error: --action is required\n' >&2
    usage_error
  fi
  if [ "$ACTION" != "allow" ] && [ "$ACTION" != "prompt" ] && [ "$ACTION" != "deny" ]; then
    printf 'error: invalid action "%s" (expected allow/prompt/deny)\n' "$ACTION" >&2
    exit 1
  fi
  if [ -n "$BEFORE" ] && ! [[ "$BEFORE" =~ ^[0-9]+$ ]]; then
    printf 'error: --before must be a non-negative integer (got "%s")\n' "$BEFORE" >&2
    exit 1
  fi
  # Leading-zero forms pass the digit check ("09", "00") but break everything downstream:
  # bash arithmetic reads "09" as an invalid octal and jq's JSON grammar rejects leading
  # zeros, so the user would get a raw jq error instead of the documented exit-1 validation
  # failure. Normalize to a plain decimal here.
  if [ -n "$BEFORE" ]; then
    BEFORE=$((10#$BEFORE))
  fi
  local pair
  for pair in "${ARG_PAIRS[@]}"; do
    case "$pair" in
      ?*=*) ;;
      *)
        printf 'error: --args expects K=V with a non-empty key (got "%s")\n' "$pair" >&2
        exit 1
        ;;
    esac
  done
  # from_entries silently keeps the last of duplicate keys, so `--args k=A --args k=B`
  # would discard A and write only B — refuse the pair instead of letting a pattern vanish.
  local i j
  for ((i = 0; i < ${#ARG_PAIRS[@]}; i++)); do
    for ((j = i + 1; j < ${#ARG_PAIRS[@]}; j++)); do
      if [ "${ARG_PAIRS[i]%%=*}" = "${ARG_PAIRS[j]%%=*}" ]; then
        printf 'error: duplicate --args key "%s" (each key may appear once)\n' "${ARG_PAIRS[i]%%=*}" >&2
        exit 1
      fi
    done
  done

  # Parse before writing: a corrupt existing file aborts here, byte-identical. An absent
  # file starts fresh as {"rules":[]} (the documented creation behavior).
  local policy
  if [ -f "$POLICY_FILE" ]; then
    policy=$(load_policy "$POLICY_FILE") || exit 1
  else
    policy='{"rules":[]}'
  fi

  # Insertion position: 0-based index into .rules; the default is append (position == length).
  local len pos
  len=$(printf '%s' "$policy" | jq -r '(.rules // []) | length')
  if [ -n "$BEFORE" ]; then
    pos="$BEFORE"
    if [ "$pos" -gt "$len" ]; then
      printf 'error: --before %s is out of range (policy has %s rule(s))\n' "$pos" "$len" >&2
      exit 1
    fi
  else
    pos="$len"
  fi

  # Rule values for --args are always glob patterns, i.e. strings — that is the deliberate
  # asymmetry with `policy test --input`, which takes arbitrary JSON including arrays. The
  # filter must precede --args: everything after --args is a positional string ($ARGS).
  local rule
  if [ "${#ARG_PAIRS[@]}" -gt 0 ]; then
    rule=$(jq -nc --arg tool "$TOOL" --arg action "$ACTION" \
      '{tool: $tool, action: $action,
        args: ($ARGS.positional
          | map({key: (split("=")[0]), value: (split("=")[1:] | join("="))})
          | from_entries)}' \
      --args "${ARG_PAIRS[@]}")
  else
    rule=$(jq -nc --arg tool "$TOOL" --arg action "$ACTION" \
      '{tool: $tool, action: $action}')
  fi

  # Shadow refusal: an earlier rule for the same tool with no `args` key — or a hand-edited
  # empty args object, on which check_policy's `to_entries | all` is vacuously true — decides
  # every call to that tool, so the new rule can never fire (first-match-wins). Scope
  # deliberately stops at those exactly-decidable cases; general pattern overlap is left to
  # `policy test`.
  local shadow_idx=""
  if [ "$FORCE" != true ]; then
    shadow_idx=$(printf '%s' "$policy" | jq -r --arg tool "$TOOL" --argjson pos "$pos" '
      [ ((.rules // []) | to_entries[]
         | select(.key < $pos)
         | select(.value.tool == $tool)
         | select((.value | has("args") | not)
                  or ((.value.args | type) == "object" and (.value.args | length) == 0))
         | .key)
      ][0] // empty')
    if [ -n "$shadow_idx" ]; then
      local shadow_rule
      shadow_rule=$(printf '%s' "$policy" | jq -c --argjson i "$shadow_idx" '(.rules // [])[$i]')
      printf 'error: rule would never match — rules[%s]\n' "$shadow_idx" >&2
      printf '  %s has no args (or an empty args object), so it decides every %s call\n' "$shadow_rule" "$TOOL" >&2
      printf '  (first-match-wins). Retry with --before %s, or --force to append anyway.\n' "$shadow_idx" >&2
      exit 1
    fi
  fi

  local new_policy
  new_policy=$(printf '%s' "$policy" | jq -c --argjson rule "$rule" --argjson pos "$pos" \
    '.rules = (((.rules // [])[0:$pos] + [$rule] + ((.rules // [])[$pos:])))')
  write_policy "$new_policy" || exit 1
  printf 'added rule %s: %s\n' "$((pos + 1))" "$rule"
}

# cmd_remove: delete the rule at <index> — the 1-based index `policy list` prints, the way
# shai-failures show reuses list ids. Targets $SHAI_HOME/policy.json only: overlays are
# repo-tracked workflow files, and a CLI that writes them is a CLI that can escalate.
cmd_remove() {
  if [ $# -ne 1 ]; then
    printf 'usage: shai-config policy remove <index>\n' >&2
    exit 2
  fi
  local idx="$1"
  case "$idx" in
    -*)
      printf 'error: unknown option: %s\n' "$idx" >&2
      exit 2
      ;;
  esac
  if ! [[ "$idx" =~ ^[1-9][0-9]*$ ]]; then
    printf 'error: index must be a positive integer (got "%s")\n' "$idx" >&2
    exit 1
  fi

  local policy len removed new_policy
  policy=$(load_policy "$POLICY_FILE") || exit 1
  len=$(printf '%s' "$policy" | jq -r '(.rules // []) | length')
  if [ "$idx" -gt "$len" ]; then
    printf 'error: no rule at index %s (%s has %s rule(s))\n' "$idx" "$POLICY_FILE" "$len" >&2
    exit 1
  fi
  removed=$(printf '%s' "$policy" | jq -c --argjson i "$idx" '(.rules // [])[$i - 1]')
  new_policy=$(printf '%s' "$policy" | jq -c --argjson i "$idx" \
    '.rules = ((.rules // []) | del(.[$i - 1]))')
  write_policy "$new_policy" || exit 1
  printf 'removed rule %s: %s\n' "$idx" "$removed"
}

# cmd_test: what would the permission gate decide for one call? Calls check_policy from
# lib/policy.sh — the function shai-dispatch uses — with the full overlay+base stack, and
# renders its "<action>\t<reason>" verdict. The `input.<k> (tostring) = …` echo is not
# decoration: the matcher evaluates ($input[$k] // "" | tostring), so a rule pattern must
# match the JSON rendering (an array prints as ["pr","merge","1"], never "pr merge 1").
cmd_test() {
  local TOOL="" INPUT="" OVERLAY_FLAG="" JSON=false have_overlay_flag=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --tool)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --tool requires a name\n' >&2
          exit 2
        fi
        TOOL="$1"
        ;;
      --input)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --input requires JSON\n' >&2
          exit 2
        fi
        INPUT="$1"
        ;;
      --overlay)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --overlay requires a path\n' >&2
          exit 2
        fi
        OVERLAY_FLAG="$1"
        have_overlay_flag=true
        ;;
      --json) JSON=true ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        usage_error
        ;;
    esac
    shift
  done

  if [ -z "$TOOL" ]; then
    printf 'error: --tool is required\n' >&2
    usage_error
  fi
  if [ -z "$INPUT" ]; then
    printf 'error: --input is required (the tool input as JSON)\n' >&2
    usage_error
  fi
  if ! jq empty <<<"$INPUT" >/dev/null 2>&1; then
    printf 'error: --input is not valid JSON: %s\n' "$INPUT" >&2
    exit 1
  fi

  # --overlay pins SHAI_POLICY_OVERLAY for this one call; without it the inherited value
  # wins, exactly as at dispatch time.
  local overlay_env="${SHAI_POLICY_OVERLAY:-}"
  if "$have_overlay_flag"; then overlay_env="$OVERLAY_FLAG"; fi

  local result verdict reason
  result=$(SHAI_POLICY_OVERLAY="$overlay_env" check_policy "$TOOL" "$INPUT")
  verdict="${result%%$'\t'*}"
  reason="${result#*$'\t'}"

  # matched: the rule object a rule: verdict names, re-read from that file for display only.
  # The verdict and reason themselves are check_policy's output — never recomputed here.
  local matched="null"
  if [[ "$reason" == rule:* ]]; then
    local rule_file rule_idx
    rule_file="${reason#rule:}"
    rule_idx="${rule_file##*:}"
    rule_file="${rule_file%:*}"
    if [[ "$rule_idx" =~ ^[0-9]+$ ]] && [ -f "$rule_file" ]; then
      matched=$(jq -c --argjson i "$rule_idx" '.rules[($i - 1)] // empty' "$rule_file" 2>/dev/null) || matched="null"
      if [ -z "$matched" ]; then matched="null"; fi
    fi
  fi

  if [ "$JSON" = true ]; then
    local tostring_map="{}"
    if printf '%s' "$INPUT" | jq -e 'type == "object"' >/dev/null 2>&1; then
      tostring_map=$(printf '%s' "$INPUT" | jq -c \
        'to_entries | map({key: .key, value: (.value | tostring)}) | from_entries')
    fi
    jq -cn --arg tool "$TOOL" --argjson input "$INPUT" --argjson tostring "$tostring_map" \
      --arg verdict "$verdict" --arg reason "$reason" --argjson matched "$matched" \
      '{tool: $tool, input: $input, tostring: $tostring,
        verdict: $verdict, reason: $reason, matched: $matched}'
    return 0
  fi

  if printf '%s' "$INPUT" | jq -e 'type == "object" and (length > 0)' >/dev/null 2>&1; then
    printf '%s' "$INPUT" | jq -r 'to_entries[] | "input.\(.key) (tostring) = \(.value | tostring)"'
    printf '\n'
  fi
  printf 'verdict: %s\n' "$verdict"
  printf 'reason:  %s\n' "$reason"
  if [ "$matched" = "null" ]; then
    printf 'matched: (none)\n'
  else
    printf 'matched: %s\n' "$matched"
  fi
}

# --- ci half (issue #346) ---
# The ci commands edit $SHAI_HOME/ci.json — the config the ci tool (tools/ci/run.sh)
# refuses to run anything without, and which nothing else creates. The repo key under
# .repos is always computed by normalize_url from lib/git-remote.sh, the same function the
# ci tool reads entries by, so a hand-typed --repo cannot create a mis-keyed dead entry.

# load_ci <path>: the ci config's JSON (compact, one line) on stdout. Exit 1 with a
# shai-doctor pointer on stderr when the file is not a JSON object whose .repos map holds
# {checks: object} entries. .repos must exist and be an object: a missing or null .repos
# is that corrupt shape too (a // {} fallback would bless it here and the command paths
# would then die later on .repos[$key] with a raw jq "Cannot index null" error). This is
# the corrupt-ci.json abort (issue #346): parse before writing, and never replace a
# corrupt file with a fresh {"version":"1.0","repos":{}}, because that destroys the user's
# checks in response to the very failure this tool exists to prevent.
load_ci() {
  local path="$1" parsed
  if [ ! -f "$path" ]; then
    printf 'error: no CI config found at %s\n' "$path" >&2
    return 1
  fi
  if ! parsed=$(jq -c '
      if type == "object" and ((.repos) | type) == "object"
         and all(.repos | .[]; type == "object" and (.checks | type) == "object")
      then .
      else error("ci config must be a JSON object with a .repos map of {checks: object} entries")
      end' "$path" 2>/dev/null); then
    printf 'error: %s is not a valid ci config (must be a JSON object with a .repos map of {checks: object} entries)\n' "$path" >&2
    printf 'error: run shai-doctor to diagnose the ci config — nothing was changed\n' >&2
    return 1
  fi
  printf '%s' "$parsed"
}

# write_ci <json>: atomically replace $STATE_DIR/ci.json — temp file + mv, the same
# pattern as write_policy (see its comment): a failed write never leaves a truncated config
# behind and never destroys the existing one, and an existing file's permission bits are
# preserved across the replacement. A brand-new file keeps the temp file's 0600 (the
# conservative default for a file the user never created).
write_ci() {
  local tmp mode=""
  if [ -f "$CONFIG_FILE" ]; then
    mode=$(file_mode "$CONFIG_FILE")
  fi
  if ! mkdir -p "$STATE_DIR"; then
    printf 'error: cannot create state directory %s\n' "$STATE_DIR" >&2
    return 1
  fi
  if ! tmp=$(mktemp "$STATE_DIR/.ci.json.XXXXXX"); then
    printf 'error: cannot write %s\n' "$CONFIG_FILE" >&2
    return 1
  fi
  if ! printf '%s\n' "$1" >"$tmp"; then
    rm -f "$tmp"
    printf 'error: cannot write %s\n' "$CONFIG_FILE" >&2
    return 1
  fi
  if [ -n "$mode" ] && ! chmod "$mode" "$tmp"; then
    rm -f "$tmp"
    printf 'error: cannot write %s\n' "$CONFIG_FILE" >&2
    return 1
  fi
  if ! mv "$tmp" "$CONFIG_FILE"; then
    rm -f "$tmp"
    printf 'error: cannot write %s\n' "$CONFIG_FILE" >&2
    return 1
  fi
}

# resolve_repo_key [override]: echo the normalized repo key, then its provenance label
# ("from origin" / "normalized from --repo"), one per line. With no override the key comes
# from the cwd's origin remote — both paths through normalize_url, so every key printed or
# written here is the shape the ci tool looks up. Exit 1 when there is no override and no
# origin remote, naming both ways to fix that (the same wording tools/ci/run.sh uses).
resolve_repo_key() {
  local override="${1:-}" key remote
  if [ -n "$override" ]; then
    key=$(normalize_url "$override")
    printf '%s\n' "$key"
    printf 'normalized from --repo\n'
    return 0
  fi
  if ! remote=$(git remote get-url origin 2>/dev/null); then
    printf 'error: not in a git repository or no '\''origin'\'' remote\n' >&2
    printf 'error: pass --repo KEY to target another repository, or add an '\''origin'\'' remote\n' >&2
    return 1
  fi
  key=$(normalize_url "$remote")
  printf '%s\n' "$key"
  printf 'from origin\n'
}

# cmd_ci_list: read-only view of one repo's checks. The key line names the resolved key —
# the line that makes a mis-keyed existing entry diagnosable instead of "not found".
cmd_ci_list() {
  local JSON=false REPO=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) JSON=true ;;
      --repo)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --repo requires a key\n' >&2
          exit 2
        fi
        REPO="$1"
        ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        usage_error
        ;;
    esac
    shift
  done

  local out key provenance ci repo_cfg
  out=$(resolve_repo_key "$REPO") || exit 1
  key="${out%%$'\n'*}"
  provenance="${out#*$'\n'}"
  ci=$(load_ci "$CONFIG_FILE") || exit 1
  repo_cfg=$(printf '%s' "$ci" | jq -c --arg key "$key" '.repos[$key] // empty')
  if [ -z "$repo_cfg" ]; then
    printf 'error: repository "%s" not found in %s\n' "$key" "$CONFIG_FILE" >&2
    exit 1
  fi

  if [ "$JSON" = true ]; then
    printf '%s' "$repo_cfg" | jq -c --arg key "$key" --arg file "$CONFIG_FILE" \
      '{repo: $key, file: $file, checks: .checks}'
    return 0
  fi

  printf 'repo: %s  (%s)\n' "$key" "$provenance"
  printf '%s' "$repo_cfg" | jq -r '
    .checks
    | to_entries
    | if length == 0 then "  (none configured)"
      else (.[] | "  \(.key): \(.value.command? // "<no command configured>")")
      end'
}

# cmd_ci_add: write one check under the resolved repo key, creating ci.json (with
# "version": "1.0", no _comment) when absent. Refuses — writing nothing — when the check
# name already exists: remove + add covers edits, and a silent overwrite would clobber a
# hand-tuned entry. --env pairs build the per-check env object the ci tool re-injects
# literally into the check's scrubbed environment.
cmd_ci_add() {
  local NAME="" COMMAND="" TIMEOUT="" REPO=""
  local -a ENV_PAIRS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --name requires a name\n' >&2
          exit 2
        fi
        NAME="$1"
        ;;
      --command)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --command requires a command\n' >&2
          exit 2
        fi
        COMMAND="$1"
        ;;
      --timeout)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --timeout requires seconds\n' >&2
          exit 2
        fi
        TIMEOUT="$1"
        ;;
      --env)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --env requires K=V\n' >&2
          exit 2
        fi
        ENV_PAIRS+=("$1")
        ;;
      --repo)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --repo requires a key\n' >&2
          exit 2
        fi
        REPO="$1"
        ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        usage_error
        ;;
    esac
    shift
  done

  if [ -z "$NAME" ]; then
    printf 'error: --name is required\n' >&2
    usage_error
  fi
  # cmd_ci_remove treats a dash-leading positional as an unknown option, so a
  # dash-leading name accepted here could never be removed — refuse it in add so every
  # name add accepts is removable (and names can never collide with future flags).
  case "$NAME" in
    -*)
      printf 'error: --name must not start with "-" (got "%s")\n' "$NAME" >&2
      exit 1
      ;;
  esac
  if [ -z "$COMMAND" ]; then
    printf 'error: --command is required\n' >&2
    usage_error
  fi
  if [ -n "$TIMEOUT" ] && ! [[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
    printf 'error: --timeout must be a positive integer in seconds (got "%s")\n' "$TIMEOUT" >&2
    exit 1
  fi
  # Keys are held to the same rule the reader enforces at run time: tools/ci/run.sh
  # rejects any env key that is not an env-var name, so accepting one here would write
  # a check that can never run — refuse it now (mirroring how --timeout validates
  # against the reader's rule).
  local pair env_key
  for pair in "${ENV_PAIRS[@]}"; do
    case "$pair" in
      ?*=*) ;;
      *)
        printf 'error: --env expects K=V with a non-empty key (got "%s")\n' "$pair" >&2
        exit 1
        ;;
    esac
    env_key="${pair%%=*}"
    if ! [[ "$env_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      printf 'error: --env key "%s" is not an environment variable name — must match [A-Za-z_][A-Za-z0-9_]*\n' "$env_key" >&2
      exit 1
    fi
  done
  # from_entries silently keeps the last of duplicate keys, so `--env k=A --env k=B`
  # would discard A and write only B — refuse the pair instead of letting a value vanish.
  local i j
  for ((i = 0; i < ${#ENV_PAIRS[@]}; i++)); do
    for ((j = i + 1; j < ${#ENV_PAIRS[@]}; j++)); do
      if [ "${ENV_PAIRS[i]%%=*}" = "${ENV_PAIRS[j]%%=*}" ]; then
        printf 'error: duplicate --env key "%s" (each key may appear once)\n' "${ENV_PAIRS[i]%%=*}" >&2
        exit 1
      fi
    done
  done

  local out key provenance
  out=$(resolve_repo_key "$REPO") || exit 1
  key="${out%%$'\n'*}"
  provenance="${out#*$'\n'}"

  # Parse before writing: a corrupt existing file aborts here, byte-identical. An absent
  # file starts fresh with "version": "1.0" — the _comment from ci.json.example documents
  # the example, it does not belong in a written config.
  local ci
  if [ -f "$CONFIG_FILE" ]; then
    ci=$(load_ci "$CONFIG_FILE") || exit 1
  else
    ci='{"version":"1.0","repos":{}}'
  fi

  if printf '%s' "$ci" | jq -e --arg key "$key" --arg name "$NAME" \
    '.repos[$key].checks | has($name)' >/dev/null 2>&1; then
    printf 'error: check "%s" already exists for %s\n' "$NAME" "$key" >&2
    printf 'error: remove it first: shai-config ci remove %s --repo %s\n' "$NAME" "$key" >&2
    exit 1
  fi

  # The check object: command first (matching ci.json.example), timeout only when given
  # (the ci tool defaults it to 120), env from the --env pairs with verbatim values.
  local check
  check=$(jq -nc --arg command "$COMMAND" --argjson timeout "${TIMEOUT:-null}" \
    '{command: $command}
     + (if $timeout != null then {timeout: $timeout} else {} end)
     + (if ($ARGS.positional | length) > 0
        then {env: ($ARGS.positional
                    | map({key: (split("=")[0]), value: (split("=")[1:] | join("="))})
                    | from_entries)}
        else {} end)' \
    --args "${ENV_PAIRS[@]}")

  local new_ci
  new_ci=$(printf '%s' "$ci" | jq -c --arg key "$key" --arg name "$NAME" --argjson check "$check" \
    '.repos[$key] = ((.repos[$key] // {checks: {}}) | .checks[$name] = $check)')
  write_ci "$new_ci" || exit 1
  # The resolved key line is deliberate — it is the one line that makes a mis-keyed entry
  # impossible to create unnoticed.
  printf 'repo: %s  (%s)\n' "$key" "$provenance"
  printf 'added check "%s"\n' "$NAME"
}

# cmd_ci_remove: delete one check from the repo's checks map. Never removes the repo entry
# itself — an empty "checks": {} is a valid state the ci tool reports as "(none
# configured)". An unknown check name lists the available names instead of a bare refusal.
cmd_ci_remove() {
  if [ $# -lt 1 ]; then
    printf 'usage: shai-config ci remove <name> [--repo KEY]\n' >&2
    exit 2
  fi
  local name="$1"
  shift
  case "$name" in
    -*)
      printf 'error: unknown option: %s\n' "$name" >&2
      exit 2
      ;;
  esac
  local REPO=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        shift
        if [ -z "${1:-}" ]; then
          printf 'error: --repo requires a key\n' >&2
          exit 2
        fi
        REPO="$1"
        ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        usage_error
        ;;
    esac
    shift
  done

  local out key provenance ci repo_cfg
  out=$(resolve_repo_key "$REPO") || exit 1
  key="${out%%$'\n'*}"
  provenance="${out#*$'\n'}"
  ci=$(load_ci "$CONFIG_FILE") || exit 1
  repo_cfg=$(printf '%s' "$ci" | jq -c --arg key "$key" '.repos[$key] // empty')
  if [ -z "$repo_cfg" ]; then
    printf 'error: repository "%s" not found in %s\n' "$key" "$CONFIG_FILE" >&2
    exit 1
  fi

  if ! printf '%s' "$ci" | jq -e --arg key "$key" --arg name "$name" \
    '.repos[$key].checks | has($name)' >/dev/null 2>&1; then
    printf 'error: no check "%s" for %s\n' "$name" "$key" >&2
    printf 'available checks:\n' >&2
    local names
    names=$(printf '%s' "$ci" | jq -r --arg key "$key" '.repos[$key].checks | keys[]')
    if [ -n "$names" ]; then
      printf '%s\n' "$names" | sed 's/^/  /' >&2
    else
      printf '  (none configured)\n' >&2
    fi
    exit 1
  fi

  local new_ci
  new_ci=$(printf '%s' "$ci" | jq -c --arg key "$key" --arg name "$name" \
    'del(.repos[$key].checks[$name])')
  write_ci "$new_ci" || exit 1
  printf 'repo: %s  (%s)\n' "$key" "$provenance"
  printf 'removed check "%s"\n' "$name"
}

NOUN="${1:-}"
VERB="${2:-}"
if [ $# -ge 2 ]; then
  shift 2
else
  shift $#
fi

case "$NOUN" in
  policy)
    case "$VERB" in
      list) cmd_list "$@" ;;
      add) cmd_add "$@" ;;
      remove) cmd_remove "$@" ;;
      test) cmd_test "$@" ;;
      "")
        printf 'usage: shai-config policy <list|add|remove|test> [options]\n' >&2
        exit 2
        ;;
      *)
        printf 'error: unknown policy command: %s\n' "$VERB" >&2
        usage_error
        ;;
    esac
    ;;
  ci)
    case "$VERB" in
      list) cmd_ci_list "$@" ;;
      add) cmd_ci_add "$@" ;;
      remove) cmd_ci_remove "$@" ;;
      "")
        printf 'usage: shai-config ci <list|add|remove> [options]\n' >&2
        exit 2
        ;;
      *)
        printf 'error: unknown ci command: %s\n' "$VERB" >&2
        usage_error
        ;;
    esac
    ;;
  "")
    usage_error
    ;;
  *)
    printf 'error: unknown noun: %s (expected "policy" or "ci")\n' "$NOUN" >&2
    usage_error
    ;;
esac
