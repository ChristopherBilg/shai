#!/bin/bash
set -euo pipefail

MAX_BYTES=8000

run_tool() {
  local name="$1" input="$2" number repo path
  case "$name" in
    gh_pr_view|gh_issue_view)
      number=$(printf '%s' "$input" | jq -r '.number')
      repo=$(printf '%s' "$input" | jq -r '.repo // empty')
      local sub="pr"; [ "$name" = "gh_issue_view" ] && sub="issue"
      if [ -n "$repo" ]; then timeout 30s gh "$sub" view "$number" --repo "$repo" 2>&1
      else timeout 30s gh "$sub" view "$number" 2>&1; fi ;;
    list_directory)
      path=$(printf '%s' "$input" | jq -r '.path'); ls -1 -- "$path" 2>&1 ;;
    print_file)
      path=$(printf '%s' "$input" | jq -r '.path'); cat -- "$path" 2>&1 ;;
    *) printf 'Unknown tool: %s' "$name"; return 1 ;;
  esac
}

tool_calls=0
while IFS=$'\t' read -r tool_id tool_name tool_input; do
  [ -z "$tool_id" ] && continue
  tool_calls=$((tool_calls + 1))
  if raw=$(run_tool "$tool_name" "$tool_input"); then is_error=false; else is_error=true; fi
  output=$(head -c "$MAX_BYTES" <<< "$raw")
  jq -nc --arg id "$tool_id" --arg content "$output" --argjson is_error "$is_error" \
    '{type:"tool_result", source:"tool", payload:{tool_use_id:$id, content:$content, is_error:$is_error}}'
done < <(jq -r '
  select(.type=="message" and .source=="assistant")
  | .payload.content[]? | select(.type=="tool_use")
  | [.id, .name, (.input | @json)] | @tsv
')

[ "$tool_calls" -gt 0 ] && exit 1 || exit 0
