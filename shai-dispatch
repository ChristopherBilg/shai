#!/bin/bash
# shai-dispatch — run tool_use blocks from the latest assistant event; emit tool_result events
# Usage: cat latest.json | shai-dispatch
# Reads: the latest assistant event JSON on stdin; $SHAI_HOME/policy.json for permission rules;
#        SHAI_RETRY_ACTIVE from environment (skips non-read-only tools during retry)
# Writes: one tool_result event per tool_use (output truncated to 32000 bytes);
#         write_file and patch_file modify the local filesystem
# Exit: 1 if any tool ran (signals shai to re-evaluate), 0 otherwise
set -euo pipefail

MAX_BYTES=32000

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"

check_policy() {
  local tool_name="$1" tool_input="$2"
  local policy_file="$STATE_DIR/policy.json"

  if [ ! -f "$policy_file" ]; then
    case "$tool_name" in
      print_file | list_directory | gh_pr_view | gh_issue_view) printf 'allow' ;;
      *) printf 'prompt' ;;
    esac
    return 0
  fi

  local action
  action=$(jq -r --arg name "$tool_name" --argjson input "$tool_input" '
    .rules[]?
    | select(.tool == $name)
    | select(
        (has("args") | not) or
        (.args | to_entries | all(
          .key as $k | .value as $v |
          ($input[$k] // "" | tostring) | test(
            "^" + ($v | gsub("(?<c>[.+?^${}()|\\[\\]])"; "\\\(.c)";"x") | gsub("\\*"; ".*")) + "$"
          )
        ))
      )
    | .action
  ' "$policy_file" 2>/dev/null | head -n 1) || action=""

  local fallback
  fallback=$(jq -r '.default // "prompt"' "$policy_file" 2>/dev/null) || fallback=""
  printf '%s' "${action:-${fallback:-prompt}}"
}

prompt_user() {
  local tool_name="$1" tool_input="$2"
  if ! [ -t 2 ]; then
    return 1
  fi
  printf '\n⚠ shai wants to execute:\n' >/dev/tty
  printf '  tool:  %s\n' "$tool_name" >/dev/tty
  printf '%s' "$tool_input" | jq -r 'to_entries[] | "  \(.key):  \(.value)"' >/dev/tty 2>/dev/null
  printf '\n  Allow? [y/N] ' >/dev/tty
  local answer
  read -r answer </dev/tty 2>/dev/null || answer=""
  case "$answer" in
    y | Y | yes | YES) return 0 ;;
    *) return 1 ;;
  esac
}

run_tool() {
  local name="$1" input="$2"
  local policy_action
  policy_action=$(check_policy "$name" "$input")
  case "$policy_action" in
    allow) ;;
    deny)
      printf 'Policy denied: %s' "$name"
      return 1
      ;;
    prompt)
      if ! prompt_user "$name" "$input"; then
        printf 'Permission denied: %s' "$name"
        return 1
      fi
      ;;
    *)
      printf 'Policy denied: %s (unrecognized action)' "$name"
      return 1
      ;;
  esac
  local number repo path
  case "$name" in
    gh_pr_view | gh_issue_view)
      number=$(printf '%s' "$input" | jq -r '.number')
      repo=$(printf '%s' "$input" | jq -r '.repo // empty')
      local sub="pr"
      [ "$name" = "gh_issue_view" ] && sub="issue"
      local args=("$sub" view)
      if [ -n "$repo" ]; then args+=(--repo "$repo"); fi
      args+=(-- "$number")
      timeout 30s gh "${args[@]}" 2>&1
      ;;
    list_directory)
      path=$(printf '%s' "$input" | jq -r '.path')
      timeout 30s ls -1 -- "$path" 2>&1
      ;;
    print_file)
      path=$(printf '%s' "$input" | jq -r '.path')
      timeout 30s cat -- "$path" 2>&1
      ;;
    write_file)
      path=$(printf '%s' "$input" | jq -r '.path')
      local content
      content=$(printf '%s' "$input" | jq -r '.content')
      mkdir -p -- "$(dirname "$path")" 2>&1 || {
        printf 'cannot create parent directory for %s' "$path"
        return 1
      }
      printf '%s' "$content" >"$path" || {
        printf 'cannot write to %s' "$path"
        return 1
      }
      printf 'Wrote %d bytes to %s' "$(wc -c <"$path")" "$path"
      ;;
    patch_file)
      path=$(printf '%s' "$input" | jq -r '.path')
      local old_string new_string
      old_string=$(printf '%s' "$input" | jq -r '.old_string')
      if [ -z "$old_string" ]; then
        printf 'old_string must not be empty'
        return 1
      fi
      new_string=$(printf '%s' "$input" | jq -r '.new_string')
      if [ ! -f "$path" ]; then
        printf 'file not found: %s' "$path"
        return 1
      fi
      if [ ! -s "$path" ]; then
        printf 'old_string not found in %s (file is empty)' "$path"
        return 1
      fi
      local count
      count=$(OLD_STR="$old_string" awk '
        BEGIN { old = ENVIRON["OLD_STR"]; RS = "\0"; ORS = "" }
        {
          s = $0; n = 0
          while ((p = index(s, old)) > 0) { n++; s = substr(s, p + length(old)) }
          print n
        }
      ' "$path")
      if [ "$count" -eq 0 ]; then
        printf 'old_string not found in %s' "$path"
        return 1
      fi
      if [ "$count" -gt 1 ]; then
        printf 'old_string matches %d times in %s (must be unique)' "$count" "$path"
        return 1
      fi
      local tmpfile
      tmpfile=$(mktemp) || {
        printf 'cannot create temp file'
        return 1
      }
      OLD_STR="$old_string" NEW_STR="$new_string" awk '
        BEGIN { old = ENVIRON["OLD_STR"]; new = ENVIRON["NEW_STR"]; RS = "\0"; ORS = "" }
        {
          p = index($0, old)
          printf "%s%s%s", substr($0, 1, p - 1), new, substr($0, p + length(old))
        }
      ' "$path" >"$tmpfile" || {
        rm -f "$tmpfile"
        printf 'patch failed for %s' "$path"
        return 1
      }
      mv -- "$tmpfile" "$path" 2>&1 || {
        rm -f "$tmpfile"
        printf 'cannot write to %s' "$path"
        return 1
      }
      printf 'Patched %s' "$path"
      ;;
    *)
      printf 'Unknown tool: %s' "$name"
      return 1
      ;;
  esac
}

tool_calls=0
while IFS= read -r block; do
  [ -z "$block" ] && continue
  tool_calls=$((tool_calls + 1))
  tool_name=$(printf '%s' "$block" | jq -r '.name')
  tool_id=$(printf '%s' "$block" | jq -r '.id')
  tool_input=$(printf '%s' "$block" | jq -c '.input')
  skip_run=false
  if [ -n "${SHAI_RETRY_ACTIVE:-}" ]; then
    case "$tool_name" in
      print_file | list_directory | gh_pr_view | gh_issue_view) ;;
      *)
        raw="write tool skipped during retry — re-run manually"
        is_error=true
        skip_run=true
        ;;
    esac
  fi
  if ! "$skip_run"; then
    if raw=$(run_tool "$tool_name" "$tool_input"); then is_error=false; else is_error=true; fi
  fi
  output=$(head -c "$MAX_BYTES" <<<"$raw")
  jq -nc --arg id "$tool_id" --arg content "$output" --arg src "$tool_name" --argjson is_error "$is_error" '
    ($src | gsub("[^A-Za-z0-9_.:-]"; "")) as $s0
    | (if ($s0 | length) > 0 then $s0 else "tool" end) as $safe_src
    | ($content | gsub("<\\s*/?\\s*external_data\\s*>?"; "[external_data]"; "i")) as $safe
    | {type:"tool_result", source:"tool",
       payload:{tool_use_id:$id,
                content:("<external_data source=\"" + $safe_src + "\">\n" + $safe + "\n</external_data>"),
                is_error:$is_error}}'
done < <(jq -c '
  select(.type=="message" and .source=="assistant")
  | .payload.content[]? | select(.type=="tool_use")
')

[ "$tool_calls" -gt 0 ] && exit 1 || exit 0
