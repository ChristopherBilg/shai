#!/bin/bash
# shai-dispatch — run tool_calls from the latest assistant event; emit tool_result events
# Usage: cat latest.json | shai-dispatch
# Reads: the latest assistant event JSON on stdin; $SHAI_HOME/policy.json for permission rules;
#        SHAI_POLICY_OVERLAY (optional path to overlay policy — overlay rules are checked
#        before base rules and intentionally supersede them, including deny; this lets
#        workflows grant tools they need without requiring the user to modify their base
#        policy); $TOOLS_DIR/<tool>/tool.json (capabilities.read_only) and
#        $TOOLS_DIR/<tool>/run.sh (executed to run each tool); lib/read-only.sh (default
#        exclusions for read-only auto-allow, see #118); SHAI_RETRY_ACTIVE and SHAI_TOOLS_DIR
#        (overrides the default $DIR/tools) from environment (retry skips non-read-only tools)
# Writes: one tool_result event per tool_use (32000-byte cap: first 24000 + last 8000 kept with
#         a "[truncated: ...]" marker); content fenced in external_data tags, closing external_data tags
#         escaped as &lt;/external_data&gt; (note line when any are escaped; opening tags untouched); write_file, patch_file, delete_file modify the filesystem
# Exit: 1 if any tool ran (signals shai-repl / shai-loop to re-evaluate), 0 otherwise;
#       2 on bad constants, 3 on dispatch failure (any failure that is not "a tool ran").
# The exit code is a contract consumed by shai-loop's re-eval loop (see #257): ONLY 1 means
# "a tool ran, re-evaluate". Every other non-zero exit must mean "dispatch failed", so the
# loop stops instead of re-evaluating on a failure. The ERR trap below is what makes that
# contract hold: under `set -euo pipefail` an unexpected command failure would otherwise abort
# with that command's status — usually 1 — and be misread as "a tool ran". Normalizing every
# set -e abort to 3 keeps the two apart; explicit `exit` calls (including the deliberate
# exit 1 at the end) are not command failures and do not trip the trap.
set -euo pipefail

# dispatch_failed: ERR-trap handler — normalize any unexpected failure to the dedicated
# "dispatch failed" exit (3), reporting the underlying status on stderr so the failure is
# visible at the point it happens instead of silently reading as "a tool ran".
dispatch_failed() {
  local rc=$?
  printf 'shai-dispatch: dispatch failed (exit %s), not "a tool ran" — the re-eval loop will stop\n' "$rc" >&2
  exit 3
}
trap dispatch_failed ERR

MAX_BYTES=32000
HEAD_BYTES=24000
# Derived, never a second literal: the head and tail windows must sum to exactly MAX_BYTES. Two
# independent literals silently break the split if MAX_BYTES is ever lowered — the two windows
# would overlap (duplicated bytes) and `elided` would go negative.
TAIL_BYTES=$((MAX_BYTES - HEAD_BYTES))
if [ "$HEAD_BYTES" -le 0 ] || [ "$TAIL_BYTES" -le 0 ]; then
  echo "shai-dispatch: bad truncation window — need 0 < HEAD_BYTES ($HEAD_BYTES) < MAX_BYTES ($MAX_BYTES)" >&2
  exit 2
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
TOOLS_DIR="${SHAI_TOOLS_DIR:-$DIR/tools}"
# Pre-flight the one unconditionally-sourced dependency so a partial/interrupted install
# (missing lib/read-only.sh) fails with an explicit message and exit 3 before any input is
# read. A bare `source` failure would abort with status 1 — indistinguishable from "a tool
# ran" to shai-loop, which would re-evaluate forever (see #257).
if [ ! -r "$DIR/lib/read-only.sh" ]; then
  printf 'shai-dispatch: cannot read %s — install incomplete? (exit 3: dispatch failed, not "a tool ran")\n' \
    "$DIR/lib/read-only.sh" >&2
  exit 3
fi
# shellcheck source=lib/read-only.sh
source "$DIR/lib/read-only.sh"

# truncate_output <raw>: echo tool output bounded to MAX_BYTES payload bytes.
# Under the cap the bytes pass through unchanged (no marker). Over the cap, keep the first
# HEAD_BYTES and the last TAIL_BYTES and put an explicit marker between them: `head` alone
# drops exactly the part that usually carries the verdict (a `ci` exit_code line, a test
# summary, an error tail), and silent tail loss lets the model reason from a clipped result
# as if it were complete. Marker text stays inside the fenced content so the external_data
# closing-tag escaping still applies to it. Here-strings (not pipes) feed head/tail so a short
# read can never SIGPIPE the producer and take down the loop under `set -o pipefail`.
truncate_output() {
  local raw="$1" total head_part tail_part head_len tail_len elided
  total=$(wc -c <<<"$raw" | tr -d ' ')
  total=$((total - 1)) # the here-string appends one newline
  if [ "$total" -le "$MAX_BYTES" ]; then
    printf '%s' "$raw"
    return 0
  fi
  head_part=$(head -c "$HEAD_BYTES" <<<"$raw")
  # +1 absorbs the here-string's trailing newline, which $(...) then strips back off.
  tail_part=$(tail -c $((TAIL_BYTES + 1)) <<<"$raw")
  # Report the sizes actually retained, not the constants: $(...) strips *all* trailing newlines,
  # so a window whose cut lands on one (e.g. byte HEAD_BYTES of a text file) is shorter than the
  # constant claims. Measuring keeps the marker honest and `elided` exact.
  head_len=$(printf '%s' "$head_part" | wc -c | tr -d ' ')
  tail_len=$(printf '%s' "$tail_part" | wc -c | tr -d ' ')
  elided=$((total - head_len - tail_len))
  printf '%s\n[truncated: %s bytes total; showing the first %s and last %s bytes, %s bytes elided from the middle]\n%s' \
    "$head_part" "$total" "$head_len" "$tail_len" "$elided" "$tail_part"
}

tool_is_read_only() {
  local name="$1"
  local tool_json="$TOOLS_DIR/$name/tool.json"
  [ -f "$tool_json" ] || {
    printf 'false'
    return 0
  }
  jq -r '.capabilities.read_only // false' "$tool_json" 2>/dev/null || printf 'false'
}

# read_only_fallback <tool_name> <tool_input>: the per-tool fallback used when no policy rule
# matches and no `default` is set. A read-only tool is auto-allowed EXCEPT when its input
# targets an excluded path (the shared list in lib/read-only.sh, see #118) — then it degrades
# to `prompt` (interactive confirmation; non-interactive runs fail closed), so credential-
# adjacent paths are never auto-allowed. The exclusion list is a default, not a boundary: a
# matching policy rule (allow/deny) or an explicit `default` is checked before this fallback
# and wins. Only `.path` is consulted — the path-bearing read-only tools all use that field,
# and path-less read-only tools (sleep) have no input path to exclude.
read_only_fallback() {
  local tool_name="$1" tool_input="$2"
  local ro path
  ro=$(tool_is_read_only "$tool_name" 2>/dev/null)
  if [ "$ro" != "true" ]; then
    printf 'prompt'
    return 0
  fi
  path=$(printf '%s' "$tool_input" | jq -r '.path // empty' 2>/dev/null) || path=""
  if ro_path_excluded "$path"; then
    printf 'prompt\treadonly'
  else
    printf 'allow\treadonly'
  fi
}

check_policy() {
  local tool_name="$1" tool_input="$2"
  local policy_file="$STATE_DIR/policy.json"
  local overlay_file="${SHAI_POLICY_OVERLAY:-}"
  local has_base=false has_overlay=false

  [ -f "$policy_file" ] && has_base=true
  [ -n "$overlay_file" ] && [ -f "$overlay_file" ] && has_overlay=true

  # Every return is "<action>\t<reason>": the bare action drives run_tool's case dispatch, the
  # reason lets a denial name the policy that decided it (rule vs default vs no rule vs
  # arg-scope miss) instead of collapsing every cause into one indistinguishable three-word
  # string. Reasons: rule:<file>:<idx> (matched rule, 1-based index), default:<file> (the
  # policy's `.default`), readonly (read-only heuristic), nopolicy (no policy files),
  # unmatched:<overlay>:<base> (no rule matched, no default; `-` where a file is absent), and
  # argscope:<file>:<key>=<pattern>[,...] (an allow rule for the tool exists but its args
  # did not match — the one denial an agent can fix by retrying with different arguments).
  if ! "$has_base" && ! "$has_overlay"; then
    local ar
    ar=$(read_only_fallback "$tool_name" "$tool_input")
    if [ "$ar" = "prompt" ]; then
      printf 'prompt\tnopolicy'
    else
      printf '%s' "$ar"
    fi
    return 0
  fi

  local match_filter='
    .rules | to_entries[]
    | select(.value.tool == $name)
    | select(
        (.value | has("args") | not) or
        (.value.args | to_entries | all(
          .key as $k | .value as $v |
          ($input[$k] // "" | tostring) | test(
            "^" + ($v | gsub("(?<c>[.+?^${}()|\\[\\]])"; "\\\(.c)";"x") | gsub("\\*"; ".*")) + "$"
          )
        ))
      )
    | "\(.value.action)\t\(.key + 1)"
  '

  # Overlay rules are checked first and intentionally supersede base rules (including deny).
  local match="" matched_file=""

  if "$has_overlay"; then
    match=$(jq -r --arg name "$tool_name" --argjson input "$tool_input" \
      "$match_filter" "$overlay_file" 2>/dev/null | head -n 1) || match=""
    if [ -n "$match" ]; then matched_file="$overlay_file"; fi
  fi

  if [ -z "$match" ] && "$has_base"; then
    match=$(jq -r --arg name "$tool_name" --argjson input "$tool_input" \
      "$match_filter" "$policy_file" 2>/dev/null | head -n 1) || match=""
    if [ -n "$match" ]; then matched_file="$policy_file"; fi
  fi

  if [ -n "$match" ]; then
    printf '%s\trule:%s:%s' "${match%%$'\t'*}" "$matched_file" "${match##*$'\t'}"
    return 0
  fi

  local fallback="" fallback_file=""
  if "$has_overlay"; then
    fallback=$(jq -r '.default // empty' "$overlay_file" 2>/dev/null) || fallback=""
    if [ -n "$fallback" ]; then fallback_file="$overlay_file"; fi
  fi
  if [ -z "$fallback" ] && "$has_base"; then
    fallback=$(jq -r '.default // empty' "$policy_file" 2>/dev/null) || fallback=""
    if [ -n "$fallback" ]; then fallback_file="$policy_file"; fi
  fi
  if [ -n "$fallback" ]; then
    printf '%s\tdefault:%s' "$fallback" "$fallback_file"
    return 0
  fi

  local ar
  ar=$(read_only_fallback "$tool_name" "$tool_input")
  if [ "$ar" != "prompt" ]; then
    printf '%s' "$ar"
    return 0
  fi

  # No rule matched and no default: distinguish "no rule for this tool at all" from "an allow
  # rule exists but its args did not match" (arg-scope miss — the only case an agent can fix by
  # retrying with different arguments). Only allow rules count: retrying to match a deny rule's
  # args would just land on the deny, so a deny rule with args that miss must not be reported
  # as an arg-scope miss. An allow rule can only fail to match when the call's args missed its
  # patterns, so finding one means the args are the reason.
  local scope_rule="" scope_file=""
  local scope_filter='
    .rules[]?
    | select(.tool == $name and has("args") and .action == "allow")
    | .args | to_entries | map("\(.key)=\(.value)") | join(",")
  '
  if "$has_overlay"; then
    scope_rule=$(jq -r --arg name "$tool_name" "$scope_filter" "$overlay_file" 2>/dev/null | head -n 1) || scope_rule=""
    if [ -n "$scope_rule" ]; then scope_file="$overlay_file"; fi
  fi
  if [ -z "$scope_rule" ] && "$has_base"; then
    scope_rule=$(jq -r --arg name "$tool_name" "$scope_filter" "$policy_file" 2>/dev/null | head -n 1) || scope_rule=""
    if [ -n "$scope_rule" ]; then scope_file="$policy_file"; fi
  fi
  if [ -n "$scope_rule" ]; then
    printf 'prompt\targscope:%s:%s' "$scope_file" "$scope_rule"
  else
    local overlay_disp="-" base_disp="-"
    if "$has_overlay"; then overlay_disp="$overlay_file"; fi
    if "$has_base"; then base_disp="$policy_file"; fi
    printf 'prompt\tunmatched:%s:%s' "$overlay_disp" "$base_disp"
  fi
}

prompt_user() {
  local tool_name="$1" tool_input="$2"
  if ! [ -t 2 ]; then
    return 1
  fi
  printf '\n⚠ shai wants to execute:\n' >/dev/tty
  printf '  tool:  %s\n' "$tool_name" >/dev/tty
  printf '%s' "$tool_input" | jq -r 'to_entries[] | "  \(.key):  \(.value)"' >/dev/tty 2>/dev/null
  printf '\n  Allow? [y/N] ' >/dev/tty
  local answer
  read -r answer </dev/tty 2>/dev/null || answer=""
  case "$answer" in
    y | Y | yes | YES) return 0 ;;
    *) return 1 ;;
  esac
}

run_tool() {
  local name="$1" input="$2"
  local policy_line policy_action policy_reason
  policy_line=$(check_policy "$name" "$input")
  policy_action="${policy_line%%$'\t'*}"
  policy_reason="${policy_line#*$'\t'}"
  case "$policy_action" in
    allow) ;;
    deny)
      # Denials name the deciding policy so the model can tell an explicit deny rule from a
      # policy default that denies — and can see the file to inspect — instead of getting the
      # same three words for every cause.
      case "$policy_reason" in
        rule:*)
          local deny_file="${policy_reason#rule:}"
          deny_file="${deny_file%:*}"
          printf 'Policy denied: %s — deny rule in %s.' "$name" "$deny_file"
          ;;
        default:*)
          local deny_default="${policy_reason#default:}"
          printf 'Policy denied: %s — no rule matched and the policy default is deny in %s.' "$name" "$deny_default"
          ;;
        *)
          printf 'Policy denied: %s.' "$name"
          ;;
      esac
      return 1
      ;;
    prompt)
      if ! prompt_user "$name" "$input"; then
        # prompt_user fails both for headless runs (no TTY — workflows never reach the
        # prompt) and for an interactive user declining at a TTY; only the former is truly
        # headless, so assert headlessness only when there is no TTY. Spell out which cause
        # it was: no rule at all (retrying is futile), an arg-scope miss (retry with a
        # matching argument — the one fixable case), or a prompt-typed policy default.
        local denial_note="this run is headless, so retrying will not help."
        if [ -t 2 ]; then
          denial_note="the call was declined at the prompt."
        fi
        case "$policy_reason" in
          argscope:*)
            local rest="${policy_reason#argscope:}"
            local scope_file="${rest%%:*}"
            local patterns="${rest#*:}"
            local parts=() pieces=() p
            IFS=',' read -r -a parts <<<"$patterns"
            for p in "${parts[@]}"; do
              pieces+=("${p%%=*} to match ${p#*=}")
            done
            printf 'Not granted: %s — an allow rule for %s exists in %s but requires %s; retry with a matching argument.' \
              "$name" "$name" "$scope_file" "$(
                IFS=', '
                printf '%s' "${pieces[*]}"
              )"
            ;;
          unmatched:*)
            local um_rest="${policy_reason#unmatched:}"
            local um_overlay="${um_rest%%:*}" um_base="${um_rest#*:}"
            [ "$um_overlay" = "-" ] && um_overlay="(none)"
            [ "$um_base" = "-" ] && um_base="(none)"
            printf 'Not granted: %s — no allow rule matched in %s or %s; %s' \
              "$name" "$um_overlay" "$um_base" "$denial_note"
            ;;
          nopolicy)
            printf 'Not granted: %s — no policy file or overlay grants %s; %s' \
              "$name" "$name" "$denial_note"
            ;;
          default:*)
            local prompt_default="${policy_reason#default:}"
            printf 'Not granted: %s — no rule matched and the policy default in %s is prompt; %s' \
              "$name" "$prompt_default" "$denial_note"
            ;;
          *)
            printf 'Not granted: %s — permission not granted; %s' "$name" "$denial_note"
            ;;
        esac
        return 1
      fi
      ;;
    *)
      printf 'Policy denied: %s (unrecognized action)' "$name"
      return 1
      ;;
  esac
  local run_sh="$TOOLS_DIR/$name/run.sh"
  if [ ! -x "$run_sh" ]; then
    printf 'Unknown tool: %s' "$name"
    return 1
  fi
  "$run_sh" "$input"
}

tool_calls=0
while IFS= read -r block; do
  [ -z "$block" ] && continue
  tool_calls=$((tool_calls + 1))
  tool_name=$(printf '%s' "$block" | jq -r '.name')
  tool_id=$(printf '%s' "$block" | jq -r '.id')
  tool_input=$(printf '%s' "$block" | jq -c '.input')
  if [[ ! "$tool_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    raw="Invalid tool name: $tool_name"
    is_error=true
    jq -nc --arg id "$tool_id" --arg content "$raw" --argjson is_error true '
      {type:"tool_result", source:"tool",
       payload:{tool_call_id:$id, content:$content, is_error:$is_error}}'
    continue
  fi
  skip_run=false
  if [ -n "${SHAI_RETRY_ACTIVE:-}" ]; then
    ro=$(tool_is_read_only "$tool_name")
    if [ "$ro" != "true" ]; then
      raw="write tool skipped during retry — re-run manually"
      is_error=true
      skip_run=true
    fi
  fi
  if ! "$skip_run"; then
    if raw=$(run_tool "$tool_name" "$tool_input"); then is_error=false; else is_error=true; fi
  fi
  output=$(truncate_output "$raw")
  # The fence is built with \u003c/\u003e escapes so this file keeps no literal angle-bracket
  # external_data tags of its own (they would otherwise be escaped when read back); jq decodes
  # them to the opening and closing fence tags at runtime.
  jq -nc --arg id "$tool_id" --arg content "$output" --arg src "$tool_name" --argjson is_error "$is_error" '
    ($src | gsub("[^A-Za-z0-9_.:-]"; "")) as $s0
    | (if ($s0 | length) > 0 then $s0 else "tool" end) as $safe_src
    | ($content | [scan("<\\s*/\\s*external_data\\s*>"; "i")] | length) as $n
    | ($content | gsub("<\\s*/\\s*external_data\\s*>"; "&lt;/external_data&gt;"; "i")) as $safe
    | (if $n > 0 then $safe + "\n[note: " + ($n|tostring) + " external_data tag(s) escaped in this content]" else $safe end) as $safe_note
    | {type:"tool_result", source:"tool",
       payload:{tool_call_id:$id,
                content:("\u003cexternal_data source=\"" + $safe_src + "\">\n" + $safe_note + "\n\u003c/external_data\u003e"),
                is_error:$is_error}}'
done < <(jq -c '
  select(.type=="message" and .source=="assistant")
  | .payload.tool_calls[]?
  | {name: .function.name, id: .id, input: (.function.arguments // "{}" | try fromjson catch {})}
')

[ "$tool_calls" -gt 0 ] && exit 1 || exit 0
