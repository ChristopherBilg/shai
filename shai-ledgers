#!/bin/bash
# shai-ledgers -- list workflow ledger entries and summaries
# Usage: shai-ledgers [--workflow NAME] [--recent N] [--after DATE] [--before DATE] [--json]
# Reads: $SHAI_HOME/ledgers/*.jsonl
# Writes: stdout (ledger listing)
# Exit: 0 on success; 1 on invalid arguments or no match
set -euo pipefail

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
LEDGERS_DIR="$STATE_DIR/ledgers"

WORKFLOW="" RECENT="" AFTER="" BEFORE="" JSON=false

while [ $# -gt 0 ]; do
  case "$1" in
    --workflow)
      shift
      WORKFLOW="${1:-}"
      if [ -z "$WORKFLOW" ]; then
        printf 'error: --workflow requires a name or prefix\n' >&2
        exit 1
      fi
      if [[ "$WORKFLOW" =~ [/] ]] || [[ "$WORKFLOW" == *..* ]]; then
        printf 'error: --workflow must not contain / or .. (got "%s")\n' "$WORKFLOW" >&2
        exit 1
      fi
      ;;
    --recent)
      shift
      RECENT="${1:-}"
      if [ -z "$RECENT" ]; then
        printf 'error: --recent requires a value\n' >&2
        exit 1
      fi
      if ! [[ "$RECENT" =~ ^[0-9]+$ ]]; then
        printf 'error: --recent value must be an integer\n' >&2
        exit 1
      fi
      ;;
    --after)
      shift
      AFTER="${1:-}"
      if [ -z "$AFTER" ]; then
        printf 'error: --after requires a date (YYYY-MM-DD)\n' >&2
        exit 1
      fi
      if ! [[ "$AFTER" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        printf 'error: --after date must be YYYY-MM-DD\n' >&2
        exit 1
      fi
      ;;
    --before)
      shift
      BEFORE="${1:-}"
      if [ -z "$BEFORE" ]; then
        printf 'error: --before requires a date (YYYY-MM-DD)\n' >&2
        exit 1
      fi
      if ! [[ "$BEFORE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        printf 'error: --before date must be YYYY-MM-DD\n' >&2
        exit 1
      fi
      ;;
    --json) JSON=true ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 1
      ;;
  esac
  shift
done

# A ledger entry carries an ISO-8601 `ts`, not a date-bearing filename, so the date
# window is applied inside jq against `.ts[:10]`. Open ends become sentinel bounds
# ("" sorts before every date, "9999-99-99" after every date) so one comparison
# covers all four flag combinations.
AFTER_BOUND="$AFTER"
BEFORE_BOUND="${BEFORE:-9999-99-99}"
DATE_FILTER=false
if [ -n "$AFTER" ] || [ -n "$BEFORE" ]; then DATE_FILTER=true; fi

# resolve_prefix <prefix> <dir> <suffix>: the single "<dir>/<prefix>*<suffix>" match,
# printed to stdout with no trailing newline. No match or an ambiguous match is an
# error on stderr (listing the candidates) and a non-zero return.
resolve_prefix() {
  local prefix="$1" dir="$2" suffix="${3:-}"
  local matches=()
  for entry in "$dir"/"${prefix}"*"$suffix"; do
    [ -e "$entry" ] || continue
    matches+=("$entry")
  done
  if [ ${#matches[@]} -eq 0 ]; then
    printf 'error: no match for "%s"\n' "$prefix" >&2
    return 1
  elif [ ${#matches[@]} -gt 1 ]; then
    printf 'error: ambiguous prefix "%s" matches:\n' "$prefix" >&2
    for m in "${matches[@]}"; do printf '  %s\n' "$(basename "$m" "$suffix")" >&2; done
    return 1
  fi
  printf '%s' "${matches[0]}"
}

# Extract ledger metrics ({entries, oldest, latest}) from a JSONL ledger on stdin,
# counting only the entries that fall inside the requested date window.
ledger_metrics() {
  jq -sc --arg after "$AFTER_BOUND" --arg before "$BEFORE_BOUND" '
    [.[] | select(((.ts // "")[:10]) >= $after and ((.ts // "")[:10]) <= $before)] |
    {
      entries: length,
      oldest: (if length == 0 then null else (map(.ts // "") | sort | first) end),
      latest: (if length == 0 then null else (map(.ts // "") | sort | last) end)
    }'
}

# Render the date-filtered entries of the JSONL ledger on stdin, chronologically,
# as one compact {key, marked, session_id} object per line.
ledger_entries() {
  jq -sc --arg after "$AFTER_BOUND" --arg before "$BEFORE_BOUND" '
    [.[] | select(((.ts // "")[:10]) >= $after and ((.ts // "")[:10]) <= $before)]
    | sort_by(.ts)
    | .[]
    | {key: (.key // ""), marked: (.ts // ""), session_id: (.session_id // "")}'
}

# Fields are joined with a real tab; jq's compact output never emits a raw tab
# byte (control characters are escaped as \t inside JSON strings), so a literal
# tab is a safe, unambiguous separator between the workflow name and its metrics.
TAB=$'\t'

entries=()

if [ -n "$WORKFLOW" ]; then
  ledger_file=$(resolve_prefix "$WORKFLOW" "$LEDGERS_DIR" ".jsonl") || exit 1
  # Single jq -R pass validates and parses in one process (scales to unbounded
  # ledgers). fromjson? silently drops truncated trailing lines from crash
  # mid-append; the count of dropped lines is reported as a warning.
  total_lines=$(grep -c '.' "$ledger_file" 2>/dev/null) || total_lines=0
  valid_json=$(jq -Rc 'fromjson? // empty | select(type == "object")' <"$ledger_file" 2>/dev/null) || true
  if [ -n "$valid_json" ]; then
    valid_count=$(printf '%s\n' "$valid_json" | grep -c '.' 2>/dev/null) || valid_count=0
  else
    valid_count=0
  fi
  bad=$((total_lines - valid_count))
  if [ "$bad" -gt 0 ]; then
    printf 'warning: %s: dropped %d malformed line(s)\n' "$ledger_file" "$bad" >&2
  fi
  if [ "$valid_count" -gt 0 ]; then
    if entry_json=$(printf '%s\n' "$valid_json" | ledger_entries 2>/dev/null); then
      [ -n "$entry_json" ] && mapfile -t entries <<<"$entry_json"
    else
      printf 'warning: %s: entry extraction failed\n' "$ledger_file" >&2
    fi
  fi
else
  for f in "$LEDGERS_DIR"/*.jsonl; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .jsonl)
    # Pre-filter: parse valid JSON objects so a truncated trailing line no longer
    # drops the entire workflow row from the summary.
    filtered=$(jq -Rc 'fromjson? // empty | select(type == "object")' <"$f" 2>/dev/null) || true
    total_lines=$(grep -c '.' "$f" 2>/dev/null) || total_lines=0
    if [ -n "$filtered" ]; then
      valid_lines=$(printf '%s\n' "$filtered" | grep -c '.' 2>/dev/null) || valid_lines=0
    else
      valid_lines=0
    fi
    bad_lines=$((total_lines - valid_lines))
    if [ "$bad_lines" -gt 0 ]; then
      printf 'warning: %s: dropped %d malformed line(s)\n' "$f" "$bad_lines" >&2
    fi
    if ! metrics=$(printf '%s' "$filtered" | ledger_metrics 2>/dev/null); then
      printf 'warning: skipping %s (parse error)\n' "$f" >&2
      continue
    fi
    # An empty ledger is still worth listing (it shows as 0 entries), but a ledger
    # with nothing inside an explicit date window is out of scope for that query.
    if [ "$DATE_FILTER" = true ] && [ "$(printf '%s' "$metrics" | jq -r '.entries')" = "0" ]; then
      continue
    fi
    entries+=("$name$TAB$metrics")
  done
fi

# Summary rows sort alphabetically by workflow name (ledger filenames carry no
# timestamp); entry rows are already chronological courtesy of jq's sort_by(.ts).
# Guard the empty case explicitly rather than feeding zero arguments through
# printf/sort/mapfile: printf '%s\n' with no arguments still emits one blank line,
# which would otherwise become a single bogus empty entry.
sorted=()
if [ "${#entries[@]}" -gt 0 ]; then
  if [ -n "$WORKFLOW" ]; then
    sorted=("${entries[@]}")
  else
    mapfile -t sorted < <(printf '%s\n' "${entries[@]}" | sort)
  fi
fi

# Apply --recent. Handled as its own branch: `${arr[@]: -0}` is not "the last
# zero elements" -- a negative offset of -0 is arithmetically 0, so bash would
# treat it as "from the start" and return the whole array instead of none.
if [ -n "$RECENT" ]; then
  if [ "$RECENT" -eq 0 ]; then
    sorted=()
  elif [ "${#sorted[@]}" -gt "$RECENT" ]; then
    sorted=("${sorted[@]: -$RECENT}")
  fi
fi

if [ "${#sorted[@]}" -eq 0 ]; then
  if [ "$JSON" = true ]; then printf '[]\n'; fi
  exit 0
fi

if [ "$JSON" = true ]; then
  printf '['
  first=true
  for entry in "${sorted[@]}"; do
    "$first" || printf ','
    first=false
    if [ -n "$WORKFLOW" ]; then
      printf '%s' "$entry"
    else
      wf="${entry%%"$TAB"*}"
      metrics="${entry#*"$TAB"}"
      printf '%s' "$metrics" | jq -c --arg wf "$wf" '{workflow: $wf} + .'
    fi
  done
  printf ']\n'
elif [ -n "$WORKFLOW" ]; then
  printf '%-40s %-20s  %s\n' "KEY" "MARKED" "SESSION"
  for entry in "${sorted[@]}"; do
    key=$(printf '%s' "$entry" | jq -r '.key')
    marked=$(printf '%s' "$entry" | jq -r '.marked')
    sid=$(printf '%s' "$entry" | jq -r '.session_id')
    printf '%-40s %-20s  %s\n' "$key" "$marked" "$sid"
  done
else
  printf '%-30s %7s  %-20s  %s\n' "WORKFLOW" "ENTRIES" "OLDEST" "LATEST"
  for entry in "${sorted[@]}"; do
    wf="${entry%%"$TAB"*}"
    metrics="${entry#*"$TAB"}"
    count=$(printf '%s' "$metrics" | jq -r '.entries')
    oldest=$(printf '%s' "$metrics" | jq -r '.oldest // "--"')
    latest=$(printf '%s' "$metrics" | jq -r '.latest // "--"')
    printf '%-30s %7s  %-20s  %s\n' "$wf" "$count" "$oldest" "$latest"
  done
fi
