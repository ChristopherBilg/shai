#!/bin/bash
# shai-eval — the only network hop: call the OpenAI-compatible chat-completions API
# Usage: cat request.json | shai-eval [--tools-file <path>|--model M|--max-tokens N|--dry-run|--health-check]
# Reads: a {messages} request JSON on stdin; SHAI_API_KEY, SHAI_API_URL (full endpoint URL)
#        and SHAI_MODEL (all required; --model overrides SHAI_MODEL); SHAI_RUN_ID /
#        SHAI_SPAN_ID from the environment to locate the per-span request/response dumps;
#        SHAI_MAX_TOKENS (default 384000) for the output token budget;
#        SHAI_EVAL_TIMEOUT (default 7200) for the curl --max-time ceiling in seconds;
#        SHAI_EVAL_RETRIES (default 2, max 10) for retry count on transient failures
# Writes: one assistant/error event (assistant events carry an `api` key: message_id, model,
#         usage, latency_ms); on a real call, also dumps the request, and on success the response
#         metadata, to $SHAI_HOME/runs/<run_id>/<span_id>-{request,response}.json (best-effort);
#         --dry-run prints payload; retry progress to stderr
# Exit: 0 always; --health-check exits 1 if any of SHAI_API_KEY / SHAI_API_URL / SHAI_MODEL
#        is missing; 2 on bad CLI args or a non-integer SHAI_MAX_TOKENS / SHAI_EVAL_TIMEOUT /
#        SHAI_EVAL_RETRIES (or SHAI_EVAL_RETRIES above 10)
set -euo pipefail

STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
MODEL="${SHAI_MODEL:-}"
MAX_TOKENS="${SHAI_MAX_TOKENS:-384000}"
DRY_RUN=false
HEALTH_CHECK=false
API_URL="${SHAI_API_URL:-}"
TOOLS_FILE=""

# missing_config [--dry-run]: names of the required provider variables that are unset, joined
# with a message. --dry-run omits the credentials: shai-eval --dry-run prints the payload
# without calling out, so it needs only the model (which the payload embeds), and requiring a
# key would break offline payload inspection.
missing_config() {
  local for_dry_run="${1:-}" missing=()
  [ -n "${SHAI_API_KEY:-}" ] || [ "$for_dry_run" = "--dry-run" ] || missing+=(SHAI_API_KEY)
  [ -n "${SHAI_API_URL:-}" ] || [ "$for_dry_run" = "--dry-run" ] || missing+=(SHAI_API_URL)
  [ -n "$MODEL" ] || missing+=(SHAI_MODEL)
  [ "${#missing[@]}" -eq 0 ] && return 1
  local names verb
  # "${missing[*]}" with IFS=', ' would join on only the first IFS char (a comma with no
  # space) -- $IFS multi-char join only applies to word-splitting, not array-to-string
  # joining. Build ", "-joined text explicitly instead: repeat ", %s" per element, then
  # strip the one leading ", ".
  names=$(printf ', %s' "${missing[@]}")
  names="${names#, }"
  if [ "${#missing[@]}" -eq 1 ]; then verb="is"; else verb="are"; fi
  printf '%s %s not set' "$names" "$verb"
  return 0
}

EVAL_TIMEOUT="${SHAI_EVAL_TIMEOUT:-7200}"
case "$EVAL_TIMEOUT" in
  '' | 0* | *[!0-9]*)
    printf 'error: SHAI_EVAL_TIMEOUT must be a positive integer (got "%s")\n' "$EVAL_TIMEOUT" >&2
    exit 2
    ;;
esac

EVAL_RETRIES="${SHAI_EVAL_RETRIES:-2}"
case "$EVAL_RETRIES" in
  '' | *[!0-9]*)
    printf 'error: SHAI_EVAL_RETRIES must be a non-negative integer (got "%s")\n' "$EVAL_RETRIES" >&2
    exit 2
    ;;
esac
# Cap retries so the 1 << ATTEMPT backoff stays inside bash's signed 64-bit arithmetic (at
# ATTEMPT >= 63 the shift wraps negative and `sleep` fails under set -e — a crash in code whose
# contract is never to crash). 10 retries => max backoff 2^10 s (~17 min).
[ "$EVAL_RETRIES" -gt 10 ] && {
  printf 'error: SHAI_EVAL_RETRIES must be at most 10 (got "%s")\n' "$EVAL_RETRIES" >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tools-file)
      [ "$#" -lt 2 ] && {
        echo "error: --tools-file requires a path" >&2
        exit 2
      }
      TOOLS_FILE="$2"
      shift 2
      ;;
    --model)
      [ "$#" -lt 2 ] && {
        echo "error: --model requires a value" >&2
        exit 2
      }
      MODEL="$2"
      shift 2
      ;;
    --max-tokens)
      [ "$#" -lt 2 ] && {
        echo "error: --max-tokens requires a value" >&2
        exit 2
      }
      case "$2" in
        '' | 0* | *[!0-9]*)
          echo "error: --max-tokens must be a positive integer" >&2
          exit 2
          ;;
      esac
      MAX_TOKENS="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --health-check)
      HEALTH_CHECK=true
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
done

if [ "$HEALTH_CHECK" = true ]; then
  if MSG=$(missing_config); then
    printf 'error: %s\n' "$MSG" >&2
    exit 1
  fi
  exit 0
fi

INPUT=$(cat)
if [ -z "$(printf '%s' "$INPUT" | tr -d '[:space:]')" ]; then
  exit 0
fi

# Validate the final MAX_TOKENS (env default or --max-tokens override): a non-integer value
# would make `jq --argjson` fail in the PAYLOAD build below and abort this script under
# `set -e` — and with pipefail, the whole shai-loop pipeline with it — instead of failing
# cleanly with a controlled exit (same positive-integer rule as --max-tokens and
# SHAI_MAX_CONTEXT_BYTES).
case "$MAX_TOKENS" in
  '' | 0* | *[!0-9]*)
    echo "error: --max-tokens / SHAI_MAX_TOKENS must be a positive integer (got \"$MAX_TOKENS\")" >&2
    exit 2
    ;;
esac

# Required provider configuration. Placed here deliberately: after the empty-stdin guard (so
# empty input stays a silent no-op), after the MAX_TOKENS validation (so a usage error still
# exits 2 and takes precedence), after arg parsing (so --model can satisfy SHAI_MODEL), and
# before the payload build (so `model` is never empty in a request). Missing config is an
# error event with exit 0 — this script must never crash the loop.
DRY_FLAG=""
[ "$DRY_RUN" = true ] && DRY_FLAG="--dry-run"
if MSG=$(missing_config "$DRY_FLAG"); then
  jq -nc --arg text "$MSG" '{type:"error", source:"system", payload:{text:$text}}'
  exit 0
fi

TOOLS_JSON="[]"
if [ -n "$TOOLS_FILE" ]; then
  TOOLS_JSON=$(cat "$TOOLS_FILE" 2>/dev/null) || TOOLS_JSON="[]"
fi

PAYLOAD=$(printf '%s' "$INPUT" | jq -c \
  --arg model "$MODEL" \
  --argjson max_tokens "$MAX_TOKENS" \
  --argjson tools "$TOOLS_JSON" '
  {model: $model, max_tokens: $max_tokens, messages: .messages,
   thinking: {type: "enabled"}, reasoning_effort: "max"}
  + (if ($tools | length) > 0 then {tools: $tools} else {} end)
')

if [ "$DRY_RUN" = true ]; then
  printf '%s\n' "$PAYLOAD"
  exit 0
fi

# best-effort observability: dump the exact request we're about to send (never fail the loop)
if [ -n "${SHAI_RUN_ID:-}" ]; then
  RUN_DIR="$STATE_DIR/runs/$SHAI_RUN_ID"
  REQ_FILE="$RUN_DIR/${SHAI_SPAN_ID:-span_0}-request.json"
  { mkdir -p "$RUN_DIR" && printf '%s\n' "$PAYLOAD" >"$REQ_FILE"; } 2>/dev/null || true
fi

ATTEMPT=0
CURL_FAILED=false
while true; do
  CURL_FAILED=false

  # date failure (nonzero exit) falls back to the literal string "0"; a `date` with no %N support
  # (non-GNU) exits 0 but emits non-numeric text instead -- guarded below, before it ever reaches
  # arithmetic, since `$(( ))` cannot safely catch its own malformed-operand error via `|| fallback`.
  # Captured per attempt so latency_ms reflects the successful call, not the backoff sleeps.
  _START_MS=$(date +%s%3N 2>/dev/null || printf '0')
  # --connect-timeout bounds only the TCP/TLS handshake, so a stalled connect fails in 30s and
  # reaches the retry loop instead of consuming the whole SHAI_EVAL_TIMEOUT (up to 2h per attempt).
  # Deliberately no --speed-limit/--speed-time: this is a non-streaming request, so curl receives
  # no body bytes while the model generates — a speed-based bound would abort every legitimate
  # long generation, which is exactly what the raised timeout exists to allow.
  RESPONSE=$(printf '%s' "$PAYLOAD" | curl -sS --connect-timeout 30 --max-time "$EVAL_TIMEOUT" -w '\n%{http_code}' -X POST "$API_URL" \
    -H "content-type: application/json" \
    -H "Authorization: Bearer $SHAI_API_KEY" \
    -d @-) || CURL_FAILED=true

  if [ "$CURL_FAILED" = true ]; then
    if [ "$ATTEMPT" -lt "$EVAL_RETRIES" ]; then
      BACKOFF=$((1 << ATTEMPT))
      printf 'shai-eval: retrying (attempt %d/%d) after curl failure, backoff %ds\n' \
        "$((ATTEMPT + 2))" "$((EVAL_RETRIES + 1))" "$BACKOFF" >&2
      sleep "$BACKOFF"
      ATTEMPT=$((ATTEMPT + 1))
      continue
    fi
    jq -nc '{type:"error", source:"system", payload:{text:"request failed (curl)"}}'
    exit 0
  fi

  HTTP_CODE=$(printf '%s' "$RESPONSE" | tail -n1)
  BODY=$(printf '%s' "$RESPONSE" | sed '$d')

  if [ "$HTTP_CODE" = "200" ]; then
    break
  fi

  # 429 and 5xx are transient — retry if attempts remain
  if { [ "$HTTP_CODE" = "429" ] || [ "$HTTP_CODE" -ge 500 ] 2>/dev/null; } && [ "$ATTEMPT" -lt "$EVAL_RETRIES" ]; then
    BACKOFF=$((1 << ATTEMPT))
    printf 'shai-eval: retrying (attempt %d/%d) after HTTP %s, backoff %ds\n' \
      "$((ATTEMPT + 2))" "$((EVAL_RETRIES + 1))" "$HTTP_CODE" "$BACKOFF" >&2
    sleep "$BACKOFF"
    ATTEMPT=$((ATTEMPT + 1))
    continue
  fi

  # non-retryable error or retries exhausted
  MSG=$(printf '%s' "$BODY" | jq -r '.error.message // empty' 2>/dev/null || true)
  [ -z "$MSG" ] && MSG="HTTP $HTTP_CODE"
  jq -nc --arg text "$MSG" '{type:"error", source:"system", payload:{text:$text}}'
  exit 0
done

_END_MS=$(date +%s%3N 2>/dev/null || printf '0')
LATENCY_MS=0
case "$_START_MS$_END_MS" in
  *[!0-9]*) : ;; # non-numeric on either side (date failed, or lacks %N support) -- leave 0
  *)
    LATENCY_MS=$((_END_MS - _START_MS))
    [ "$LATENCY_MS" -lt 0 ] && LATENCY_MS=0 # never report negative latency (e.g. clock skew)
    ;;
esac

if OUT=$(printf '%s' "$BODY" | jq -c --argjson latency "$LATENCY_MS" '
  if (.error // null) != null then
    {type:"error", source:"system", payload:{text: (.error.message // "unknown API error")}}
  elif (.choices // null) != null and ((.choices | length) > 0) then
    .choices[0].message as $msg |
    {type:"message", source:"assistant",
     payload:{content: ($msg.content // null), tool_calls: ($msg.tool_calls // null), finish_reason: .choices[0].finish_reason},
     api:{message_id: .id, model: .model, usage: .usage, latency_ms: $latency}}
    | if .payload.tool_calls == null then del(.payload.tool_calls) else . end
    | if (.payload.content // null) == null or .payload.content == "" then del(.payload.content) else . end
  else error("unexpected response shape")
  end' 2>/dev/null) && [ -n "$OUT" ]; then
  printf '%s\n' "$OUT"
else
  jq -nc '{type:"error", source:"system", payload:{text:"unparseable or unexpected API response (HTTP 200)"}}'
fi

# best-effort observability: dump response metadata alongside the request dump (never fail the
# loop). select() only matches a real assistant response, so API-level errors under HTTP 200
# (and any other non-assistant/malformed body) leave RESP_DUMP empty and no file is written.
if [ -n "${SHAI_RUN_ID:-}" ]; then
  {
    RESP_DUMP=$(printf '%s' "$BODY" | jq -c --argjson lat "$LATENCY_MS" '
      select((.choices // null) != null and ((.choices | length) > 0)) |
      {message_id: .id, model: .model, usage: .usage, finish_reason: .choices[0].finish_reason, latency_ms: $lat}
    ')
    [ -n "$RESP_DUMP" ] && printf '%s\n' "$RESP_DUMP" \
      >"$STATE_DIR/runs/$SHAI_RUN_ID/${SHAI_SPAN_ID:-span_0}-response.json"
  } 2>/dev/null || true
fi
