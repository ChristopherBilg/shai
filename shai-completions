#!/bin/bash
# shai-completions — generate self-contained zsh/bash tab completions from the completions manifest
# Usage: shai-completions generate <zsh|bash>
#        shai-completions check
# Reads: $DIR/completions.json (completion manifest: scripts, flags, subcommands, types)
# Writes: the requested completion script on stdout (generate); check writes nothing on success
# Exit: 0 on success; 1 on generation failure (invalid manifest, jq error) or check failure;
#       2 on usage error
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
MANIFEST="$DIR/completions.json"

usage() {
  printf 'Usage: shai-completions generate <zsh|bash>\n' >&2
  printf '       shai-completions check\n' >&2
}

# Each generator is a pure jq program: completions.json in, shell-specific
# completion script out. The output has no runtime dependency on the manifest —
# dynamic candidates are baked in as shell functions that resolve at completion
# time. Keys are emitted in manifest order (to_entries), never sorted-and-merged,
# so the output is byte-deterministic for a given manifest.
ZSH_PROGRAM="$(
  cat <<'JQEOF'
. as $root |
def esc: gsub("'"; "'\"'\"'");
def type_action($t):
  if $t == "" then ""
  elif (($root.types[$t].command // "") != "") then "_shai_type_" + $t
  elif $root.types[$t].builtin == true then "_files"
  elif (($root.types[$t].hint // "") != "") then "_message -e " + $t + " " + (("'" + $root.types[$t].hint + "'") | esc)
  else error("completions.json: type '" + $t + "' has no command, builtin, or hint") end;
def flag_spec($long; $v):
  ("[" + ($v.description | esc) + "]"
   + (if (($v.arg // "") != "") then ":" + $v.arg + ":" + type_action($v.arg_type // "") else "" end)) as $body
  | if (($v.short // "") != "") then
      "(-" + ($v.short | ltrimstr("-")) + " " + $long + ")'{-" + ($v.short | ltrimstr("-")) + "," + $long + "}'" + $body
    else
      $long + $body
    end;
def specs_for($scope; $posbase):
  (($scope.flags // {}) | to_entries | map(flag_spec(.key; .value)))
  + (($scope.positional // []) | to_entries | map((($posbase + .key) | tostring) + ":" + .value.name + ":" + type_action(.value.type)));
def arg_call($specs; $indent):
  if ($specs | length) == 0 then $indent + "_arguments -S"
  else
    $indent + "_arguments -S \\\n"
    + ($specs | map($indent + "  '" + . + "'") | join(" \\\n"))
  end;
def dirblock:
  [ "_shai_bin=\"$(command -v shai-repl 2>/dev/null)\" || _shai_bin=\"\""
  , "if [ -n \"$_shai_bin\" ] && [ -f \"$_shai_bin\" ]; then"
  , "  _shai_dir=\"$(sed -n '2s/^exec .\\(.*\\)\\/shai-repl.*/\\1/p' \"$_shai_bin\" 2>/dev/null)\""
  , "  if [ -z \"$_shai_dir\" ]; then"
  , "    _shai_dir=\"$(readlink -f \"$_shai_bin\" 2>/dev/null)\" || _shai_dir=\"$_shai_bin\""
  , "    _shai_dir=\"$(cd \"$(dirname \"$_shai_dir\")\" 2>/dev/null && pwd)\""
  , "  fi"
  , "else"
  , "  _shai_dir=\"\""
  , "fi"
  , "unset _shai_bin"
  ];
def ztype_lines:
  .key as $name |
  .value as $v |
  [ "(( $+functions[_shai_type_" + $name + "] )) ||"
  , "_shai_type_" + $name + "() {"
  , "  local -a items"
  , "  local line"
  , (if ($v.command | contains("_shai_dir")) then
       "  if [ -n \"${_shai_dir:-}\" ] && [ -d \"${_shai_dir:-}\" ]; then\n"
       + "    while IFS= read -r line; do\n"
       + "      [ -n \"$line\" ] || continue\n"
       + "      items+=(\"${line/$'\\t'/:}\")\n"
       + "    done < <(" + $v.command + ")\n"
       + "  fi\n"
       + "  _describe -t " + $name + " '" + ($v.description | esc) + "' items"
     else
       "  while IFS= read -r line; do\n"
       + "    [ -n \"$line\" ] || continue\n"
       + "    items+=(\"${line/$'\\t'/:}\")\n"
       + "  done < <(" + $v.command + ")\n"
       + "  _describe -t " + $name + " '" + ($v.description | esc) + "' items"
     end)
  , "}"
  ];
def zscript_lines:
  .key as $name |
  .value as $s |
  if ((($s.subcommands // {}) | length) > 0) then
    [ "_" + $name + "() {"
    , "  local -a cmds"
    , "  cmds=("
    ]
    + (($s.subcommands // {}) | to_entries | map("    '" + .key + ":" + (.value.description | esc) + "'"))
    + [ "  )"
    , "  if (( CURRENT == 2 )); then"
    , "    _describe -t subcommands 'subcommand' cmds"
    , "    return"
    , "  fi"
    , "  case \"${words[2]:-}\" in"
    ]
    + (($s.subcommands // {}) | to_entries | map(
        [ "    " + .key + ")"
        , arg_call(["1:subcommand"] + specs_for(.value; 2); "      ")
        , "      ;;"
        ]) | flatten)
    + [ "    *)"
    , arg_call(["1:subcommand"] + specs_for($s; 2); "      ")
    , "      ;;"
    , "  esac"
    , "}"
    ]
  else
    [ "_" + $name + "() {"
    , arg_call(specs_for($s; 1); "  ")
    , "}"
    ]
  end;
[ "#compdef " + ($root.scripts | keys_unsorted | join(" "))
, "# Generated by shai-completions generate — do not edit manually"
, "# Sources: completions.json — candidates resolve dynamically at completion time."
, ""
, "# Resolve the shai install directory once at load time: install.sh wrappers exec"
, "# '<install-dir>/shai-repl'; dev clones put the real script on $PATH. Falls back"
, "# gracefully when shai-repl is not on $PATH (install-dir candidates return none)."
]
+ dirblock
+ [ ""
, "# Dynamic candidate functions: one per completions.json type with a command."
]
+ ($root.types | to_entries | map(select((.value.command // "") != "")) | map(ztype_lines) | flatten)
+ [ "" ]
+ ($root.scripts | to_entries | map(zscript_lines) | flatten)
+ [ "" ]
+ ($root.scripts | to_entries | map("compdef _" + .key + " " + .key))
| join("\n")
JQEOF
)"

BASH_PROGRAM="$(
  cat <<'JQEOF'
. as $root |
def bhook_lines($scope; $indent):
  [ ($scope.flags // {}) | to_entries[]
    | .key as $fkey | .value as $fv
    | ($root.types[$fv.arg_type // ""] // {}) as $t
    | if (($t.command // "") != "") then
        [ $indent + "if [[ \"$prev\" == \"" + $fkey + "\" ]]; then"
        , $indent + "  _shai_bash_" + $fv.arg_type
        , $indent + "  return"
        , $indent + "fi"
        ]
      elif ($t.builtin == true) then
        [ $indent + "if [[ \"$prev\" == \"" + $fkey + "\" ]]; then"
        , $indent + "  local IFS=$'\\n'"
        , $indent + "  COMPREPLY=( $(compgen -f -- \"$cur\") )"
        , $indent + "  compopt -o filenames 2>/dev/null"
        , $indent + "  return"
        , $indent + "fi"
        ]
      else [] end
  ] | flatten;
def bflag_words($scope):
  [ ($scope.flags // {}) | to_entries[] | .key ]
  + [ ($scope.flags // {}) | to_entries[] | select((.value.short // "") != "") | .value.short ];
def bflag_block($scope; $indent):
  if ((bflag_words($scope)) | length) > 0 then
    [ $indent + "if [[ \"$cur\" == -* ]]; then"
    , $indent + "  COMPREPLY=( $(compgen -W \"" + (bflag_words($scope) | join(" ")) + "\" -- \"$cur\") )"
    , $indent + "  return"
    , $indent + "fi"
    ]
  else [] end;
def bpos_scan($scope; $indent):
  # Count consumed positional words before the cursor, skipping boolean flags
  # and the value words of value-taking flags, so a flag value no longer hides
  # the positional slot (e.g. `shai-supervise install --interval 15min <TAB>`).
  [ $indent + "local _shai_pos=0 _shai_val=0 _shai_i"
  , $indent + "for (( _shai_i = 1; _shai_i < COMP_CWORD; _shai_i++ )); do"
  , $indent + "  case \"${COMP_WORDS[_shai_i]}\" in"
  ]
  + (($scope.flags // {}) | to_entries | map(select((.value.arg // "") != ""))
       | map([.key] + (if (.value.short // "") != "" then [.value.short] else [] end)) | flatten
       | map([
           $indent + "    " + . + ")"
         , $indent + "      if [ $((_shai_i + 1)) -ge \"$COMP_CWORD\" ]; then"
         , $indent + "        _shai_val=1"
         , $indent + "      fi"
         , $indent + "      _shai_i=$((_shai_i + 1))"
         , $indent + "      ;;"
         , $indent + "    " + . + "=*) : ;;"
         ]) | flatten)
  + [ $indent + "    -*) : ;;"
    , $indent + "    *)"
    , $indent + "      _shai_pos=$((_shai_pos + 1))"
    , $indent + "      ;;"
    , $indent + "  esac"
    , $indent + "done"
    ];
def bpos_block($scope; $posbase; $indent):
  if ((($scope.positional // []) | length) > 0) then
    ($root.types[($scope.positional // [])[0].type // ""] // {}) as $pt |
    if (($pt.command // "") != "") then
      bpos_scan($scope; $indent)
      + [ $indent + "if [ \"$_shai_val\" -eq 0 ] && [ \"$_shai_pos\" -eq " + (($posbase - 1) | tostring) + " ]; then"
        , $indent + "  _shai_bash_" + ($scope.positional // [])[0].type
        , $indent + "  return"
        , $indent + "fi"
        ]
    elif ($pt.builtin == true) then
      bpos_scan($scope; $indent)
      + [ $indent + "if [ \"$_shai_val\" -eq 0 ] && [ \"$_shai_pos\" -eq " + (($posbase - 1) | tostring) + " ]; then"
        , $indent + "  local IFS=$'\\n'"
        , $indent + "  COMPREPLY=( $(compgen -f -- \"$cur\") )"
        , $indent + "  compopt -o filenames 2>/dev/null"
        , $indent + "  return"
        , $indent + "fi"
        ]
    else [] end
  else [] end;
def dirblock:
  [ "_shai_bin=\"$(command -v shai-repl 2>/dev/null)\" || _shai_bin=\"\""
  , "if [ -n \"$_shai_bin\" ] && [ -f \"$_shai_bin\" ]; then"
  , "  _shai_dir=\"$(sed -n '2s/^exec .\\(.*\\)\\/shai-repl.*/\\1/p' \"$_shai_bin\" 2>/dev/null)\""
  , "  if [ -z \"$_shai_dir\" ]; then"
  , "    _shai_dir=\"$(readlink -f \"$_shai_bin\" 2>/dev/null)\" || _shai_dir=\"$_shai_bin\""
  , "    _shai_dir=\"$(cd \"$(dirname \"$_shai_dir\")\" 2>/dev/null && pwd)\""
  , "  fi"
  , "else"
  , "  _shai_dir=\"\""
  , "fi"
  , "unset _shai_bin"
  ];
def btype_lines:
  .key as $name |
  .value as $v |
  if ($v.command | contains("_shai_dir")) then
    [ "_shai_bash_" + $name + "() {"
    , "  local cur"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  if [ -z \"${_shai_dir:-}\" ] || [ ! -d \"${_shai_dir:-}\" ]; then"
    , "    COMPREPLY=()"
    , "    return"
    , "  fi"
    , "  COMPREPLY=( $(compgen -W \"$(" + $v.command + " | cut -f1)\" -- \"$cur\") )"
    , "}"
    ]
  else
    [ "_shai_bash_" + $name + "() {"
    , "  local cur"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  COMPREPLY=( $(compgen -W \"$(" + $v.command + " | cut -f1)\" -- \"$cur\") )"
    , "}"
    ]
  end;
def bscript_lines:
  .key as $name |
  .value as $s |
  ($name | gsub("-"; "_")) as $fn |
  if ((($s.subcommands // {}) | length) > 0) then
    [ "_" + $fn + "() {"
    , "  local cur prev"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  prev=\"${COMP_WORDS[COMP_CWORD-1]}\""
    , "  if [ \"$COMP_CWORD\" -eq 1 ]; then"
    , "    COMPREPLY=( $(compgen -W \"" + (($s.subcommands // {}) | keys_unsorted | join(" ")) + "\" -- \"$cur\") )"
    , "    return"
    , "  fi"
    , "  case \"${COMP_WORDS[1]}\" in"
    ]
    + (($s.subcommands // {}) | to_entries | map(
        [ "    " + .key + ")"
        ] + bhook_lines(.value; "      ") + bflag_block(.value; "      ") + bpos_block(.value; 2; "      ")
        + [ "      COMPREPLY=()"
          , "      ;;"
          ]
      ) | flatten)
    + [ "    *)"
    ] + bhook_lines($s; "      ") + bflag_block($s; "      ")
    + [ "      COMPREPLY=()"
    , "      ;;"
    , "  esac"
    , "}"
    , "complete -F _" + $fn + " " + $name
    ]
  else
    [ "_" + $fn + "() {"
    , "  local cur prev"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  prev=\"${COMP_WORDS[COMP_CWORD-1]}\""
    ]
    + bhook_lines($s; "  ") + bflag_block($s; "  ") + bpos_block($s; 1; "  ")
    + [ "  COMPREPLY=()"
    , "}"
    , "complete -F _" + $fn + " " + $name
    ]
  end;
[ "# Generated by shai-completions generate — do not edit manually"
, "# Sources: completions.json — candidates resolve dynamically at completion time."
, ""
, "# Resolve the shai install directory once at load time: install.sh wrappers exec"
, "# '<install-dir>/shai-repl'; dev clones put the real script on $PATH. Falls back"
, "# gracefully when shai-repl is not on $PATH (install-dir candidates return none)."
]
+ dirblock
+ [ ""
, "# Dynamic candidate helpers: one per completions.json type with a command."
]
+ ($root.types | to_entries | map(select((.value.command // "") != "")) | map(btype_lines) | flatten)
+ [ "" ]
+ ($root.scripts | to_entries | map(bscript_lines) | flatten)
| join("\n")
JQEOF
)"

generate() {
  local shell="$1" program err output
  case "$shell" in
    zsh) program="$ZSH_PROGRAM" ;;
    bash) program="$BASH_PROGRAM" ;;
  esac
  if ! jq -e 'type == "object" and (.scripts | type) == "object" and (.types | type) == "object"' \
    "$MANIFEST" >/dev/null 2>&1; then
    printf 'error: invalid completions manifest: %s\n' "$MANIFEST" >&2
    return 1
  fi
  err="$(mktemp)"
  if ! output="$(jq -r "$program" "$MANIFEST" 2>"$err")"; then
    printf 'error: completion generation failed: %s\n' "$(cat "$err")" >&2
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  printf '%s\n' "$output"
}

# extracted_flags <script>: flags parsed in case statements. Best-effort,
# not a formal parser: only case-arm-shaped flags count (a flag that is
# parsed via a variable or an unusual pattern is invisible here — the coverage
# check still catches the script itself). Emits one flag per line, sorted and deduped.
extracted_flags() {
  grep -oE -- '--[a-z][-a-z]*[[:space:]]*(\|[[:space:]]*--[a-z][-a-z]*)*\)' "$1" 2>/dev/null |
    sed 's/)$//' |
    tr '|' '\n' |
    grep -oE -- '--[a-z][-a-z]*' |
    sort -u || true
}

# flag_ignored <script> <flag>: a `# _completions_ignore:` comment naming the flag in
# the script suppresses a best-effort extraction false positive — e.g. a forwarded
# option collected in a PRINT_OPTS array that the script does not itself parse.
# Leading whitespace is allowed, so an indented comment (inside an if block) works too.
flag_ignored() {
  grep -qE "^[[:space:]]*#[[:space:]]*_completions_ignore:[[:space:]]*.*[[:space:]]${2}([[:space:]]|$)" "$1"
}

# declared_flag <script> <flag>: the manifest declares the flag anywhere on the script —
# top-level flags or any subcommand's flags, as a long-form key or a short alias.
declared_flag() {
  jq -e --arg s "$1" --arg f "$2" '
    .scripts[$s]
    | ([.flags // {} | to_entries[]] + [.subcommands // {} | .[] | .flags // {} | to_entries[]])
    | any(.[]; .key == $f or (.value.short // "") == $f)
  ' "$MANIFEST" >/dev/null 2>&1
}

# check — the fail-closed validation engine, three checks in sequence:
#   1. Coverage: every git-tracked shai-* script has a completions.json entry.
#   2. Flag sync: every case-arm flag in those scripts is declared in the manifest.
#   3. Freshness: generate zsh/bash reproduce the checked-in completions/* files.
# Any failure prints an `error:` line (plus a diff for staleness) and exits 1.
check() {
  local script flag flags fail=0 tmp shell file scripts
  if ! scripts="$(git -C "$DIR" ls-files 'shai-*' 2>&1)"; then
    printf 'error: cannot list shai-* scripts (check must run inside a git checkout): %s\n' "$scripts" >&2
    return 1
  fi
  # 1. Coverage — derived from git, not hardcoded (the same fail-closed pattern as
  # tests/docs.sh): a new shai-* script with no manifest entry fails here.
  while IFS= read -r script; do
    [ -n "$script" ] || continue
    if ! jq -e --arg s "$script" '.scripts | has($s)' "$MANIFEST" >/dev/null 2>&1; then
      printf 'error: %s has no completions.json entry (add one and regenerate completions)\n' "$script" >&2
      fail=1
    fi
  done <<<"$scripts"
  # 2. Flag sync — script flags that the manifest does not declare. Manifest-only flags
  # are fine (declared but unused is a completion quality matter, not an error), and a
  # script with no manifest entry is skipped here because coverage already reported it.
  while IFS= read -r script; do
    [ -n "$script" ] || continue
    jq -e --arg s "$script" '.scripts | has($s)' "$MANIFEST" >/dev/null 2>&1 || continue
    flags="$(extracted_flags "$DIR/$script")"
    while IFS= read -r flag; do
      [ -n "$flag" ] || continue
      flag_ignored "$DIR/$script" "$flag" && continue
      if ! declared_flag "$script" "$flag"; then
        printf 'error: %s parses %s but completions.json declares no such flag\n' "$script" "$flag" >&2
        fail=1
      fi
    done <<<"$flags"
  done <<<"$scripts"
  # 3. Freshness — a manifest change without regeneration fails, like tests/tools-sync.sh.
  # generate runs in-process and writes to a temp file so the comparison sees true bytes:
  # command substitution would strip trailing newlines and let a file with a missing
  # final newline (or extra trailing blank lines) pass a byte-for-byte gate.
  for shell in zsh bash; do
    case "$shell" in
      zsh) file="_shai" ;;
      bash) file="shai.bash" ;;
    esac
    if ! tmp="$(mktemp)"; then
      printf 'error: cannot create temp file for the freshness comparison\n' >&2
      fail=1
      continue
    fi
    if ! generate "$shell" >"$tmp"; then
      printf 'error: generate %s failed — fix completions.json before checking freshness\n' "$shell" >&2
      rm -f "$tmp"
      fail=1
      continue
    fi
    if [ ! -f "$DIR/completions/$file" ]; then
      printf 'error: completions/%s is missing — run: shai-completions generate %s > completions/%s\n' "$file" "$shell" "$file" >&2
      rm -f "$tmp"
      fail=1
      continue
    fi
    if ! cmp -s "$tmp" "$DIR/completions/$file"; then
      printf 'error: completions/%s is stale — completions.json changed but the file was not regenerated\n' "$file" >&2
      diff -u "$DIR/completions/$file" "$tmp" >&2 || true
      fail=1
    fi
    rm -f "$tmp"
  done
  return "$fail"
}

main() {
  case "${1:-}" in
    generate)
      if [ -z "${2:-}" ] || [ "$#" -gt 2 ]; then
        usage
        return 2
      fi
      case "$2" in
        zsh | bash) generate "$2" ;;
        *)
          usage
          return 2
          ;;
      esac
      ;;
    check)
      if [ "$#" -gt 1 ]; then
        usage
        return 2
      fi
      check
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

main "$@"
