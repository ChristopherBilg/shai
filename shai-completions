#!/bin/bash
# shai-completions — generate self-contained zsh/bash tab completions from the completions manifest
# Usage: shai-completions generate <zsh|bash>
# Reads: $DIR/completions.json (completion manifest: scripts, flags, subcommands, types)
# Writes: the requested completion script on stdout
# Exit: 0 on success; 1 on generation failure (invalid manifest, jq error); 2 on usage error
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
MANIFEST="$DIR/completions.json"

usage() {
  printf 'Usage: shai-completions generate <zsh|bash>\n' >&2
}

# Each generator is a pure jq program: completions.json in, shell-specific
# completion script out. The output has no runtime dependency on the manifest —
# dynamic candidates are baked in as shell functions that resolve at completion
# time. Keys are emitted in manifest order (to_entries), never sorted-and-merged,
# so the output is byte-deterministic for a given manifest.
ZSH_PROGRAM="$(
  cat <<'JQEOF'
. as $root |
def esc: gsub("'"; "'\"'\"'");
def type_action($t):
  if $t == "" then ""
  elif (($root.types[$t].command // "") != "") then "_shai_type_" + $t
  elif $root.types[$t].builtin == true then "_files"
  elif (($root.types[$t].hint // "") != "") then "_message -e " + $t + " " + (("'" + $root.types[$t].hint + "'") | esc)
  else error("completions.json: type '" + $t + "' has no command, builtin, or hint") end;
def flag_spec($long; $v):
  ("[" + ($v.description | esc) + "]"
   + (if (($v.arg // "") != "") then ":" + $v.arg + ":" + type_action($v.arg_type // "") else "" end)) as $body
  | if (($v.short // "") != "") then
      "(-" + ($v.short | ltrimstr("-")) + " " + $long + ")'{-" + ($v.short | ltrimstr("-")) + "," + $long + "}'" + $body
    else
      $long + $body
    end;
def specs_for($scope; $posbase):
  (($scope.flags // {}) | to_entries | map(flag_spec(.key; .value)))
  + (($scope.positional // []) | to_entries | map((($posbase + .key) | tostring) + ":" + .value.name + ":" + type_action(.value.type)));
def arg_call($specs; $indent):
  if ($specs | length) == 0 then $indent + "_arguments -S"
  else
    $indent + "_arguments -S \\\n"
    + ($specs | map($indent + "  '" + . + "'") | join(" \\\n"))
  end;
def dirblock:
  [ "_shai_bin=\"$(command -v shai-repl 2>/dev/null)\" || _shai_bin=\"\""
  , "if [ -n \"$_shai_bin\" ] && [ -f \"$_shai_bin\" ]; then"
  , "  _shai_dir=\"$(sed -n '2s/^exec .\\(.*\\)\\/shai-repl.*/\\1/p' \"$_shai_bin\" 2>/dev/null)\""
  , "  if [ -z \"$_shai_dir\" ]; then"
  , "    _shai_dir=\"$(readlink -f \"$_shai_bin\" 2>/dev/null)\" || _shai_dir=\"$_shai_bin\""
  , "    _shai_dir=\"$(cd \"$(dirname \"$_shai_dir\")\" 2>/dev/null && pwd)\""
  , "  fi"
  , "else"
  , "  _shai_dir=\"\""
  , "fi"
  , "unset _shai_bin"
  ];
def ztype_lines:
  .key as $name |
  .value as $v |
  [ "(( $+functions[_shai_type_" + $name + "] )) ||"
  , "_shai_type_" + $name + "() {"
  , "  local -a items"
  , "  local line"
  , (if ($v.command | contains("_shai_dir")) then
       "  if [ -n \"${_shai_dir:-}\" ] && [ -d \"${_shai_dir:-}\" ]; then\n"
       + "    while IFS= read -r line; do\n"
       + "      [ -n \"$line\" ] || continue\n"
       + "      items+=(\"${line/$'\\t'/:}\")\n"
       + "    done < <(" + $v.command + ")\n"
       + "  fi\n"
       + "  _describe -t " + $name + " '" + ($v.description | esc) + "' items"
     else
       "  while IFS= read -r line; do\n"
       + "    [ -n \"$line\" ] || continue\n"
       + "    items+=(\"${line/$'\\t'/:}\")\n"
       + "  done < <(" + $v.command + ")\n"
       + "  _describe -t " + $name + " '" + ($v.description | esc) + "' items"
     end)
  , "}"
  ];
def zscript_lines:
  .key as $name |
  .value as $s |
  if ((($s.subcommands // {}) | length) > 0) then
    [ "_" + $name + "() {"
    , "  local -a cmds"
    , "  cmds=("
    ]
    + (($s.subcommands // {}) | to_entries | map("    '" + .key + ":" + (.value.description | esc) + "'"))
    + [ "  )"
    , "  if (( CURRENT == 2 )); then"
    , "    _describe -t subcommands 'subcommand' cmds"
    , "    return"
    , "  fi"
    , "  case \"${words[2]:-}\" in"
    ]
    + (($s.subcommands // {}) | to_entries | map(
        [ "    " + .key + ")"
        , arg_call(["1:subcommand"] + specs_for(.value; 2); "      ")
        , "      ;;"
        ]) | flatten)
    + [ "    *)"
    , arg_call(["1:subcommand"] + specs_for($s; 2); "      ")
    , "      ;;"
    , "  esac"
    , "}"
    ]
  else
    [ "_" + $name + "() {"
    , arg_call(specs_for($s; 1); "  ")
    , "}"
    ]
  end;
[ "#compdef " + ($root.scripts | keys_unsorted | join(" "))
, "# Generated by shai-completions generate — do not edit manually"
, "# Sources: completions.json — candidates resolve dynamically at completion time."
, ""
, "# Resolve the shai install directory once at load time: install.sh wrappers exec"
, "# '<install-dir>/shai-repl'; dev clones put the real script on $PATH. Falls back"
, "# gracefully when shai-repl is not on $PATH (install-dir candidates return none)."
]
+ dirblock
+ [ ""
, "# Dynamic candidate functions: one per completions.json type with a command."
]
+ ($root.types | to_entries | map(select((.value.command // "") != "")) | map(ztype_lines) | flatten)
+ [ "" ]
+ ($root.scripts | to_entries | map(zscript_lines) | flatten)
+ [ "" ]
+ ($root.scripts | to_entries | map("compdef _" + .key + " " + .key))
| join("\n")
JQEOF
)"

BASH_PROGRAM="$(
  cat <<'JQEOF'
. as $root |
def bhook_lines($scope; $indent):
  [ ($scope.flags // {}) | to_entries[]
    | .key as $fkey | .value as $fv
    | ($root.types[$fv.arg_type // ""] // {}) as $t
    | if (($t.command // "") != "") then
        [ $indent + "if [[ \"$prev\" == \"" + $fkey + "\" ]]; then"
        , $indent + "  _shai_bash_" + $fv.arg_type
        , $indent + "  return"
        , $indent + "fi"
        ]
      elif ($t.builtin == true) then
        [ $indent + "if [[ \"$prev\" == \"" + $fkey + "\" ]]; then"
        , $indent + "  COMPREPLY=( $(compgen -f -- \"$cur\") )"
        , $indent + "  return"
        , $indent + "fi"
        ]
      else [] end
  ] | flatten;
def bflag_words($scope):
  [ ($scope.flags // {}) | to_entries[] | .key ]
  + [ ($scope.flags // {}) | to_entries[] | select((.value.short // "") != "") | .value.short ];
def bflag_block($scope; $indent):
  if ((bflag_words($scope)) | length) > 0 then
    [ $indent + "if [[ \"$cur\" == -* ]]; then"
    , $indent + "  COMPREPLY=( $(compgen -W \"" + (bflag_words($scope) | join(" ")) + "\" -- \"$cur\") )"
    , $indent + "  return"
    , $indent + "fi"
    ]
  else [] end;
def bpos_block($scope; $posbase; $indent):
  if ((($scope.positional // []) | length) > 0) then
    ($root.types[($scope.positional // [])[0].type // ""] // {}) as $pt |
    if (($pt.command // "") != "") then
      [ $indent + "if [ \"$COMP_CWORD\" -eq " + ($posbase | tostring) + " ]; then"
      , $indent + "  _shai_bash_" + ($scope.positional // [])[0].type
      , $indent + "  return"
      , $indent + "fi"
      ]
    elif ($pt.builtin == true) then
      [ $indent + "if [ \"$COMP_CWORD\" -eq " + ($posbase | tostring) + " ]; then"
      , $indent + "  COMPREPLY=( $(compgen -f -- \"$cur\") )"
      , $indent + "  return"
      , $indent + "fi"
      ]
    else [] end
  else [] end;
def dirblock:
  [ "_shai_bin=\"$(command -v shai-repl 2>/dev/null)\" || _shai_bin=\"\""
  , "if [ -n \"$_shai_bin\" ] && [ -f \"$_shai_bin\" ]; then"
  , "  _shai_dir=\"$(sed -n '2s/^exec .\\(.*\\)\\/shai-repl.*/\\1/p' \"$_shai_bin\" 2>/dev/null)\""
  , "  if [ -z \"$_shai_dir\" ]; then"
  , "    _shai_dir=\"$(readlink -f \"$_shai_bin\" 2>/dev/null)\" || _shai_dir=\"$_shai_bin\""
  , "    _shai_dir=\"$(cd \"$(dirname \"$_shai_dir\")\" 2>/dev/null && pwd)\""
  , "  fi"
  , "else"
  , "  _shai_dir=\"\""
  , "fi"
  , "unset _shai_bin"
  ];
def btype_lines:
  .key as $name |
  .value as $v |
  if ($v.command | contains("_shai_dir")) then
    [ "_shai_bash_" + $name + "() {"
    , "  local cur"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  if [ -z \"${_shai_dir:-}\" ] || [ ! -d \"${_shai_dir:-}\" ]; then"
    , "    COMPREPLY=()"
    , "    return"
    , "  fi"
    , "  COMPREPLY=( $(compgen -W \"$(" + $v.command + " | cut -f1)\" -- \"$cur\") )"
    , "}"
    ]
  else
    [ "_shai_bash_" + $name + "() {"
    , "  local cur"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  COMPREPLY=( $(compgen -W \"$(" + $v.command + " | cut -f1)\" -- \"$cur\") )"
    , "}"
    ]
  end;
def bscript_lines:
  .key as $name |
  .value as $s |
  ($name | gsub("-"; "_")) as $fn |
  if ((($s.subcommands // {}) | length) > 0) then
    [ "_" + $fn + "() {"
    , "  local cur prev"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  prev=\"${COMP_WORDS[COMP_CWORD-1]}\""
    , "  if [ \"$COMP_CWORD\" -eq 1 ]; then"
    , "    COMPREPLY=( $(compgen -W \"" + (($s.subcommands // {}) | keys_unsorted | join(" ")) + "\" -- \"$cur\") )"
    , "    return"
    , "  fi"
    , "  case \"${COMP_WORDS[1]}\" in"
    ]
    + (($s.subcommands // {}) | to_entries | map(
        [ "    " + .key + ")"
        ] + bhook_lines(.value; "      ") + bflag_block(.value; "      ") + bpos_block(.value; 2; "      ")
        + [ "      COMPREPLY=()"
          , "      ;;"
          ]
      ) | flatten)
    + [ "    *)"
    ] + bhook_lines($s; "      ") + bflag_block($s; "      ")
    + [ "      COMPREPLY=()"
    , "      ;;"
    , "  esac"
    , "}"
    , "complete -F _" + $fn + " " + $name
    ]
  else
    [ "_" + $fn + "() {"
    , "  local cur prev"
    , "  cur=\"${COMP_WORDS[COMP_CWORD]}\""
    , "  prev=\"${COMP_WORDS[COMP_CWORD-1]}\""
    ]
    + bhook_lines($s; "  ") + bflag_block($s; "  ") + bpos_block($s; 1; "  ")
    + [ "  COMPREPLY=()"
    , "}"
    , "complete -F _" + $fn + " " + $name
    ]
  end;
[ "# Generated by shai-completions generate — do not edit manually"
, "# Sources: completions.json — candidates resolve dynamically at completion time."
, ""
, "# Resolve the shai install directory once at load time: install.sh wrappers exec"
, "# '<install-dir>/shai-repl'; dev clones put the real script on $PATH. Falls back"
, "# gracefully when shai-repl is not on $PATH (install-dir candidates return none)."
]
+ dirblock
+ [ ""
, "# Dynamic candidate helpers: one per completions.json type with a command."
]
+ ($root.types | to_entries | map(select((.value.command // "") != "")) | map(btype_lines) | flatten)
+ [ "" ]
+ ($root.scripts | to_entries | map(bscript_lines) | flatten)
| join("\n")
JQEOF
)"

generate() {
  local shell="$1" program err output
  case "$shell" in
    zsh) program="$ZSH_PROGRAM" ;;
    bash) program="$BASH_PROGRAM" ;;
  esac
  if ! jq -e 'type == "object" and (.scripts | type) == "object" and (.types | type) == "object"' \
    "$MANIFEST" >/dev/null 2>&1; then
    printf 'error: invalid completions manifest: %s\n' "$MANIFEST" >&2
    return 1
  fi
  err="$(mktemp)"
  if ! output="$(jq -r "$program" "$MANIFEST" 2>"$err")"; then
    printf 'error: completion generation failed: %s\n' "$(cat "$err")" >&2
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  printf '%s\n' "$output"
}

main() {
  if [ "${1:-}" != "generate" ]; then
    usage
    return 2
  fi
  if [ -z "${2:-}" ] || [ "$#" -gt 2 ]; then
    usage
    return 2
  fi
  case "$2" in
    zsh | bash) generate "$2" ;;
    *)
      usage
      return 2
      ;;
  esac
}

main "$@"
