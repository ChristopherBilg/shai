{
  "rules": [
    { "tool": "gh", "action": "allow" },
    { "tool": "git", "action": "allow" },
    { "tool": "jira", "args": { "args": "[\"issue\",\"view\",*]" }, "action": "allow" },
    { "tool": "ci", "args": { "cwd": "/tmp/*" }, "action": "allow" },
    { "tool": "write_file", "args": { "path": "/tmp/*" }, "action": "allow" },
    { "tool": "patch_file", "args": { "path": "/tmp/*" }, "action": "allow" },
    { "tool": "delete_file", "args": { "path": "/tmp/*" }, "action": "allow" },
    { "tool": "print_file", "args": { "path": "/tmp/*" }, "action": "allow" },
    { "tool": "list_directory", "args": { "path": "/tmp/*" }, "action": "allow" }
  ]
}
