#!/bin/bash
# shai-read — wrap raw stdin text into a message event
# Usage: printf '%s' text | shai-read [--system]
# Reads: raw text on stdin
# Writes: one JSON message event (source user, or system with --system); empty in → empty out
# Exit: 0 always
set -euo pipefail

SOURCE="user"
if [ "${1:-}" = "--system" ]; then
  SOURCE="system"
fi

input=$(cat)
if [ -z "$input" ]; then
  exit 0
fi

printf '%s' "$input" | jq -c -Rs --arg source "$SOURCE" \
  '{type: "message", source: $source, payload: {text: .}}'
