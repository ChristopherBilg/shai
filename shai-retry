#!/bin/bash
# shai-retry — resume an interrupted run from the append-only log (no re-prompt)
# Usage: shai-retry [-q|--quiet]
# Reads: nothing on stdin; operates on $SHAI_HOME state (sessions/<session_id>.jsonl, sessions/<session_id>.latest.json);
#        SHAI_SESSION_ID / SHAI_SCHEMA_VERSION from the environment if already set
# Writes: appends stamped assistant/tool_result events to sessions/<session_id>.jsonl and to
#         $SHAI_HOME/runs/<run_id>/events.jsonl (a resume mints a fresh run id); prints via shai-print
# Exit: 0 on success or when there's nothing to resume; 1 if a resume is needed but ANTHROPIC_API_KEY is missing
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="${SHAI_HOME:-$HOME/.shai}"
RUNS_DIR="$STATE_DIR/runs"

# mint_id <prefix> — UTC-sortable id with 4 urandom bytes for collision resistance
mint_id() {
  printf '%s_%s_%s' "$1" "$(date -u +%Y%m%dT%H%M%S)" "$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
}

# advance_span — step the trace chain; call at every iteration boundary
advance_span() {
  SPAN=$((SPAN + 1))
  export SHAI_PARENT_SPAN_ID="${SHAI_SPAN_ID:-}"
  export SHAI_SPAN_ID="span_$SPAN"
}

# an inherited session always wins; a resume is a NEW run, per the design doc
SHAI_SESSION_ID="${SHAI_SESSION_ID:-$(mint_id sess)}"
if [[ "$SHAI_SESSION_ID" =~ [/] ]] || [[ "$SHAI_SESSION_ID" == *..* ]]; then
  printf 'error: SHAI_SESSION_ID must not contain / or .. (got "%s")\n' "$SHAI_SESSION_ID" >&2
  exit 1
fi
export SHAI_SESSION_ID
export SHAI_SCHEMA_VERSION="${SHAI_SCHEMA_VERSION:-1.0}"

SESSIONS_DIR="$STATE_DIR/sessions"
SESSION_LOG="$SESSIONS_DIR/$SHAI_SESSION_ID.jsonl"
LATEST="$SESSIONS_DIR/$SHAI_SESSION_ID.latest.json"

SHAI_RUN_ID="$(mint_id run)"
export SHAI_RUN_ID
SPAN=0
SHAI_SPAN_ID=""

PRINT_OPTS=(--dispatches)
case "${1:-}" in
  -q | --quiet) PRINT_OPTS=() ;;
esac

if [ ! -s "$SESSION_LOG" ]; then
  printf 'nothing to resume\n'
  exit 0
fi

run_eval() {
  advance_span
  cat "$SESSION_LOG" | "$DIR/shai-context" | "$DIR/shai-eval" --tools | "$DIR/shai-stamp" |
    tee -a "$SESSION_LOG" | tee -a "$RUN_LOG" | tee "$LATEST" | "$DIR/shai-print" "${PRINT_OPTS[@]}"
}

# classify the true tail of the session log (the latest file is not updated by shai-dispatch)
CLASS=$(tail -n 1 "$SESSION_LOG" | jq -r '
  if .type=="message" and .source=="assistant" then
    (if ([.payload.content[]? | select(.type=="tool_use")] | length) > 0 then "DISPATCH" else "DONE" end)
  elif .type=="error" then "EVAL"
  elif .type=="tool_result" then "EVAL"
  elif .type=="message" and .source=="user" then "EVAL"
  else "DONE" end
' 2>/dev/null || printf 'DONE')

# anything other than a class we handle (including "" from a blank/garbled tail) is a no-op:
# falling through would dispatch a stale latest.json and orphan a tool_result
case "$CLASS" in
  DISPATCH | EVAL) ;;
  *)
    printf 'nothing to resume\n'
    exit 0
    ;;
esac

# a resume makes a live model call, so require the key only once we know there is work
"$DIR/shai-eval" --health-check || exit 1

# best-effort: if the run dir can't be made (read-only / full / occupied $SHAI_HOME), trace to
# /dev/null so the resume still completes. `mkdir` succeeding is NOT proof the target is writable
# (restrictive umask, inherited perms, disk-full, SELinux), so probe the actual append — otherwise
# the `>>"$RUN_LOG"` redirect fails and `set -e` aborts the resume.
# The brace group is required: `: >>f 2>/dev/null` still prints, because bash applies redirections
# left to right and the failing `>>` reports before `2>/dev/null` takes effect.
if mkdir -p "$RUNS_DIR/$SHAI_RUN_ID" 2>/dev/null &&
  { : >>"$RUNS_DIR/$SHAI_RUN_ID/events.jsonl"; } 2>/dev/null; then
  RUN_LOG="$RUNS_DIR/$SHAI_RUN_ID/events.jsonl"
else
  RUN_LOG=/dev/null
fi

case "$CLASS" in
  DISPATCH)
    tail -n 1 "$SESSION_LOG" >"$LATEST"
    # the recovered tool_use came from the interrupted run; its results open span_1 of this one
    advance_span
    ;;
  EVAL)
    run_eval
    ;;
esac

# drive the turn to completion: shai-dispatch exits 1 while a tool ran, 0 when the turn is done
# `set -o pipefail` carries shai-dispatch's exit 1 ("a tool ran") through `| shai-stamp`
until cat "$LATEST" | "$DIR/shai-dispatch" | "$DIR/shai-stamp" |
  tee -a "$SESSION_LOG" >>"$RUN_LOG"; do
  run_eval
done
