# Sources: completions.json — candidates resolve dynamically at completion time.

# Resolve the shai install directory once at load time: install.sh wrappers exec
# '<install-dir>/shai-repl'; dev clones put the real script on $PATH. Falls back
# gracefully when shai-repl is not on $PATH (install-dir candidates return none).
_shai_bin="$(command -v shai-repl 2>/dev/null)" || _shai_bin=""
if [ -n "$_shai_bin" ] && [ -f "$_shai_bin" ]; then
  _shai_dir="$(sed -n '2s/^exec .\(.*\)\/shai-repl.*/\1/p' "$_shai_bin" 2>/dev/null)"
  if [ -z "$_shai_dir" ]; then
    _shai_dir="$(readlink -f "$_shai_bin" 2>/dev/null)" || _shai_dir="$_shai_bin"
    _shai_dir="$(cd "$(dirname "$_shai_dir")" 2>/dev/null && pwd)"
  fi
else
  _shai_dir=""
fi
unset _shai_bin

# Dynamic candidate functions: one per completions.json type with a command.
(( $+functions[_shai_type_session_id] )) ||
_shai_type_session_id() {
  local -a items
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    items+=("${line/$'\t'/:}")
  done < <(ls "${SHAI_HOME:-$HOME/.shai}/sessions/" 2>/dev/null | sed 's/\.jsonl$//')
  _describe -t session_id 'Session ID from SHAI_HOME/sessions/' items
}
(( $+functions[_shai_type_run_id] )) ||
_shai_type_run_id() {
  local -a items
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    items+=("${line/$'\t'/:}")
  done < <(ls "${SHAI_HOME:-$HOME/.shai}/runs/" 2>/dev/null)
  _describe -t run_id 'Run ID from SHAI_HOME/runs/' items
}
(( $+functions[_shai_type_workflow_name] )) ||
_shai_type_workflow_name() {
  local -a items
  local line
  if [ -n "${_shai_dir:-}" ] && [ -d "${_shai_dir:-}" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      items+=("${line/$'\t'/:}")
    done < <(for d in "${_shai_dir}/workflows/"*/run.sh; do [ -f "$d" ] || continue; d="${d%/run.sh}"; n="${d##*/}"; p="$(sed -n '2s/^# //p' "$d/run.sh" 2>/dev/null)"; p="${p##*— }"; printf '%s\t%s\n' "$n" "$p"; done 2>/dev/null)
  fi
  _describe -t workflow_name 'Workflow name from install directory' items
}
(( $+functions[_shai_type_prompt_name] )) ||
_shai_type_prompt_name() {
  local -a items
  local line
  if [ -n "${_shai_dir:-}" ] && [ -d "${_shai_dir:-}" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      items+=("${line/$'\t'/:}")
    done < <(ls "${_shai_dir}/prompts/" 2>/dev/null | sed 's/\.txt$//')
  fi
  _describe -t prompt_name 'Prompt name from install directory' items
}
(( $+functions[_shai_type_shell] )) ||
_shai_type_shell() {
  local -a items
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    items+=("${line/$'\t'/:}")
  done < <(printf '%s\n' zsh bash)
  _describe -t shell 'Completion target shell' items
}

