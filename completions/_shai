_shai-failures() {
  local -a cmds
  cmds=(
    'list:List failure records, or one row per workflow'
    'show:Show full detail of one failure record'
    'summary:Aggregate totals across all workflows'
  )
  if (( CURRENT == 2 )); then
    _describe -t subcommands 'subcommand' cmds
    return
  fi
  case "${words[2]:-}" in
    list)
      _arguments -S \
        '1:subcommand' \
        '--workflow[Only this workflow'"'"'s records (name or prefix)]:NAME:_shai_type_workflow_name' \
        '--category[Only records of this category]:CAT:' \
        '--after[Only records at or after DATE]:DATE:_message -e date '"'"'YYYY-MM-DD'"'"'' \
        '--before[Only records at or before DATE]:DATE:_message -e date '"'"'YYYY-MM-DD'"'"'' \
        '--recent[Show only the last N rows]:N:' \
        '--json[Emit JSON]'
      ;;
    show)
      _arguments -S \
        '1:subcommand' \
        '--json[Emit JSON]'
      ;;
    summary)
      _arguments -S \
        '1:subcommand' \
        '--after[Only records at or after DATE]:DATE:_message -e date '"'"'YYYY-MM-DD'"'"'' \
        '--before[Only records at or before DATE]:DATE:_message -e date '"'"'YYYY-MM-DD'"'"'' \
        '--json[Emit JSON]'
      ;;
    *)
      _arguments -S \
        '1:subcommand'
      ;;
  esac
}
