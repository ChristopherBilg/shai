#!/bin/bash
# shai-workflow — discover and run shai workflow scripts
# Usage: shai-workflow list | run <name> [args...] | describe <name>
# Reads: workflow scripts in $DIR/workflows/
# Writes: workflow output to stdout/stderr
# Exit: passes through workflow exit code; 1 on validation error; 2 on usage error
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
WF_DIR="$DIR/workflows"

cmd_list() {
  local d f name purpose
  for d in "$WF_DIR"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    f="${d}run.sh"
    [ -f "$f" ] || continue
    purpose="$(sed -n '2s/^# //p' "$f")"
    printf '  %-20s %s\n' "$name" "${purpose:-(no description)}"
  done
}

cmd_describe() {
  local name="$1"
  if [[ "$name" =~ [/] ]] || [[ "$name" == *..* ]]; then
    printf 'error: workflow name must not contain / or .. (got "%s")\n' "$name" >&2
    exit 1
  fi
  local script="$WF_DIR/$name/run.sh"
  if [ ! -f "$script" ]; then
    printf 'error: workflow not found: %s\n' "$name" >&2
    exit 1
  fi
  sed -n '2,/^[^#]/{ /^#/p; }' "$script"
}

cmd_run() {
  local name="$1"
  shift
  if [[ "$name" =~ [/] ]] || [[ "$name" == *..* ]]; then
    printf 'error: workflow name must not contain / or .. (got "%s")\n' "$name" >&2
    exit 1
  fi
  local script="$WF_DIR/$name/run.sh"
  if [ ! -x "$script" ]; then
    printf 'error: workflow not found or not executable: %s\n' "$name" >&2
    exit 1
  fi
  exec "$script" "$@"
}

case "${1:-}" in
  list) cmd_list ;;
  describe)
    [ -z "${2:-}" ] && {
      printf 'error: describe requires a workflow name\n' >&2
      exit 1
    }
    cmd_describe "$2"
    ;;
  run)
    [ -z "${2:-}" ] && {
      printf 'error: run requires a workflow name\n' >&2
      exit 1
    }
    shift
    cmd_run "$@"
    ;;
  *)
    printf 'Usage: shai-workflow list | run <name> [args...] | describe <name>\n' >&2
    exit 2
    ;;
esac
